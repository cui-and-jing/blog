---
import { existsSync } from 'node:fs';
import path from 'node:path';
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Cover from '../../components/Cover.astro';
import Sidebar from '../../components/Sidebar.astro';
import Comments from '../../components/Comments.astro';
import BookmarkToggle from '../../components/BookmarkToggle.astro';
import RelatedPosts from '../../components/RelatedPosts.astro';
import { mdxComponents } from '../../lib/mdx-components';
import { SITE, url, formatDate, readingTime, tagHue } from '../../lib/site';
import { findAuthor } from '../../data/authors';
import { findSeries, positionIn } from '../../lib/series';
import { getPosts } from '../../lib/posts';

export async function getStaticPaths() {
  const sorted = await getPosts();

  return sorted.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      newer: sorted[index - 1] ?? null,
      older: sorted[index + 1] ?? null,
    },
  }));
}

interface Props {
  post: CollectionEntry<'posts'>;
  newer: CollectionEntry<'posts'> | null;
  older: CollectionEntry<'posts'> | null;
}

const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);
const author = findAuthor(post.data.author);
const authorHref = url(`/authors/#${author.id}`);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const minutes = readingTime(post.body ?? '');
/* 与阅读时长同口径：去掉代码块再数字，避免把代码行算进正文 */
const wordCount = (post.body ?? '').replace(/```[\s\S]*?```/g, ' ').replace(/\s+/g, '').length;

const posts = await getPosts();

/* 每篇文章的分享封面由 npm run og 生成；没生成过就退回站点默认图 */
const ogSlug = post.id.replace(/\//g, '-');
const ogFile = path.join(process.cwd(), 'public', 'og', `${ogSlug}.png`);
const ogImage = post.data.cover ?? (existsSync(ogFile) ? `/og/${ogSlug}.png` : undefined);
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? SITE.github).toString();
const weiboShare = `https://service.weibo.com/share/share.php?url=${encodeURIComponent(canonicalUrl)}&title=${encodeURIComponent(post.data.title)}`;

/* 所属系列：放在正文之前，让读者知道这篇不是孤立的 */
const series = post.data.series ? findSeries(posts, post.data.series) ?? null : null;
const seriesIndex = series ? positionIn(series, post) : -1;
const seriesPrev = series && seriesIndex > 0 ? series.posts[seriesIndex - 1] : null;
const seriesNext = series && seriesIndex < series.posts.length - 1 ? series.posts[seriesIndex + 1] : null;
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  image={ogImage}
  article={{
    published: post.data.date,
    updated: post.data.updated,
    tags: post.data.tags,
    category: post.data.category,
    minutes,
    author: { id: author.id, name: author.name },
  }}
>
  <Fragment slot="head">
    {/* 评论区在文末，提前把连接建好，能省掉几秒 TLS 握手 */}
    <link rel="preconnect" href="https://giscus.app" crossorigin />
    <link rel="dns-prefetch" href="https://giscus.app" />
  </Fragment>
  <div class="shell">
    {
      import.meta.env.DEV && post.data.draft && (
        <p class="draft-banner" role="note">
          <strong>草稿预览</strong>
          这篇只在本机可见，构建时不会生成页面，也不会进 RSS 与搜索。
        </p>
      )
    }
    <article>
      <header class="post-hero">
        <Cover seed={post.id} title={post.data.title} image={post.data.cover} showGlyph={false} />
        <span class="post-hero-veil"></span>
        <div class="post-hero-body">
          <div class="kicker">
            {post.data.category && <span class="chip">{post.data.category}</span>}
            <a class="post-hero-author" href={authorHref}>{author.name}</a>
            <span class="dot" aria-hidden="true"></span>
            <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
            <span class="dot" aria-hidden="true"></span>
            <span>约 {minutes} 分钟</span>
          </div>
          <h1>{post.data.title}</h1>
        </div>
      </header>

      <div class="article-wrap">
        <div>
          <div class="article-tools">
            <span class="article-tools-label">字号</span>
            <BookmarkToggle postId={post.id} title={post.data.title} variant="share" />
            <div class="size-switch" role="group" aria-label="正文字号">
              <button type="button" data-setting="size" data-value="small" aria-pressed="false" title="小一号">A−</button>
              <button type="button" data-setting="size" data-value="normal" aria-pressed="true" title="标准字号">A</button>
              <button type="button" data-setting="size" data-value="large" aria-pressed="false" title="大一号">A+</button>
            </div>
          </div>

          <div class="article-card">
            {
              series && (
                <aside class="series-note" aria-label="所属系列">
                  <div class="series-note-head">
                    <span class="series-note-kicker">系列</span>
                    <a class="series-note-title" href={series.href}>
                      {series.title}
                    </a>
                    <span class="series-note-count">
                      第 {seriesIndex + 1} / {series.count} 篇
                    </span>
                  </div>
                  {(seriesPrev || seriesNext) && (
                    <div class="series-note-links">
                      {seriesPrev && (
                        <a class="prev" href={url(`/posts/${seriesPrev.id}/`)}>
                          <span aria-hidden="true">←</span>
                          <span>{seriesPrev.data.title}</span>
                        </a>
                      )}
                      {seriesNext && (
                        <a class="next" href={url(`/posts/${seriesNext.id}/`)}>
                          <span>{seriesNext.data.title}</span>
                          <span aria-hidden="true">→</span>
                        </a>
                      )}
                    </div>
                  )}
                </aside>
              )
            }
            <div class="prose">
              <Content
                components={mdxComponents}
              />
            </div>

            <div class="end-mark" aria-hidden="true">
              <span class="end-line"></span>
              <span class="end-dot">全文完</span>
              <span class="end-line"></span>
            </div>

            <footer class="post-foot">
              {
                post.data.tags.length > 0 && (
                  <div class="post-tags">
                    {post.data.tags.map((tag: string) => (
                      <a class="tag-pill" style={`--h:${tagHue(tag)}`} href={url(`/tags/${encodeURIComponent(tag)}/`)}>
                        #{tag}
                      </a>
                    ))}
                  </div>
                )
              }
              <p class="post-stats">
                <span>{`${wordCount} 字`}</span>
                <span class="sep" aria-hidden="true">·</span>
                <span>{`约 ${minutes} 分钟`}</span>
                {
                  post.data.updated && (
                    <>
                      <span class="sep" aria-hidden="true">·</span>
                      <span>{`最后更新 ${formatDate(post.data.updated)}`}</span>
                    </>
                  )
                }
                <span class="sep" aria-hidden="true">·</span>
                <span class="post-stats-author">文 / <a href={authorHref}>{author.name}</a></span>
              </p>
            </footer>

            <div class="share-bar" data-share data-url={canonicalUrl} data-title={post.data.title}>
              <span class="share-label">Share</span>
              <BookmarkToggle postId={post.id} title={post.data.title} variant="share" />
              <button class="share-btn" type="button" data-share-copy>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
                  <path d="M10 13.5a4 4 0 0 0 5.7 0l3-3a4 4 0 1 0-5.7-5.7l-1.3 1.3"></path>
                  <path d="M14 10.5a4 4 0 0 0-5.7 0l-3 3a4 4 0 1 0 5.7 5.7l1.3-1.3"></path>
                </svg>
                <span data-share-copy-label>复制链接</span>
              </button>
              <a class="share-btn" href={weiboShare} target="_blank" rel="noopener noreferrer">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" aria-hidden="true">
                  <path d="M4.6 5.6h14.8v9.6h-8.2L6.4 18.6v-3.4H4.6z"></path>
                </svg>
                微博
              </a>
              <button class="share-btn" type="button" data-share-native hidden>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M12 15V4M8 8l4-4 4 4"></path>
                  <path d="M5 14v5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-5"></path>
                </svg>
                分享
              </button>
              <span class="share-hint" data-share-hint aria-live="polite"></span>
            </div>
          </div>

          <nav class="post-nav" aria-label="上下篇">
            {
              older ? (
                <a href={url(`/posts/${older.id}/`)}>
                  <span class="label">上一篇</span>
                  <span class="title">{older.data.title}</span>
                </a>
              ) : (
                <span></span>
              )
            }
            {
              newer ? (
                <a class="next" href={url(`/posts/${newer.id}/`)}>
                  <span class="label">下一篇</span>
                  <span class="title">{newer.data.title}</span>
                </a>
              ) : (
                <span></span>
              )
            }
          </nav>

          <RelatedPosts current={post} posts={posts} />

          <Comments />
        </div>

        <Sidebar posts={posts} currentId={post.id}>
          {
            toc.length > 0 && (
              <section class="widget">
                <h4>目录</h4>
                <nav class="toc" aria-label="目录">
                  <ul>
                    {toc.map((h) => (
                      <li class={`depth-${h.depth}`}>
                        <a href={`#${h.slug}`}>{h.text}</a>
                      </li>
                    ))}
                  </ul>
                </nav>
              </section>
            )
          }
        </Sidebar>
      </div>
    </article>
  </div>

  <div class="resume-bar" id="resume-bar" hidden>
    <span class="resume-text">上次读到 <b id="resume-percent">0%</b></span>
    <button class="resume-go" id="resume-go" type="button">继续</button>
    <button class="resume-close" id="resume-close" type="button" aria-label="不再提示阅读位置">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
        <path d="M6 6l12 12M18 6 6 18"></path>
      </svg>
    </button>
  </div>

  {
    toc.length > 0 && (
      <>
        <dialog class="toc-dialog" id="toc-dialog" aria-label="文章目录" aria-modal="true">
          <div class="toc-dialog-head">
            <span>目录</span>
            <button class="toc-dialog-close" type="button" aria-label="关闭目录">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
                <path d="M6 6l12 12M18 6 6 18"></path>
              </svg>
            </button>
          </div>
          <div class="toc-body"><nav class="toc" aria-label="文章目录"></nav></div>
        </dialog>
      </>
    )
  }

  <script>
    /* 视觉反馈之外，再给读屏留一条播报通道 */
    const announce = (message: string) => {
      const status = document.getElementById('a11y-status');
      if (status) status.textContent = message;
    };

    /* 字号按钮的逻辑在 BaseLayout：它和其他外观设置共用同一份 localStorage，
       同一套标记（data-setting / data-value），这里不再各写一遍 */

    /* ---------- 阅读位置：正文百分比独立于评论与页脚高度 ---------- */
    const resumeBar = document.getElementById('resume-bar');
    const resumePercent = document.getElementById('resume-percent');
    const resumeKey = `reading:pos:${location.pathname}`;
    const prose = document.querySelector<HTMLElement>('.article-card .prose');

    if (resumeBar && resumePercent && prose) {
      const sightline = () => Math.min(140, innerHeight * .22);
      const position = () => {
        const rect = prose.getBoundingClientRect();
        return { top: scrollY + rect.top, height: rect.height };
      };
      const hide = () => { resumeBar.hidden = true; };
      const saved = (() => {
        try {
          const value = JSON.parse(localStorage.getItem(resumeKey) ?? 'null');
          return Number.isFinite(value?.p) && value.p >= 0 && value.p <= 1
            ? value as { p: number; v?: number } : null;
        } catch { return null; }
      })();

      let dismissed = false;
      /* Deep section links take priority over the old resume prompt. */
      if (saved && saved.p > .08 && saved.p < .96 && !location.hash) {
        resumePercent.textContent = `${Math.round(saved.p * 100)}%`;
        resumeBar.hidden = false;
        document.getElementById('resume-go')?.addEventListener('click', () => {
          const box = position();
          const max = document.documentElement.scrollHeight - innerHeight;
          /* 兼容 v1 整页比例，v2 按正文恢复。 */
          const target = saved.v === 2 ? box.top + box.height * saved.p - sightline() : saved.p * max;
          scrollTo({
            top: Math.max(0, Math.min(max, target)),
            behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
          });
          hide();
        });
        document.getElementById('resume-close')?.addEventListener('click', () => {
          dismissed = true;
          hide();
          try { localStorage.removeItem(resumeKey); } catch {}
        });
      }

      /* 浏览器自动恢复滚动不算主动阅读。 */
      addEventListener('wheel', hide, { passive: true });
      addEventListener('touchmove', hide, { passive: true });
      addEventListener('keydown', (event) => {
        if (/^(ArrowDown|ArrowUp|PageDown|PageUp|Home|End| )$/.test(event.key)) hide();
      }, { passive: true });

      const save = () => {
        if (dismissed) return;
        const { top, height } = position();
        if (height < 240) return;
        const p = (scrollY + sightline() - top) / height;
        try {
          if (p >= .96) localStorage.removeItem(resumeKey);
          else if (p > .02) localStorage.setItem(resumeKey, JSON.stringify({ v: 2, p }));
        } catch {}
      };
      let timer = 0;
      addEventListener('scroll', () => {
        clearTimeout(timer);
        timer = window.setTimeout(save, 450);
      }, { passive: true });
      addEventListener('pagehide', save);
    }

    /* ---------- 标题锚点 ---------- */
    const copyText = async (text: string) => {
      try {
        await navigator.clipboard.writeText(text);
        return true;
      } catch {
        /* 非 https、页面没焦点或浏览器不给权限时，退回老办法 */
        const box = document.createElement('textarea');
        box.value = text;
        box.setAttribute('readonly', '');
        box.style.cssText = 'position:fixed;top:0;left:0;opacity:0;pointer-events:none';
        document.body.append(box);
        box.select();
        const ok = document.execCommand('copy');
        box.remove();
        return ok;
      }
    };

    /* ---------- 文末分享 ---------- */
    const shareBar = document.querySelector<HTMLElement>('[data-share]');
    if (shareBar) {
      const shareUrl = shareBar.dataset.url || location.href;
      const shareTitle = shareBar.dataset.title || document.title;
      const copyBtn = shareBar.querySelector<HTMLButtonElement>('[data-share-copy]');
      const copyLabel = shareBar.querySelector<HTMLElement>('[data-share-copy-label]');
      const nativeBtn = shareBar.querySelector<HTMLButtonElement>('[data-share-native]');
      const hint = shareBar.querySelector<HTMLElement>('[data-share-hint]');

      /* 手机上有系统分享面板，就多给一个入口（能直接分享到微信、相册等） */
      if (nativeBtn && typeof navigator.share === 'function') nativeBtn.hidden = false;

      copyBtn?.addEventListener('click', async () => {
        const ok = await copyText(shareUrl);
        if (!copyLabel) return;
        copyLabel.textContent = ok ? '已复制' : '复制失败';
        if (ok) copyBtn.dataset.copied = '1';
        else delete copyBtn.dataset.copied;
        if (ok && hint) hint.textContent = '已复制，粘贴给朋友就行';
        setTimeout(() => {
          copyLabel.textContent = '复制链接';
          delete copyBtn.dataset.copied;
          if (hint) hint.textContent = '';
        }, 2000);
      });

      nativeBtn?.addEventListener('click', () => {
        navigator.share({ title: shareTitle, url: shareUrl }).catch(() => {});
      });
    }

    const flashAnchor = (anchor: HTMLAnchorElement) => {
      anchor.dataset.copied = '1';
      anchor.textContent = '已复制';
      setTimeout(() => {
        delete anchor.dataset.copied;
        anchor.textContent = '#';
      }, 1400);
    };

    const headings = document.querySelectorAll<HTMLElement>('.prose h2, .prose h3');
    headings.forEach((heading) => {
      if (!heading.id) return;
      const anchor = document.createElement('a');
      anchor.className = 'heading-anchor';
      anchor.href = `#${heading.id}`;
      anchor.setAttribute('aria-label', `复制「${heading.textContent?.trim() ?? ''}」的链接`);
      anchor.textContent = '#';
      anchor.addEventListener('click', async (event) => {
        event.preventDefault(); /* 复制章节链接不应导致正文跳动 */
        const link = `${location.origin}${location.pathname}#${heading.id}`;
        if (!(await copyText(link))) return;
        flashAnchor(anchor);
        announce('小节链接已复制');
      });
      heading.append(anchor);
    });

    /* ---------- 段落深链接：想引用某一段时，不必再给整篇链接 ---------- */
    const articleTitle = shareBar?.dataset.title || document.title;

    document.querySelectorAll<HTMLElement>('.prose > p, .prose > blockquote').forEach((block, i) => {
      const sourceText = (block.textContent ?? '').trim();
      if (sourceText.length < 24) return;

      if (!block.id) block.id = `p-${i + 1}`;
      block.classList.add('has-anchor');

      const anchor = document.createElement('a');
      anchor.className = 'para-anchor';
      anchor.href = `#${block.id}`;
      anchor.textContent = '#';
      anchor.setAttribute('aria-label', '复制这一段落的引用');
      anchor.addEventListener('click', async (event) => {
        event.preventDefault();
        /* 选中了半句就只引半句，否则引整段 */
        const selection = window.getSelection();
        const picked =
          selection && selection.rangeCount && block.contains(selection.getRangeAt(0).commonAncestorContainer)
            ? selection.toString().trim()
            : '';
        const text = picked || sourceText;
        const link = `${location.origin}${location.pathname}#${block.id}`;

        if (!(await copyText(`> ${text}\n\n—— ${articleTitle} ${link}`))) {
          announce('复制失败，请手动选择文字');
          return;
        }
        flashAnchor(anchor);
        announce('引用已复制');
      });

      block.prepend(anchor);
    });

    /* ---------- 目录高亮：只改变化的两项，避免长目录反复遍历 ---------- */
    const linkById = new Map(Array.from(document.querySelectorAll<HTMLAnchorElement>('.sidebar .toc a'),
      (a) => [decodeURIComponent(a.hash.slice(1)), a]));
    const sidebar = document.querySelector<HTMLElement>('.sidebar');
    let active: HTMLAnchorElement | null = null;
    let scrollFrame = 0;

    const observer = new IntersectionObserver((entries) => {
      /* 同批次选择视口最靠上的有效章节，避免在多个标题间闪烁。 */
      const hit = entries.filter((e) => e.isIntersecting)
        .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
      const link = hit && linkById.get(hit.target.id);
      if (!link || link === active) return;
      active?.classList.remove('active');
      active?.removeAttribute('aria-current');
      link.classList.add('active');
      link.setAttribute('aria-current', 'location');
      active = link;

      /* 只对可滚动的桌面侧栏定位，旧帧被最新选中章节取代。 */
      if (sidebar && innerWidth > 1080) {
        cancelAnimationFrame(scrollFrame);
        scrollFrame = requestAnimationFrame(() => {
          if (sidebar.scrollHeight <= sidebar.clientHeight) return;
          const delta = link.getBoundingClientRect().top - sidebar.getBoundingClientRect().top;
          if (delta < 40 || delta > sidebar.clientHeight - 40) sidebar.scrollBy({
            top: delta - sidebar.clientHeight / 2,
            behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth',
          });
        });
      }
    }, { rootMargin: '-96px 0px -70% 0px' });

    headings.forEach((h) => observer.observe(h));

    /* ---------- 移动端目录：入口在底部操作条上，不再是浮在正文上的独立按钮 ---------- */
    const fab = document.getElementById('bar-toc') as HTMLButtonElement | null;
    const tocDialog = document.getElementById('toc-dialog') as HTMLDialogElement | null;

    if (fab && tocDialog) {
      const body = tocDialog.querySelector('.toc-body .toc');
      const source = document.querySelector('.sidebar .toc ul');

      const close = tocDialog.querySelector('.toc-dialog-close');
      /* close 事件在下一个任务执行，点击链接时需同步清除展开状态。 */
      const closeToc = () => {
        if (tocDialog.open) tocDialog.close();
        fab.setAttribute('aria-expanded', 'false');
      };
      fab.addEventListener('click', () => {
        /* 正文不会在模态目录打开时滚动，按需克隆当前状态更轻量。 */
        if (body && source) body.replaceChildren(source.cloneNode(true));
        tocDialog.showModal();
        fab.setAttribute('aria-expanded', 'true');
        (tocDialog.querySelector<HTMLAnchorElement>('.toc a.active') ?? tocDialog.querySelector<HTMLAnchorElement>('.toc a'))?.focus();
      });
      close?.addEventListener('click', closeToc);
      tocDialog.addEventListener('click', (event) => {
        if (event.target === tocDialog || (event.target as Element).closest('.toc a')) closeToc();
      });
      tocDialog.addEventListener('close', () => fab.setAttribute('aria-expanded', 'false'));

      /* 只有真生成了目录才把按钮放出来，也才声明它控制哪个 dialog——
         其它页面没有这个 dialog，提前声明 aria-controls 会指向不存在的元素 */
      fab.setAttribute('aria-haspopup', 'dialog');
      fab.setAttribute('aria-controls', 'toc-dialog');
      fab.setAttribute('aria-expanded', 'false');
      fab.hidden = false;
    }
  </script>
</BaseLayout>
