---
import { existsSync } from 'node:fs';
import path from 'node:path';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Cover from '../../components/Cover.astro';
import Sidebar from '../../components/Sidebar.astro';
import Comments from '../../components/Comments.astro';
import RelatedPosts from '../../components/RelatedPosts.astro';
import { SITE, url, formatDate, readingTime, tagHue } from '../../lib/site';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  const sorted = posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

  return sorted.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      newer: sorted[index - 1] ?? null,
      older: sorted[index + 1] ?? null,
    },
  }));
}

interface Props {
  post: CollectionEntry<'posts'>;
  newer: CollectionEntry<'posts'> | null;
  older: CollectionEntry<'posts'> | null;
}

const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const minutes = readingTime(post.body ?? '');
/* 与阅读时长同口径：去掉代码块再数字，避免把代码行算进正文 */
const wordCount = (post.body ?? '').replace(/```[\s\S]*?```/g, ' ').replace(/\s+/g, '').length;

const all = await getCollection('posts', ({ data }) => !data.draft);
const posts = all.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

/* 每篇文章的分享封面由 npm run og 生成；没生成过就退回站点默认图 */
const ogSlug = post.id.replace(/\//g, '-');
const ogFile = path.join(process.cwd(), 'public', 'og', `${ogSlug}.png`);
const ogImage = post.data.cover ?? (existsSync(ogFile) ? `/og/${ogSlug}.png` : undefined);
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? SITE.github).toString();
const weiboShare = `https://service.weibo.com/share/share.php?url=${encodeURIComponent(canonicalUrl)}&title=${encodeURIComponent(post.data.title)}`;
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  image={ogImage}
  article={{
    published: post.data.date,
    updated: post.data.updated,
    tags: post.data.tags,
    category: post.data.category,
    minutes,
  }}
>
  <Fragment slot="head">
    {/* 评论区在文末，提前把连接建好，能省掉几秒 TLS 握手 */}
    <link rel="preconnect" href="https://giscus.app" crossorigin />
    <link rel="dns-prefetch" href="https://giscus.app" />
  </Fragment>
  <div class="shell">
    <article>
      <header class="post-hero">
        <Cover seed={post.id} title={post.data.title} image={post.data.cover} showGlyph={false} />
        <span class="post-hero-veil"></span>
        <div class="post-hero-body">
          <div class="kicker">
            {post.data.category && <span class="chip">{post.data.category}</span>}
            <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
            <span class="dot"></span>
            <span>约 {minutes} 分钟</span>
          </div>
          <h1>{post.data.title}</h1>
        </div>
      </header>

      <div class="article-wrap">
        <div>
          <div class="article-card">
            <div class="prose">
              <Content />
            </div>

            <div class="end-mark" aria-hidden="true">
              <span class="end-line"></span>
              <span class="end-dot">全文完</span>
              <span class="end-line"></span>
            </div>

            <footer class="post-foot">
              {
                post.data.tags.length > 0 && (
                  <div class="post-tags">
                    {post.data.tags.map((tag: string) => (
                      <a class="tag-pill" style={`--h:${tagHue(tag)}`} href={url(`/tags/${encodeURIComponent(tag)}/`)}>
                        #{tag}
                      </a>
                    ))}
                  </div>
                )
              }
              <p class="post-stats">
                <span>{`${wordCount} 字`}</span>
                <span class="sep" aria-hidden="true">·</span>
                <span>{`约 ${minutes} 分钟`}</span>
                {
                  post.data.updated && (
                    <>
                      <span class="sep" aria-hidden="true">·</span>
                      <span>{`最后更新 ${formatDate(post.data.updated)}`}</span>
                    </>
                  )
                }
              </p>
            </footer>

            <div class="share-bar" data-share data-url={canonicalUrl} data-title={post.data.title}>
              <span class="share-label">Share</span>
              <button class="share-btn" type="button" data-share-copy>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
                  <path d="M10 13.5a4 4 0 0 0 5.7 0l3-3a4 4 0 1 0-5.7-5.7l-1.3 1.3"></path>
                  <path d="M14 10.5a4 4 0 0 0-5.7 0l-3 3a4 4 0 1 0 5.7 5.7l1.3-1.3"></path>
                </svg>
                <span data-share-copy-label>复制链接</span>
              </button>
              <a class="share-btn" href={weiboShare} target="_blank" rel="noopener noreferrer">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" aria-hidden="true">
                  <path d="M4.6 5.6h14.8v9.6h-8.2L6.4 18.6v-3.4H4.6z"></path>
                </svg>
                微博
              </a>
              <button class="share-btn" type="button" data-share-native hidden>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M12 15V4M8 8l4-4 4 4"></path>
                  <path d="M5 14v5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-5"></path>
                </svg>
                分享
              </button>
              <span class="share-hint" data-share-hint aria-live="polite"></span>
            </div>
          </div>

          <nav class="post-nav" aria-label="上下篇">
            {
              older ? (
                <a href={url(`/posts/${older.id}/`)}>
                  <span class="label">上一篇</span>
                  <span class="title">{older.data.title}</span>
                </a>
              ) : (
                <span></span>
              )
            }
            {
              newer ? (
                <a class="next" href={url(`/posts/${newer.id}/`)}>
                  <span class="label">下一篇</span>
                  <span class="title">{newer.data.title}</span>
                </a>
              ) : (
                <span></span>
              )
            }
          </nav>

          <RelatedPosts current={post} posts={posts} />

          <Comments />
        </div>

        <Sidebar posts={posts} currentId={post.id}>
          {
            toc.length > 0 && (
              <section class="widget">
                <h4>目录</h4>
                <nav class="toc" aria-label="目录">
                  <ul>
                    {toc.map((h) => (
                      <li class={`depth-${h.depth}`}>
                        <a href={`#${h.slug}`}>{h.text}</a>
                      </li>
                    ))}
                  </ul>
                </nav>
              </section>
            )
          }
        </Sidebar>
      </div>
    </article>
  </div>

  {
    toc.length > 0 && (
      <>
        <button
          class="toc-fab"
          id="toc-fab"
          type="button"
          aria-haspopup="dialog"
          aria-expanded="false"
          aria-controls="toc-dialog"
          hidden
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
            <path d="M4 6h16M4 12h11M4 18h7"></path>
          </svg>
          目录
        </button>

        <dialog class="toc-dialog" id="toc-dialog" aria-label="文章目录">
          <div class="toc-dialog-head">
            <span>目录</span>
            <button class="toc-dialog-close" type="button" aria-label="关闭目录">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
                <path d="M6 6l12 12M18 6 6 18"></path>
              </svg>
            </button>
          </div>
          <div class="toc-body"></div>
        </dialog>
      </>
    )
  }

  <dialog class="lightbox" id="lightbox" aria-label="图片预览">
    <button class="lightbox-close" type="button" aria-label="关闭预览">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
        <path d="M6 6l12 12M18 6 6 18"></path>
      </svg>
    </button>
    <img id="lightbox-img" alt="" />
    <p class="lightbox-caption" id="lightbox-caption"></p>
    <button class="lightbox-nav prev" type="button" aria-label="上一张">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M15 5l-7 7 7 7"></path>
      </svg>
    </button>
    <button class="lightbox-nav next" type="button" aria-label="下一张">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M9 5l7 7-7 7"></path>
      </svg>
    </button>
  </dialog>

  <script>
    /* ---------- 代码块：语言标签 + 复制 ---------- */
    document.querySelectorAll('.prose pre').forEach((pre) => {
      const wrap = document.createElement('div');
      wrap.className = 'code-block';
      pre.parentNode?.insertBefore(wrap, pre);
      wrap.appendChild(pre);

      const lang = pre.getAttribute('data-language');
      if (lang) {
        wrap.classList.add('has-lang');
        const label = document.createElement('span');
        label.className = 'code-lang';
        label.textContent = lang;
        wrap.appendChild(label);
      }

      const btn = document.createElement('button');
      btn.className = 'copy-btn';
      btn.type = 'button';
      btn.textContent = '复制';
      btn.setAttribute('aria-label', '复制代码');
      btn.addEventListener('click', async () => {
        const text = pre.querySelector('code')?.textContent ?? '';
        try {
          await navigator.clipboard.writeText(text);
          btn.textContent = '已复制';
          btn.classList.add('copied');
        } catch {
          btn.textContent = '复制失败';
        }
        setTimeout(() => {
          btn.textContent = '复制';
          btn.classList.remove('copied');
        }, 1600);
      });
      wrap.appendChild(btn);
    });

    /* ---------- 标题锚点 ---------- */
    const copyText = async (text: string) => {
      try {
        await navigator.clipboard.writeText(text);
        return true;
      } catch {
        /* 非 https、页面没焦点或浏览器不给权限时，退回老办法 */
        const box = document.createElement('textarea');
        box.value = text;
        box.setAttribute('readonly', '');
        box.style.cssText = 'position:fixed;top:0;left:0;opacity:0;pointer-events:none';
        document.body.append(box);
        box.select();
        const ok = document.execCommand('copy');
        box.remove();
        return ok;
      }
    };

    /* ---------- 文末分享 ---------- */
    const shareBar = document.querySelector<HTMLElement>('[data-share]');
    if (shareBar) {
      const shareUrl = shareBar.dataset.url || location.href;
      const shareTitle = shareBar.dataset.title || document.title;
      const copyBtn = shareBar.querySelector<HTMLButtonElement>('[data-share-copy]');
      const copyLabel = shareBar.querySelector<HTMLElement>('[data-share-copy-label]');
      const nativeBtn = shareBar.querySelector<HTMLButtonElement>('[data-share-native]');
      const hint = shareBar.querySelector<HTMLElement>('[data-share-hint]');

      /* 手机上有系统分享面板，就多给一个入口（能直接分享到微信、相册等） */
      if (nativeBtn && typeof navigator.share === 'function') nativeBtn.hidden = false;

      copyBtn?.addEventListener('click', async () => {
        const ok = await copyText(shareUrl);
        if (!copyLabel) return;
        copyLabel.textContent = ok ? '已复制' : '复制失败';
        if (ok) copyBtn.dataset.copied = '1';
        else delete copyBtn.dataset.copied;
        if (ok && hint) hint.textContent = '已复制，粘贴给朋友就行';
        setTimeout(() => {
          copyLabel.textContent = '复制链接';
          delete copyBtn.dataset.copied;
          if (hint) hint.textContent = '';
        }, 2000);
      });

      nativeBtn?.addEventListener('click', () => {
        navigator.share({ title: shareTitle, url: shareUrl }).catch(() => {});
      });
    }

    document.querySelectorAll<HTMLElement>('.prose h2, .prose h3').forEach((heading) => {
      if (!heading.id) return;
      const anchor = document.createElement('a');
      anchor.className = 'heading-anchor';
      anchor.href = `#${heading.id}`;
      anchor.setAttribute('aria-label', `复制「${heading.textContent?.trim() ?? ''}」的链接`);
      anchor.textContent = '#';
      anchor.addEventListener('click', async () => {
        const link = `${location.origin}${location.pathname}#${heading.id}`;
        if (!(await copyText(link))) return;
        anchor.dataset.copied = '1';
        anchor.textContent = '已复制';
        setTimeout(() => {
          delete anchor.dataset.copied;
          anchor.textContent = '#';
        }, 1400);
      });
      heading.append(anchor);
    });

    /* ---------- 目录高亮 ---------- */
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.sidebar .toc a'));
    const map = new Map(links.map((a) => [decodeURIComponent(a.hash.slice(1)), a]));
    const sidebar = document.querySelector<HTMLElement>('.sidebar');

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          links.forEach((a) => a.classList.remove('active'));
          const link = map.get(entry.target.id);
          link?.classList.add('active');

          /* 侧栏内容超出一屏时，让当前目录项保持可见 */
          if (link && sidebar && sidebar.scrollHeight > sidebar.clientHeight + 4) {
            const box = sidebar.getBoundingClientRect();
            const item = link.getBoundingClientRect();
            if (item.top < box.top + 40 || item.bottom > box.bottom - 40) {
              sidebar.scrollTo({
                top: sidebar.scrollTop + (item.top - box.top) - sidebar.clientHeight / 2,
                behavior: 'smooth',
              });
            }
          }
        });
      },
      { rootMargin: '-96px 0px -70% 0px' }
    );

    document.querySelectorAll('.prose h2, .prose h3').forEach((h) => observer.observe(h));

    /* ---------- 移动端目录 ---------- */
    const fab = document.getElementById('toc-fab') as HTMLButtonElement | null;
    const tocDialog = document.getElementById('toc-dialog') as HTMLDialogElement | null;

    if (fab && tocDialog) {
      const body = tocDialog.querySelector('.toc-body');
      const source = document.querySelector('.sidebar .toc ul');
      if (body && source) {
        const nav = document.createElement('nav');
        nav.className = 'toc';
        nav.setAttribute('aria-label', '文章目录');
        nav.append(source.cloneNode(true));
        body.append(nav);
      }

      const close = tocDialog.querySelector('.toc-dialog-close');
      fab.addEventListener('click', () => {
        tocDialog.showModal();
        fab.setAttribute('aria-expanded', 'true');
      });
      close?.addEventListener('click', () => tocDialog.close());
      tocDialog.addEventListener('click', (event) => {
        if (event.target === tocDialog) tocDialog.close();
      });
      tocDialog.addEventListener('close', () => fab.setAttribute('aria-expanded', 'false'));
      tocDialog.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => tocDialog.close()));
      fab.hidden = false;
    }

    /* ---------- 图片灯箱 ---------- */
    const images = Array.from(document.querySelectorAll<HTMLImageElement>('.prose img'));
    const lightbox = document.getElementById('lightbox') as HTMLDialogElement | null;

    if (lightbox && images.length > 0) {
      const view = document.getElementById('lightbox-img') as HTMLImageElement;
      const caption = document.getElementById('lightbox-caption');
      const prev = lightbox.querySelector<HTMLButtonElement>('.lightbox-nav.prev');
      const next = lightbox.querySelector<HTMLButtonElement>('.lightbox-nav.next');
      let index = 0;

      if (images.length < 2) {
        prev?.setAttribute('hidden', '');
        next?.setAttribute('hidden', '');
      }

      const show = (i: number) => {
        index = (i + images.length) % images.length;
        const image = images[index];
        view.src = image.currentSrc || image.src;
        view.alt = image.alt;
        if (caption) {
          caption.textContent = image.alt || '';
          caption.hidden = !image.alt;
        }
      };

      const open = (i: number) => {
        show(i);
        lightbox.showModal();
        document.documentElement.style.overflow = 'hidden';
      };

      images.forEach((image, i) => {
        image.tabIndex = 0;
        image.setAttribute('role', 'button');
        image.setAttribute('aria-label', `放大图片：${image.alt || '正文图片'}`);
        image.addEventListener('click', () => open(i));
        image.addEventListener('keydown', (event) => {
          if (event.key === 'Enter' || event.key === ' ') {
            event.preventDefault();
            open(i);
          }
        });
      });

      lightbox.querySelector('.lightbox-close')?.addEventListener('click', () => lightbox.close());
      prev?.addEventListener('click', () => show(index - 1));
      next?.addEventListener('click', () => show(index + 1));
      lightbox.addEventListener('click', (event) => {
        if (event.target === lightbox) lightbox.close();
      });
      lightbox.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowLeft') show(index - 1);
        if (event.key === 'ArrowRight') show(index + 1);
      });
      lightbox.addEventListener('close', () => {
        document.documentElement.style.overflow = '';
      });
    }
  </script>
</BaseLayout>
