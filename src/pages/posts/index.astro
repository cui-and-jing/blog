---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { AUTHORS } from '../../data/authors';
import { url } from '../../lib/site';
import { getPosts } from '../../lib/posts';

const posts = await getPosts();
const categories = [...new Set(posts.map((post) => post.data.category).filter((value): value is string => Boolean(value)))]
  .sort((a, b) => a.localeCompare(b, 'zh-CN'));
const categoryCount = new Map(categories.map((category) => [
  category,
  posts.filter((post) => post.data.category === category).length,
]));
const authors = AUTHORS.filter((author) => posts.some((post) => post.data.author === author.id));
const authorCount = new Map(authors.map((author) => [
  author.id,
  posts.filter((post) => post.data.author === author.id).length,
]));
---

<BaseLayout title="文章" description="全部文章列表">
  <div class="page-head">
    <div class="shell">
      <h1>文章</h1>
      <p>共 {posts.length} 篇，按发布时间倒序。</p>
    </div>
  </div>

  <div class="shell posts-browser-shell">
    <div class="post-browser" aria-label="文章浏览">
      <div class="post-filter-row" data-post-filter="category">
        <span class="post-filter-label" id="post-filter-category">分类</span>
        <nav class="post-filter-links" aria-labelledby="post-filter-category">
          <a href={url('/posts/')} data-filter-value="" aria-current="true">
            全部 <span class="post-filter-number">{posts.length}</span>
          </a>
          {categories.map((category) => (
            <a href={url(`/category/${encodeURIComponent(category)}/`)} data-filter-value={category}>
              {category} <span class="post-filter-number">{categoryCount.get(category)}</span>
            </a>
          ))}
        </nav>
      </div>

      <div class="post-filter-row" data-post-filter="author">
        <span class="post-filter-label" id="post-filter-author">作者</span>
        <nav class="post-filter-links" aria-labelledby="post-filter-author">
          <a href={url('/posts/')} data-filter-value="" aria-current="true">
            全部 <span class="post-filter-number">{posts.length}</span>
          </a>
          {authors.map((author) => (
            <a href={url(`/authors/#${author.id}`)} data-filter-value={author.id}>
              {author.name} <span class="post-filter-number">{authorCount.get(author.id)}</span>
            </a>
          ))}
        </nav>
      </div>

      <div class="post-filter-row" id="bookmark-filter-row" hidden>
        <span class="post-filter-label" id="post-filter-bookmarks">收藏</span>
        <nav class="post-filter-links" aria-labelledby="post-filter-bookmarks">
          <a href={url('/posts/?saved=1')} id="bookmark-filter" aria-current={undefined}>
            只看收藏 <span class="post-filter-number" id="bookmark-count">0</span>
          </a>
        </nav>
      </div>

      <p class="post-filter-count" id="post-filter-count" role="status" aria-live="polite">共 {posts.length} 篇</p>
    </div>

    <ul class="card-grid card-grid--three" id="post-grid">
      {posts.map((post) => <PostCard post={post} headingLevel="h2" />)}
    </ul>

    <div class="post-filter-empty" id="post-filter-empty" hidden>
      <p id="post-filter-empty-text">这里没有这样的文章。换个分类或作者。</p>
      <a href={url('/posts/')} id="post-filter-reset">查看全部文章 →</a>
    </div>
  </div>
</BaseLayout>

<script>
  import { readBookmarks } from '../../lib/bookmarks';

  type FilterKey = 'category' | 'author';
  const keys: FilterKey[] = ['category', 'author'];
  const grid = document.getElementById('post-grid');
  const status = document.getElementById('post-filter-count');
  const empty = document.getElementById('post-filter-empty');
  const reset = document.getElementById('post-filter-reset');
  const savedRow = document.getElementById('bookmark-filter-row');
  const savedFilter = document.getElementById('bookmark-filter') as HTMLAnchorElement | null;
  const savedCount = document.getElementById('bookmark-count');
  const emptyText = document.getElementById('post-filter-empty-text');
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-post-filter] a[data-filter-value]'));

  if (grid && status && empty) {
    const cards = Array.from(grid.querySelectorAll<HTMLElement>('.card'));
    const state: Record<FilterKey, string> = { category: '', author: '' };
    let savedOnly = false;
    if (savedRow) savedRow.hidden = false;

    const linksFor = (key: FilterKey) =>
      links.filter((link) => link.closest('[data-post-filter]')?.getAttribute('data-post-filter') === key);

    const readUrl = () => {
      const params = new URLSearchParams(window.location.search);
      savedOnly = params.get('saved') === '1';
      for (const key of keys) {
        const value = params.get(key) ?? '';
        state[key] = linksFor(key).some((link) => link.dataset.filterValue === value) ? value : '';
      }
    };

    const render = () => {
      const saved = new Set(readBookmarks());
      let visible = 0;
      for (const card of cards) {
        const match = (!state.category || card.dataset.category === state.category)
          && (!state.author || card.dataset.author === state.author)
          && (!savedOnly || saved.has(card.dataset.postId ?? ''));
        card.hidden = !match;
        if (match) visible += 1;
      }
      if (savedCount) savedCount.textContent = String(cards.filter((card) => saved.has(card.dataset.postId ?? '')).length);
      if (savedFilter) {
        if (savedOnly) savedFilter.setAttribute('aria-current', 'true');
        else savedFilter.removeAttribute('aria-current');
      }
      if (emptyText) emptyText.textContent = savedOnly
        ? '这里没有收藏的文章。'
        : '这里没有这样的文章。换个分类或作者。';

      for (const key of keys) {
        for (const link of linksFor(key)) {
          if ((link.dataset.filterValue ?? '') === state[key]) link.setAttribute('aria-current', 'true');
          else link.removeAttribute('aria-current');
        }
      }

      status.textContent = `共 ${visible} 篇`;
      empty.hidden = visible !== 0;
    };

    const writeUrl = () => {
      const next = new URL(window.location.href);
      for (const key of keys) {
        if (state[key]) next.searchParams.set(key, state[key]);
        else next.searchParams.delete(key);
      }
      if (savedOnly) next.searchParams.set('saved', '1');
      else next.searchParams.delete('saved');
      if (next.href !== window.location.href) history.pushState(null, '', next);
    };

    links.forEach((link) => link.addEventListener('click', (event) => {
      if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      const key = link.closest('[data-post-filter]')?.getAttribute('data-post-filter') as FilterKey | null;
      if (!key || !keys.includes(key)) return;
      event.preventDefault();
      state[key] = link.dataset.filterValue ?? '';
      writeUrl();
      render();
    }));

    savedFilter?.addEventListener('click', (event) => {
      if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      savedOnly = !savedOnly;
      writeUrl();
      render();
    });

    reset?.addEventListener('click', (event) => {
      if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      state.category = '';
      state.author = '';
      savedOnly = false;
      writeUrl();
      render();
      linksFor('category')[0]?.focus();
    });

    window.addEventListener('popstate', () => {
      readUrl();
      render();
    });
    window.addEventListener('blog:bookmarks-update', render);

    readUrl();
    render();
  }
</script>
