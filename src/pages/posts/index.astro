---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts } from '../../lib/posts';

const posts = await getPosts();
---

<BaseLayout title="文章" description="全部文章列表">
  <div class="page-head">
    <div class="shell">
      <h1>文章</h1>
      <p>共 {posts.length} 篇，按发布时间倒序。</p>
    </div>
  </div>

  <div class="shell" style="padding-bottom:40px">
    <ul class="card-grid card-grid--three">
      {posts.map((post) => <PostCard post={post} headingLevel="h2" />)}
    </ul>
  </div>
</BaseLayout>
