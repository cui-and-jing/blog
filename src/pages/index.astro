---
import BaseLayout from '../layouts/BaseLayout.astro';
import Featured from '../components/Featured.astro';
import HomeSeries from '../components/HomeSeries.astro';
import PostCard from '../components/PostCard.astro';
import Sidebar from '../components/Sidebar.astro';
import CategoryTiles from '../components/CategoryTiles.astro';
import { SITE, url, formatDate, daysSince } from '../lib/site';
import { getPosts } from '../lib/posts';
import { getNotes, noteText } from '../lib/notes';
import { collectTags } from '../lib/tags';
import { collectSeries } from '../lib/series';

const posts = await getPosts();
/* featured 字段原来只是躺在 schema 里，首页永远取最新一篇——标了置顶也不生效 */
const featured = posts.find((post) => post.data.featured) ?? posts[0];
const rest = posts.filter((post) => post.id !== featured?.id);
const recent = rest.slice(0, 6);
/* 系列来自文章元数据；内容不成组时不输出空模块 */
const series = collectSeries(posts).slice(0, 2);
const allNotes = await getNotes();
const notes = allNotes.slice(0, 3);
/* 标签与「最近更新」都横跨文章和笔记：只数文章会让首页在刚发过笔记时显示旧日期 */
const tagCount = collectTags(posts, allNotes).length;
const latest = [posts[0]?.data.date, allNotes[0]?.data.date]
  .filter((date): date is Date => Boolean(date))
  .sort((a, b) => b.valueOf() - a.valueOf())[0];
const days = daysSince(SITE.since);

const excerpt = (text: string, limit = 72) =>
  text.length > limit ? `${text.slice(0, limit)}…` : text;
---

<BaseLayout>
  <section class="hero">
    <div class="shell hero-inner">
      <div class="hero-copy">
        <p class="eyebrow">{SITE.tagline}</p>
        <h1>写下来的，<br />才算想清楚了。</h1>
        <p class="hero-lead">
          这里记录技术上的折腾、读过的书和一些没想明白的问题。更新不快，但每篇都认真写。
        </p>
        <nav class="hero-actions" aria-label="阅读入口">
          <a class="hero-action hero-action--primary" href={url('/posts/')}>
            开始阅读
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6" />
            </svg>
          </a>
          <a class="hero-action hero-action--secondary" href={url('/notes/')}>看看笔记</a>
        </nav>
        <div class="hero-stats">
          <span class="stat"><b>{posts.length}</b> 篇文章</span>
          <span class="stat"><b>{tagCount}</b> 个标签</span>
          {latest && <span class="stat"><b>{formatDate(latest)}</b> 最近更新</span>}
        </div>
      </div>

      <aside class="hero-card">
        <div class="hero-card-avatar">
          <img src={url('/avatar.svg')} alt={SITE.author} width="88" height="88" />
        </div>
        <p class="hero-card-name">{SITE.author}</p>
        <p class="hero-card-type">
          <span id="type-line">你好，我们是 Cui &amp; Jing。</span><span class="type-caret" aria-hidden="true"></span>
        </p>
        <div class="hero-card-links">
          <a href={SITE.github} target="_blank" rel="noopener noreferrer">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.1.68-.22.68-.49 0-.24-.01-.88-.01-1.73-2.78.62-3.37-1.37-3.37-1.37-.45-1.18-1.11-1.5-1.11-1.5-.91-.63.07-.62.07-.62 1 .07 1.53 1.06 1.53 1.06.9 1.57 2.36 1.12 2.94.86.09-.67.35-1.12.63-1.38-2.22-.26-4.56-1.14-4.56-5.07 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.7 0 0 .84-.28 2.75 1.05a9.36 9.36 0 0 1 5 0c1.91-1.33 2.75-1.05 2.75-1.05.55 1.4.2 2.44.1 2.7.64.72 1.03 1.63 1.03 2.75 0 3.94-2.34 4.8-4.57 5.06.36.32.68.94.68 1.9 0 1.37-.01 2.47-.01 2.81 0 .27.18.6.69.49A10.26 10.26 0 0 0 22 12.25C22 6.58 17.52 2 12 2Z"/></svg>
            GitHub
          </a>
          <a href={url('/rss.xml')}>
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4 4.5A15.5 15.5 0 0 1 19.5 20h-3A12.5 12.5 0 0 0 4 7.5v-3Zm0 6a9.5 9.5 0 0 1 9.5 9.5h-3A6.5 6.5 0 0 0 4 13.5v-3ZM6 18a2 2 0 1 1 0-4 2 2 0 0 1 0 4Z"/></svg>
            RSS
          </a>
          <a href={url('/about/')}>关于</a>
        </div>
        <p class="hero-card-foot">已写了 <b>{days}</b> 天，还在继续。</p>
      </aside>
    </div>
  </section>

  <div class="shell">
    <div class="cat-tiles">
      <CategoryTiles posts={posts} />
    </div>
  </div>

  <div class="shell with-aside">
    <div>
      {featured && <Featured post={featured} />}

      {
        notes.length > 0 && (
          <>
            <div class="section-head" style="margin-top:34px">
              <h2>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M5 4.5h9.5L19 9v10.5A1.5 1.5 0 0 1 17.5 21h-12A1.5 1.5 0 0 1 4 19.5v-13A1.5 1.5 0 0 1 5.5 5Z" />
                  <path d="M14 4.5V9h4.5M8 13h8M8 16.5h5" />
                </svg>
                最近想法
              </h2>
              <a href={url('/notes/')}>全部笔记 →</a>
            </div>
            <ul class="notes-strip">
              {notes.map((note) => (
                <li>
                  <a href={url(`/notes/${note.id}/`)}>
                    <time datetime={note.data.date.toISOString()}>{formatDate(note.data.date)}</time>
                    <span>{excerpt(noteText(note))}</span>
                  </a>
                </li>
              ))}
            </ul>
          </>
        )
      }

      <HomeSeries items={series} />

      {
        recent.length > 0 && (
          <>
            <div class="section-head" style="margin-top:34px">
              <h2>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M7 3v3M17 3v3M4 8.5h16M5 6h14a1.5 1.5 0 0 1 1.5 1.5v12A1.5 1.5 0 0 1 19 21H5a1.5 1.5 0 0 1-1.5-1.5v-12A1.5 1.5 0 0 1 5 6Z" />
                </svg>
                最近文章
              </h2>
              <a href={url('/posts/')}>全部文章 →</a>
            </div>
            <ul class="card-grid">
              {recent.map((post) => <PostCard post={post} />)}
            </ul>
          </>
        )
      }

      {
        recent.length === 0 && (
          <div class="widget" style="margin-top:24px">
            <p style="margin:0;color:var(--text-soft)">还没有文章。往 <code>src/content/posts/</code> 里丢一个 Markdown 文件就会出现在这里。</p>
          </div>
        )
      }
    </div>

    <Sidebar posts={posts} showAuthor={false} />
  </div>
</BaseLayout>

<script>
  const line = document.getElementById('type-line');
  const full = line?.textContent ?? '';

  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    // 保持静态全文
  } else if (line) {
    const lines = [full, '不追热点，只写想清楚的事。', '更新不快，但每篇都认真写。'];
    let li = 0;
    let ci = 0;
    let deleting = false;

    const tick = () => {
      const text = lines[li];
      ci += deleting ? -1 : 1;
      line!.textContent = text.slice(0, ci);

      let delay = deleting ? 34 : 92;
      if (!deleting && ci === text.length) {
        delay = 2600;
        deleting = true;
      } else if (deleting && ci === 0) {
        deleting = false;
        li = (li + 1) % lines.length;
        delay = 420;
      }
      setTimeout(tick, delay);
    };
    setTimeout(tick, 900);
  }
</script>
