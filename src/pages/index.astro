---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Featured from '../components/Featured.astro';
import PostCard from '../components/PostCard.astro';
import Sidebar from '../components/Sidebar.astro';
import { SITE, url, formatDate } from '../lib/site';

const all = await getCollection('posts', ({ data }) => !data.draft);
const posts = all.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const [featured, ...rest] = posts;
const recent = rest.slice(0, 6);
const tagCount = new Set(posts.flatMap((p) => p.data.tags)).size;
const latest = posts[0]?.data.date;
---

<BaseLayout>
  <section class="hero">
    <div class="shell">
      <p class="eyebrow">{SITE.tagline}</p>
      <h1>写下来的，才算想清楚了。</h1>
      <p class="hero-lead">
        这里记录技术上的折腾、读过的书和一些没想明白的问题。更新不快，但每篇都认真写。
      </p>
      <div class="hero-stats">
        <span class="stat"><b>{posts.length}</b> 篇文章</span>
        <span class="stat"><b>{tagCount}</b> 个标签</span>
        {latest && <span class="stat"><b>{formatDate(latest)}</b> 最近更新</span>}
      </div>
    </div>
  </section>

  <div class="shell with-aside">
    <div>
      {featured && <Featured post={featured} />}

      {
        recent.length > 0 && (
          <>
            <div class="section-head" style="margin-top:30px">
              <h2>最近更新</h2>
              <a href={url('/posts/')}>全部文章 →</a>
            </div>
            <ul class="card-grid">
              {recent.map((post) => <PostCard post={post} />)}
            </ul>
          </>
        )
      }

      {
        recent.length === 0 && (
          <div class="widget" style="margin-top:24px">
            <p style="margin:0;color:var(--text-soft)">还没有文章。往 <code>src/content/posts/</code> 里丢一个 Markdown 文件就会出现在这里。</p>
          </div>
        )
      }
    </div>

    <Sidebar posts={posts} />
  </div>
</BaseLayout>
