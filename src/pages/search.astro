---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { url, formatDate, readingTime, base } from '../lib/site';

const all = await getCollection('posts', ({ data }) => !data.draft);
const posts = all.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="搜索" description="在全部文章里按标题、标签或正文查找">
  <div class="page-head">
    <div class="shell">
      <h1>搜索</h1>
      <p>{posts.length} 篇文章，慢慢找。</p>
    </div>
  </div>

  <div class="shell search-shell" data-base={base}>
    <div class="search-box">
      <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
        <circle cx="11" cy="11" r="6.4"></circle>
        <path d="m16 16 4.2 4.2"></path>
      </svg>
      <input
        id="search-input"
        type="search"
        placeholder="搜索标题、标签或正文…"
        autocomplete="off"
        spellcheck="false"
        aria-label="搜索文章"
        aria-controls="search-results"
      />
      <button class="search-clear" id="search-clear" type="button" aria-label="清除搜索" hidden>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <path d="M6 6l12 12M18 6 6 18"></path>
        </svg>
      </button>
    </div>

    <div class="search-meta">
      <span id="search-count" aria-live="polite">共 {posts.length} 篇</span>
      <span class="search-keys" aria-hidden="true"><kbd>↑</kbd><kbd>↓</kbd> 选择 <kbd>Enter</kbd> 打开 <kbd>Esc</kbd> 清空</span>
    </div>

    <noscript>
      <p class="search-noscript">搜索需要启用 JavaScript。下面是全部文章，也可以直接翻<a href={url('/posts/')}>文章列表</a>。</p>
    </noscript>

    <ol class="search-results" id="search-results">
      {
        posts.map((post) => (
          <li class="search-result">
            <a
              class="search-item"
              href={url(`/posts/${post.id}/`)}
              data-title={post.data.title}
              data-desc={post.data.description}
              data-tags={post.data.tags.join(' ')}
              data-cat={post.data.category ?? ''}
              data-href={url(`/posts/${post.id}/`)}
            >
              <div class="search-item-main">
                <h2>{post.data.title}</h2>
                <p>{post.data.description}</p>
                <div class="search-item-meta">
                  <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
                  {post.data.category && <span class="cat">{post.data.category}</span>}
                  <span>约 {readingTime(post.body ?? '')} 分钟</span>
                  {post.data.tags.slice(0, 3).map((tag: string) => <span class="tag">#{tag}</span>)}
                </div>
              </div>
              <span class="search-arrow" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14M13 6l6 6-6 6"></path>
                </svg>
              </span>
            </a>
          </li>
        ))
      }
    </ol>

    <div class="search-empty" id="search-empty" hidden>
      <p class="search-empty-title">没有找到相关文章</p>
      <p class="search-empty-hint">换个关键词，或者试试更短的词。</p>
      <button class="btn" id="search-reset" type="button">清除搜索</button>
    </div>
  </div>

  <script>
    const shell = document.querySelector<HTMLElement>('.search-shell');
    const input = document.getElementById('search-input') as HTMLInputElement | null;
    const list = document.getElementById('search-results');
    const empty = document.getElementById('search-empty');
    const countEl = document.getElementById('search-count');
    const clearBtn = document.getElementById('search-clear') as HTMLButtonElement | null;
    const resetBtn = document.getElementById('search-reset');

    if (shell && input && list && empty && countEl) {
      const baseUrl = shell.dataset.base ?? '';
      let posts: any[] = [];
      let active = -1;
      let ready = false;

      const escapeRe = (s: string) => s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');

      const highlight = (text: string, terms: string[]): DocumentFragment => {
        const frag = document.createDocumentFragment();
        if (!terms.length || !text) {
          frag.append(text);
          return frag;
        }
        const re = new RegExp(`(${terms.map(escapeRe).join('|')})`, 'gi');
        let last = 0;
        let match: RegExpExecArray | null;
        while ((match = re.exec(text))) {
          if (match.index > last) frag.append(text.slice(last, match.index));
          const mark = document.createElement('mark');
          mark.textContent = match[0];
          frag.append(mark);
          last = match.index + match[0].length;
          if (re.lastIndex === match.index) re.lastIndex += 1;
        }
        if (last < text.length) frag.append(text.slice(last));
        return frag;
      };

      const snippet = (post: any, terms: string[]): string => {
        const text: string = post.text ?? '';
        const at = terms.map((t) => text.toLowerCase().indexOf(t)).filter((i) => i >= 0).sort((a, b) => a - b)[0];
        if (at === undefined) return post.description;

        let start = Math.max(0, at - 40);
        if (start > 0) {
          const back = text.slice(start, at);
          const punct = Math.max(
            back.lastIndexOf('。'),
            back.lastIndexOf('，'),
            back.lastIndexOf('；'),
            back.lastIndexOf('！'),
            back.lastIndexOf('？')
          );
          if (punct >= 0 && punct < back.length - 8) start += punct + 1;
        }

        const end = Math.min(text.length, at + 90);
        return `${start > 0 ? '…' : ''}${text.slice(start, end)}${end < text.length ? '…' : ''}`;
      };

      const score = (post: any, terms: string[]) => {
        const title = post.title.toLowerCase();
        const desc = (post.description ?? '').toLowerCase();
        const category = (post.category ?? '').toLowerCase();
        const tags = (post.tags ?? []).map((t: string) => t.toLowerCase());
        const text = (post.text ?? '').toLowerCase();
        let total = 0;

        for (const term of terms) {
          let hit = 0;
          if (title.includes(term)) hit += title === term ? 40 : 14;
          if (tags.some((t: string) => t.includes(term))) hit += 9;
          if (category.includes(term)) hit += 6;
          if (desc.includes(term)) hit += 5;
          if (text.includes(term)) hit += 1;
          if (!hit) return 0;
          total += hit;
        }

        const phrase = terms.join(' ');
        if (terms.length > 1 && title.includes(phrase)) total += 24;
        if (terms.length > 1 && text.includes(phrase)) total += 4;
        return total;
      };

      const setActive = (next: number) => {
        const nodes = Array.from(list.querySelectorAll<HTMLElement>('.search-result'));
        if (!nodes.length) return;
        active = Math.max(0, Math.min(nodes.length - 1, next));
        nodes.forEach((node, i) => node.classList.toggle('is-active', i === active));
        nodes[active].scrollIntoView({ block: 'nearest' });
      };

      const render = (items: { post: any; terms: string[] }[], querying: boolean) => {
        active = -1;
        list.replaceChildren();

        items.forEach(({ post, terms }) => {
          const li = document.createElement('li');
          li.className = 'search-result';

          const a = document.createElement('a');
          a.className = 'search-item';
          a.href = post.href;

          const main = document.createElement('div');
          main.className = 'search-item-main';

          const h2 = document.createElement('h2');
          h2.append(highlight(post.title, terms));

          const p = document.createElement('p');
          p.append(highlight(snippet(post, terms), terms));

          const meta = document.createElement('div');
          meta.className = 'search-item-meta';
          const time = document.createElement('time');
          time.textContent = post.date;
          meta.append(time);
          if (post.category) {
            const cat = document.createElement('span');
            cat.className = 'cat';
            cat.textContent = post.category;
            meta.append(cat);
          }
          const mins = document.createElement('span');
          mins.textContent = `约 ${post.minutes} 分钟`;
          meta.append(mins);
          (post.tags ?? []).slice(0, 3).forEach((tag: string) => {
            const span = document.createElement('span');
            span.className = 'tag';
            span.textContent = `#${tag}`;
            meta.append(span);
          });

          main.append(h2, p, meta);

          const arrow = document.createElement('span');
          arrow.className = 'search-arrow';
          arrow.setAttribute('aria-hidden', 'true');
          arrow.innerHTML =
            '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>';

          a.append(main, arrow);
          li.append(a);
          list.append(li);
        });

        const hasQuery = querying;
        countEl.textContent = hasQuery ? `找到 ${items.length} 篇` : `共 ${items.length} 篇`;
        empty.hidden = items.length > 0;
        list.hidden = items.length === 0;
      };

      const apply = () => {
        if (!ready) return;
        const query = input.value.trim();
        const terms = query.toLowerCase().split(/\s+/).filter(Boolean).slice(0, 6);
        if (clearBtn) clearBtn.hidden = query.length === 0;

        const url = new URL(location.href);
        if (query) url.searchParams.set('q', query);
        else url.searchParams.delete('q');
        history.replaceState(null, '', url);

        if (!terms.length) {
          render(posts.map((post) => ({ post, terms: [] })), false);
          return;
        }

        const matched = posts
          .map((post) => ({ post, score: score(post, terms) }))
          .filter((item) => item.score > 0)
          .sort((a, b) => b.score - a.score || b.post.title.localeCompare(a.post.title))
          .map((item) => ({ post: item.post, terms }));

        render(matched, true);
      };

      const fallback = () =>
        Array.from(document.querySelectorAll<HTMLAnchorElement>('.search-item')).map((a) => ({
          title: a.dataset.title ?? '',
          description: a.dataset.desc ?? '',
          tags: (a.dataset.tags ?? '').split(' ').filter(Boolean),
          category: a.dataset.cat ?? '',
          href: a.dataset.href ?? a.href,
          date: a.querySelector('time')?.textContent ?? '',
          minutes: 0,
          text: '',
        }));

      const fetchIndex = async () => {
        try {
          const res = await fetch(`${baseUrl}/search-index.json`, { headers: { Accept: 'application/json' } });
          const data = res.ok ? await res.json() : null;
          posts = Array.isArray(data?.posts) && data.posts.length ? data.posts : fallback();
        } catch {
          /* 离线或请求失败时，用服务端渲染的列表做基础搜索 */
          posts = fallback();
        }
        ready = true;
        apply();
      };

      input.addEventListener('input', apply);
      input.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowDown') {
          event.preventDefault();
          setActive(active + 1);
        } else if (event.key === 'ArrowUp') {
          event.preventDefault();
          setActive(active - 1);
        } else if (event.key === 'Enter') {
          const node = list.querySelectorAll<HTMLAnchorElement>('.search-item')[active];
          if (node) {
            event.preventDefault();
            location.href = node.href;
          }
        } else if (event.key === 'Escape') {
          if (input.value) {
            input.value = '';
            apply();
          } else {
            input.blur();
          }
        }
      });

      clearBtn?.addEventListener('click', () => {
        input.value = '';
        apply();
        input.focus();
      });
      resetBtn?.addEventListener('click', () => {
        input.value = '';
        apply();
        input.focus();
      });

      const initial = new URL(location.href).searchParams.get('q');
      if (initial) input.value = initial;
      fetchIndex();

      /* 桌面端进入即聚焦；移动端不主动弹键盘 */
      if (!initial && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
        input.focus({ preventScroll: true });
      }
    }
  </script>
</BaseLayout>
