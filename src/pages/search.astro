---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url, formatDate, readingTime, base } from '../lib/site';
import { getPosts } from '../lib/posts';

const posts = await getPosts();

/* 无结果时的兜底：给几篇最近的文章和几个高频标签，比干巴巴一句「换个词」有用 */
const recent = posts.slice(0, 3);
const tagCounts = new Map<string, number>();
for (const post of posts) {
  for (const tag of post.data.tags) tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
}
const topTags = [...tagCounts.entries()]
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'zh-CN'))
  .slice(0, 6)
  .map(([tag]) => tag);
---

<BaseLayout title="搜索" description="在全部文章里按标题、标签或正文查找">
  <div class="page-head">
    <div class="shell">
      <h1>搜索</h1>
      <p>{posts.length} 篇文章，慢慢找。</p>
    </div>
  </div>

  <div class="shell search-shell" data-base={base}>
    <div class="search-box">
      <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
        <circle cx="11" cy="11" r="6.4"></circle>
        <path d="m16 16 4.2 4.2"></path>
      </svg>
      <input
        id="search-input"
        type="search"
        placeholder="搜索标题、标签或正文…"
        autocomplete="off"
        spellcheck="false"
        aria-label="搜索文章"
        aria-controls="search-results"
      />
      <button class="search-clear" id="search-clear" type="button" aria-label="清除搜索" hidden>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <path d="M6 6l12 12M18 6 6 18"></path>
        </svg>
      </button>
    </div>

    <div class="search-meta">
      <span id="search-count" aria-live="polite">共 {posts.length} 篇</span>
      <span class="search-keys" aria-hidden="true"><kbd>↑</kbd><kbd>↓</kbd> 选择 <kbd>Enter</kbd> 打开 <kbd>Esc</kbd> 清空</span>
    </div>

    <noscript>
      <p class="search-noscript">搜索需要启用 JavaScript。下面是全部文章，也可以直接翻<a href={url('/posts/')}>文章列表</a>。</p>
    </noscript>

    <div class="search-history" id="search-history" hidden>
      <div class="search-history-head">
        <span>最近搜索</span>
        <button class="search-history-clear" id="search-history-clear" type="button">清除</button>
      </div>
      <div class="search-history-list" id="search-history-list"></div>
    </div>

    <ol class="search-results" id="search-results">
      {
        posts.map((post) => (
          <li class="search-result">
            <a
              class="search-item"
              href={url(`/posts/${post.id}/`)}
              data-title={post.data.title}
              data-desc={post.data.description}
              data-tags={post.data.tags.join(' ')}
              data-cat={post.data.category ?? ''}
              data-href={url(`/posts/${post.id}/`)}
            >
              <div class="search-item-main">
                <h2>{post.data.title}</h2>
                <p>{post.data.description}</p>
                <div class="search-item-meta">
                  <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
                  {post.data.category && <span class="cat">{post.data.category}</span>}
                  <span>约 {readingTime(post.body ?? '')} 分钟</span>
                  {post.data.tags.slice(0, 3).map((tag: string) => <span class="tag">#{tag}</span>)}
                </div>
              </div>
              <span class="search-arrow" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14M13 6l6 6-6 6"></path>
                </svg>
              </span>
            </a>
          </li>
        ))
      }
    </ol>

    <div class="search-empty" id="search-empty" hidden>
      <p class="search-empty-title">没有找到相关文章</p>
      <p class="search-empty-hint">换个短一点的词，或者从下面挑一篇。</p>
      <button class="btn" id="search-reset" type="button">清除搜索</button>

      <div class="search-suggest">
        {
          recent.length > 0 && (
            <div class="search-suggest-group">
              <h2>最近更新</h2>
              <ul>
                {recent.map((post) => (
                  <li>
                    <a href={url(`/posts/${post.id}/`)}>{post.data.title}</a>
                    <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
        {
          topTags.length > 0 && (
            <div class="search-suggest-group">
              <h2>热门标签</h2>
              <div class="search-suggest-tags">
                {topTags.map((tag) => (
                  <a href={url(`/tags/${encodeURIComponent(tag)}/`)}>#{tag}</a>
                ))}
              </div>
            </div>
          )
        }
      </div>
    </div>
  </div>

  <script>
    const shell = document.querySelector<HTMLElement>('.search-shell');
    const input = document.getElementById('search-input') as HTMLInputElement | null;
    const list = document.getElementById('search-results');
    const empty = document.getElementById('search-empty');
    const countEl = document.getElementById('search-count');
    const clearBtn = document.getElementById('search-clear') as HTMLButtonElement | null;
    const resetBtn = document.getElementById('search-reset');

    if (shell && input && list && empty && countEl) {
      const baseUrl = shell.dataset.base ?? '';
      const historyBox = document.getElementById('search-history');
      const historyList = document.getElementById('search-history-list');
      const historyClear = document.getElementById('search-history-clear') as HTMLButtonElement | null;
      let posts: any[] = [];
      let active = -1;
      let ready = false;

      const escapeRe = (s: string) => s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');

      const countOf = (haystack: string, needle: string) => {
        let n = 0;
        let at = haystack.indexOf(needle);
        while (at >= 0 && n < 12) {
          n += 1;
          at = haystack.indexOf(needle, at + needle.length);
        }
        return n;
      };

      /* 只放几乎没有检索价值的虚词。像「不」「有」「这」都可能出现在实词里，不能当停用词 */
      const STOP = new Set([
        '的', '了', '是', '在', '和', '与', '及', '或', '把', '被', '着', '吗', '呢', '吧', '啊',
        'the', 'a', 'an', 'of', 'and', 'or', 'to', 'in', 'is', 'it', 'on', 'for', 'at', 'by', 'as', 'with',
      ]);

      const highlight = (text: string, terms: string[]): DocumentFragment => {
        const frag = document.createDocumentFragment();
        if (!terms.length || !text) {
          frag.append(text);
          return frag;
        }
        const re = new RegExp(`(${terms.map(escapeRe).join('|')})`, 'gi');
        let last = 0;
        let match: RegExpExecArray | null;
        while ((match = re.exec(text))) {
          if (match.index > last) frag.append(text.slice(last, match.index));
          const mark = document.createElement('mark');
          mark.textContent = match[0];
          frag.append(mark);
          last = match.index + match[0].length;
          if (re.lastIndex === match.index) re.lastIndex += 1;
        }
        if (last < text.length) frag.append(text.slice(last));
        return frag;
      };

      const snippet = (post: any, terms: string[]): string => {
        const text: string = post.text ?? '';
        const at = terms.map((t) => text.toLowerCase().indexOf(t)).filter((i) => i >= 0).sort((a, b) => a - b)[0];
        if (at === undefined) return post.description;

        let start = Math.max(0, at - 40);
        if (start > 0) {
          const back = text.slice(start, at);
          const punct = Math.max(
            back.lastIndexOf('。'),
            back.lastIndexOf('，'),
            back.lastIndexOf('；'),
            back.lastIndexOf('！'),
            back.lastIndexOf('？')
          );
          if (punct >= 0 && punct < back.length - 8) start += punct + 1;
        }

        const end = Math.min(text.length, at + 90);
        return `${start > 0 ? '…' : ''}${text.slice(start, end)}${end < text.length ? '…' : ''}`;
      };

      const score = (post: any, terms: string[]) => {
        const title = post.title.toLowerCase();
        const desc = (post.description ?? '').toLowerCase();
        const category = (post.category ?? '').toLowerCase();
        const tags = (post.tags ?? []).map((t: string) => t.toLowerCase());
        const text = (post.text ?? '').toLowerCase();
        let total = 0;
        let hits = 0;

        for (const term of terms) {
          let hit = 0;
          if (title.includes(term)) hit += title === term ? 40 : 14;
          if (tags.some((t: string) => t.includes(term))) hit += 9;
          if (category.includes(term)) hit += 6;
          if (desc.includes(term)) hit += 5;
          const inText = countOf(text, term);
          /* 出现次数按 log 计，避免长文靠体量碾压短文 */
          if (inText) hit += 1 + Math.log2(inText);
          if (hit) {
            hits += 1;
            total += hit;
          }
        }

        /* 一个词都不沾才算无关。只命中一部分仍然收录，按覆盖率打折——
           否则「Astro 图片」会因为某篇只提了 Astro 就整篇消失。 */
        if (!hits) return 0;
        total *= 0.55 + (hits / terms.length) * 0.45;

        const phrase = terms.join(' ');
        if (terms.length > 1 && title.includes(phrase)) total += 24;
        if (terms.length > 1 && text.includes(phrase)) total += 4;
        if (hits === terms.length && terms.length > 1) total += 10;
        return total;
      };

      const setActive = (next: number) => {
        const nodes = Array.from(list.querySelectorAll<HTMLElement>('.search-result'));
        if (!nodes.length) return;
        active = Math.max(0, Math.min(nodes.length - 1, next));
        nodes.forEach((node, i) => node.classList.toggle('is-active', i === active));
        nodes[active].scrollIntoView({ block: 'nearest' });
      };

      const render = (items: { post: any; terms: string[] }[], querying: boolean) => {
        active = -1;
        list.replaceChildren();

        items.forEach(({ post, terms }) => {
          const li = document.createElement('li');
          li.className = 'search-result';

          const a = document.createElement('a');
          a.className = 'search-item';
          a.href = post.href;

          const main = document.createElement('div');
          main.className = 'search-item-main';

          const h2 = document.createElement('h2');
          h2.append(highlight(post.title, terms));

          const p = document.createElement('p');
          p.append(highlight(snippet(post, terms), terms));

          const meta = document.createElement('div');
          meta.className = 'search-item-meta';
          const time = document.createElement('time');
          time.textContent = post.date;
          meta.append(time);
          if (post.category) {
            const cat = document.createElement('span');
            cat.className = 'cat';
            cat.textContent = post.category;
            meta.append(cat);
          }
          const mins = document.createElement('span');
          mins.textContent = `约 ${post.minutes} 分钟`;
          meta.append(mins);
          (post.tags ?? []).slice(0, 3).forEach((tag: string) => {
            const span = document.createElement('span');
            span.className = 'tag';
            span.textContent = `#${tag}`;
            meta.append(span);
          });

          main.append(h2, p, meta);

          const arrow = document.createElement('span');
          arrow.className = 'search-arrow';
          arrow.setAttribute('aria-hidden', 'true');
          arrow.innerHTML =
            '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>';

          a.append(main, arrow);
          li.append(a);
          list.append(li);
        });

        const hasQuery = querying;
        countEl.textContent = hasQuery ? `找到 ${items.length} 篇` : `共 ${items.length} 篇`;
        empty.hidden = items.length > 0;
        list.hidden = items.length === 0;
      };

      /* ---------- 搜索历史（只存本机，最多 6 条） ---------- */
      const HISTORY_KEY = 'search:history';
      const HISTORY_MAX = 6;

      const readHistory = (): string[] => {
        try {
          const raw: unknown = JSON.parse(localStorage.getItem(HISTORY_KEY) ?? '[]');
          return Array.isArray(raw)
            ? raw.filter((item: unknown): item is string => typeof item === 'string').slice(0, HISTORY_MAX)
            : [];
        } catch {
          return [];
        }
      };

      const writeHistory = (next: string[]) => {
        try {
          localStorage.setItem(HISTORY_KEY, JSON.stringify(next.slice(0, HISTORY_MAX)));
        } catch {
          /* 隐私模式写不进去，搜索本身不受影响 */
        }
      };

      const remember = (value: string) => {
        const query = value.trim();
        if (query.length < 2) return;
        writeHistory([query, ...readHistory().filter((item) => item !== query)]);
      };

      const renderHistory = () => {
        if (!historyBox || !historyList) return;
        const items = readHistory();
        const show = items.length > 0 && input.value.trim() === '';
        historyBox.hidden = !show;
        if (!show) return;
        historyList.replaceChildren(
          ...items.map((value) => {
            const button = document.createElement('button');
            button.type = 'button';
            button.className = 'search-history-item';
            button.textContent = value;
            button.addEventListener('click', () => {
              input.value = value;
              apply();
              input.focus();
            });
            return button;
          })
        );
      };

      historyClear?.addEventListener('click', () => {
        writeHistory([]);
        renderHistory();
        input.focus();
      });

      const apply = () => {
        if (!ready) return;
        const query = input.value.trim();
        const words = query.toLowerCase().split(/\s+/).filter(Boolean).slice(0, 6);
        /* 整句都是「的」「了」这类虚词时按空查询处理，比返回零结果合理 */
        const terms = words.filter((word) => !STOP.has(word));
        if (clearBtn) clearBtn.hidden = query.length === 0;

        const url = new URL(location.href);
        if (query) url.searchParams.set('q', query);
        else url.searchParams.delete('q');
        history.replaceState(null, '', url);

        if (!terms.length) {
          render(posts.map((post) => ({ post, terms: [] })), false);
          renderHistory();
          return;
        }

        const matched = posts
          .map((post, index) => ({ post, index, score: score(post, terms) }))
          .filter((item) => item.score > 0)
          /* 同分时保持原有时间倒序，比按标题拼音排更符合直觉 */
          .sort((a, b) => b.score - a.score || a.index - b.index)
          .map((item) => ({ post: item.post, terms }));

        render(matched, true);
        renderHistory();
      };

      const fallback = () =>
        Array.from(document.querySelectorAll<HTMLAnchorElement>('.search-item')).map((a) => ({
          title: a.dataset.title ?? '',
          description: a.dataset.desc ?? '',
          tags: (a.dataset.tags ?? '').split(' ').filter(Boolean),
          category: a.dataset.cat ?? '',
          href: a.dataset.href ?? a.href,
          date: a.querySelector('time')?.textContent ?? '',
          minutes: 0,
          text: '',
        }));

      const fetchIndex = async () => {
        try {
          const res = await fetch(`${baseUrl}/search-index.json`, { headers: { Accept: 'application/json' } });
          const data = res.ok ? await res.json() : null;
          posts = Array.isArray(data?.posts) && data.posts.length ? data.posts : fallback();
        } catch {
          /* 离线或请求失败时，用服务端渲染的列表做基础搜索 */
          posts = fallback();
        }
        ready = true;
        apply();
      };

      input.addEventListener('input', apply);
      /* 点结果跳转前记一笔，历史里才不会只有回车过的词 */
      list.addEventListener('click', (event) => {
        if ((event.target as Element).closest('.search-item')) remember(input.value);
      });
      input.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowDown') {
          event.preventDefault();
          setActive(active + 1);
        } else if (event.key === 'ArrowUp') {
          event.preventDefault();
          setActive(active - 1);
        } else if (event.key === 'Enter') {
          /* 没有用方向键选过时，回车直接打开第一条结果 */
          const nodes = list.querySelectorAll<HTMLAnchorElement>('.search-item');
          const node = nodes[active >= 0 ? active : 0];
          if (node) {
            event.preventDefault();
            remember(input.value);
            location.href = node.href;
          }
        } else if (event.key === 'Escape') {
          if (input.value) {
            input.value = '';
            apply();
          } else {
            input.blur();
          }
        }
      });

      clearBtn?.addEventListener('click', () => {
        input.value = '';
        apply();
        input.focus();
      });
      resetBtn?.addEventListener('click', () => {
        input.value = '';
        apply();
        input.focus();
      });

      const initial = new URL(location.href).searchParams.get('q');
      if (initial) input.value = initial;
      fetchIndex();

      /* 桌面端进入即聚焦；移动端不主动弹键盘 */
      if (!initial && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
        input.focus({ preventScroll: true });
      }
    }
  </script>
</BaseLayout>
