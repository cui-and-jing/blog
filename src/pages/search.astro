---
import BaseLayout from '../layouts/BaseLayout.astro';
import searchPageCssSource from '../styles/search-page.css?raw';
import { url, formatDate, readingTime, base } from '../lib/site';
import { getPosts } from '../lib/posts';
import { getNotes, noteTitle } from '../lib/notes';
import { activityDate } from '../lib/recent-date.mjs';
import { collectTags } from '../lib/tags';
import { uniqueSearchTags } from '../lib/search-tags.mjs';

// Keep search-only CSS in this HTML; it is not needed on other routes.
const searchPageCss = searchPageCssSource.replace(/\/\*[\s\S]*?\*\//g, '');
const posts = await getPosts();
const notes = await getNotes();

/* Search fallback includes new notes and article edits as well as new articles. */
const recent = [
  ...posts.map((post) => {
    const date = activityDate(post.data);
    return {
      type: 'post' as const,
      title: post.data.title,
      date,
      isUpdated: date.getTime() > post.data.date.getTime(),
      href: url(`/posts/${post.id}/`),
    };
  }),
  ...notes.map((note) => ({
    type: 'note' as const,
    title: noteTitle(note),
    date: note.data.date,
    isUpdated: false,
    href: url(`/notes/${note.id}/`),
  })),
].sort((a, b) => b.date.valueOf() - a.date.valueOf()).slice(0, 3);
const topTags = collectTags(posts, notes).slice(0, 6).map(({ tag }) => tag);
---

<BaseLayout title="搜索" description="在文章和笔记中按标题、标签或正文查找">
  <style slot="head" is:inline set:html={searchPageCss} />
  <div class="page-head">
    <div class="shell">
      <h1>搜索</h1>
      <p>{posts.length} 篇文章{notes.length > 0 ? `、${notes.length} 条笔记` : ''}，慢慢找。</p>
    </div>
  </div>

  <div class="shell search-shell" data-base={base}>
    <div class="search-box">
      <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
        <circle cx="11" cy="11" r="6.4"></circle>
        <path d="m16 16 4.2 4.2"></path>
      </svg>
      <input
        id="search-input"
        type="search"
        enterkeyhint="search"
        placeholder="搜索标题、标签或正文…"
        autocomplete="off"
        spellcheck="false"
        aria-label="搜索文章与笔记"
        aria-controls="search-results"
      />
      <button class="search-clear" id="search-clear" type="button" aria-label="清除搜索" hidden>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <path d="M6 6l12 12M18 6 6 18"></path>
        </svg>
      </button>
    </div>

    <div class="search-meta">
      <span id="search-count" aria-live="polite">共 {posts.length} 篇</span>
      <span class="search-keys" aria-hidden="true"><kbd>↑</kbd><kbd>↓</kbd> 选择 <kbd>Enter</kbd> 打开 <kbd>Esc</kbd> 清空</span>
    </div>

    <div class="search-history-list search-filters" id="search-type-filters" role="group" aria-label="搜索结果" hidden>
      <button class="search-history-item" type="button" data-search-type="all" aria-pressed="false">全部</button>
      <button class="search-history-item" type="button" data-search-type="post" aria-pressed="false">文章</button>
      <button class="search-history-item" type="button" data-search-type="note" aria-pressed="false">笔记</button>
    </div>
    <p class="search-noscript" id="search-index-warning" role="status" hidden>正文搜索不可用，笔记不可用。</p>
    <span class="sr-only" id="search-nav-status" role="status" aria-live="polite"></span>

    <noscript>
      <p class="search-noscript">搜索需要启用 JavaScript。下面是全部文章，也可以直接翻<a href={url('/posts/')}>文章列表</a>。</p>
    </noscript>

    <div class="search-history" id="search-history" hidden>
      <div class="search-history-head">
        <span>最近搜索</span>
        <button class="search-history-clear" id="search-history-clear" type="button" aria-label="清除最近搜索记录">清除</button>
      </div>
      <div class="search-history-list" id="search-history-list"></div>
    </div>

    <ol class="search-results" id="search-results">
      {
        posts.map((post) => (
          <li class="search-result">
            <a
              class="search-item"
              href={url(`/posts/${post.id}/`)}
              data-title={post.data.title}
              data-desc={post.data.description}
              data-tags={JSON.stringify(uniqueSearchTags(post.data.tags))}
              data-cat={post.data.category ?? ''}

              data-type="post"
              data-minutes={readingTime(post.body ?? '')}
            >
              <div class="search-item-main">
                <h2>{post.data.title}</h2>
                <p>{post.data.description}</p>
                <div class="search-item-meta">
                  <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
                  {post.data.category && <span class="cat">{post.data.category}</span>}
                  <span>约 {readingTime(post.body ?? '')} 分钟</span>
                  {uniqueSearchTags(post.data.tags).slice(0, 3).map((tag: string) => <span class="tag">#{tag}</span>)}
                </div>
              </div>
              <span class="search-arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))
      }
    </ol>

    <div class="search-empty" id="search-empty" hidden>
      <p class="search-empty-title">没有找到相关内容</p>
      <p class="search-empty-hint" id="search-empty-hint">换个词，或者从下面挑一篇。</p>
      <button class="btn" id="search-reset" type="button">清除搜索</button>

      <div class="search-suggest">
        {
          recent.length > 0 && (
            <div class="search-suggest-group">
              <h2>最近更新</h2>
              <ul>
                {recent.map((item) => (
                  <li>
                    <a href={item.href}>
                      <span class="sr-only">{item.type === 'note' ? '笔记：' : '文章：'}</span>
                      {item.title}
                    </a>
                    {item.isUpdated && <span class="sr-only">更新于</span>}
                    <time datetime={item.date.toISOString()}>{formatDate(item.date)}</time>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
        {
          topTags.length > 0 && (
            <div class="search-suggest-group">
              <h2>热门标签</h2>
              <div class="search-suggest-tags">
                {topTags.map((tag) => (
                  <a href={url(`/tags/${encodeURIComponent(tag)}/`)}>#{tag}</a>
                ))}
              </div>
            </div>
          )
        }
      </div>
    </div>
  </div>

  <script>
    const shell = document.querySelector<HTMLElement>('.search-shell');
    const input = document.getElementById('search-input') as HTMLInputElement | null;
    const list = document.getElementById('search-results');
    const empty = document.getElementById('search-empty');
    const countEl = document.getElementById('search-count');
    const clearBtn = document.getElementById('search-clear') as HTMLButtonElement | null;
    const resetBtn = document.getElementById('search-reset');

    if (shell && input && list && empty && countEl) {
      const baseUrl = shell.dataset.base!;
      const historyBox = document.getElementById('search-history')!;
      const historyList = document.getElementById('search-history-list')!;
      const historyClear = document.getElementById('search-history-clear') as HTMLButtonElement;
      type SearchType = 'all' | 'post' | 'note';
      const typeButtons = document.querySelectorAll<HTMLButtonElement>('[data-search-type]');
      const navStatus = document.getElementById('search-nav-status')!;
      const pageUrl = () => new URL(location.href);
      let posts: any[] = [];
      let active = -1;
      let ready = false;
      let degraded = false;
      let selectedType: SearchType = 'post';
      let composing = false;

      const escapeRe = (s: string) => s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');

      /* 只放几乎没有检索价值的虚词。像「不」「有」「这」都可能出现在实词里，不能当停用词 */
      /* 不过滤 in/as/by/it/on 等编程短词；停用词表首项为空串，以过滤空查询拆出的空词。 */
      const STOP = ' 的 了 是 在 和 与 及 或 把 被 着 吗 呢 吧 啊 the a an of and or'.split(' ');

      const highlight = (text: string, terms: string[]): DocumentFragment => {
        const frag = document.createDocumentFragment();
        if (terms.length) {
          const re = new RegExp(`(${terms.map(escapeRe).join('|')})`, 'gi');
          text.split(re).forEach((part, index) => {
            if (index % 2) {
              const mark = document.createElement('mark');
              mark.textContent = part;
              frag.append(mark);
            } else if (part) frag.append(part);
          });
        } else frag.append(text);
        return frag;
      };

      const snippet = (post: any, terms: string[]): string => {
        const text: string = post.text;
        const low = text.toLowerCase();
        let at = text.length;
        for (const term of terms) {
          const hit = low.indexOf(term);
          if (hit >= 0 && hit < at) at = hit;
        }
        if (at === text.length) return post.description;
        const start = Math.max(0, at - 40);
        const end = Math.min(text.length, at + 90);
        return `${start ? '…' : ''}${text.slice(start, end)}${end < text.length ? '…' : ''}`;
      };

      const score = (post: any, terms: string[]) => {
        const title = post.title.toLowerCase();
        const desc = post.description.toLowerCase();
        const category = post.category.toLowerCase();
        const tags = post.tags.join(' ').toLowerCase();
        const body = post.text.toLowerCase();
        let total = 0;
        let hits = 0;
        for (const term of terms) {
          /* Cap text match weight at 12 occurrences without unbounded allocations. */
          const times = body.split(term, 13).length - 1;
          const weight = (title === term ? 40 : title.includes(term) ? 14 : 0)
            + (tags.includes(term) ? 9 : 0)
            + (category.includes(term) ? 6 : 0)
            + (desc.includes(term) ? 5 : 0)
            + (times ? 1 + Math.log2(times) : 0);
          if (weight) { total += weight; hits++; }
        }
        if (!hits) return 0;
        total *= .55 + hits / terms.length * .45;
        if (terms.length > 1) {
          const phrase = terms.join(' ');
          total += (title.includes(phrase) ? 24 : 0) + (body.includes(phrase) ? 4 : 0)
            + (hits === terms.length ? 10 : 0);
        }
        return total;
      };

      const setActive = (next: number) => {
        const nodes = list.querySelectorAll<HTMLElement>('.search-result');
        if (!nodes.length) return;
        active = Math.max(0, Math.min(nodes.length - 1, next));
        nodes.forEach((node, i) => node.classList.toggle('is-active', i === active));
        nodes[active].scrollIntoView({ block: 'nearest' });
        const heading = nodes[active].querySelector('h2')?.textContent ?? '';
        navStatus.textContent = `第 ${active + 1} 条：${heading}`;
      };

      const element = <K extends keyof HTMLElementTagNameMap>(tag: K, cls = '') => {
        const node = document.createElement(tag);
        node.className = cls;
        return node;
      };
      const addSpan = (parent: HTMLElement, name: string, label: string) => {
        const el = element('span', name);
        el.textContent = label;
        parent.append(el);
      };

      const render = (items: { post: any; terms: string[] }[], querying: boolean) => {
        active = -1;
        navStatus.textContent = '';
        const rows = items.map(({ post, terms }) => {
          const li = element('li', 'search-result');
          li.dataset.searchResultType = post.type;

          const a = element('a', 'search-item');
          a.href = post.href;

          const main = element('div', 'search-item-main');

          const h2 = element('h2');
          h2.append(highlight(post.title, terms));

          const p = element('p');
          p.append(highlight(snippet(post, terms), terms));

          const meta = element('div', 'search-item-meta');
          if (post.type === 'note') addSpan(meta, 'search-type', '笔记');
          const time = element('time');
          time.textContent = post.date;
          meta.append(time);
          if (post.category) addSpan(meta, 'cat', post.category);
          if (post.type !== 'note') addSpan(meta, '', `约 ${post.minutes} 分钟`);
          post.tags.slice(0, 3).forEach((tag: string) => addSpan(meta, 'tag', `#${tag}`));

          main.append(h2, p, meta);

          const arrow = element('span', 'search-arrow');
          arrow.ariaHidden = 'true';
          arrow.textContent = '→';

          a.append(main, arrow);
          li.append(a);
          return li;
        });
        /* Replace results in one DOM write, avoiding per-row live insertions. */
        list.replaceChildren(...rows);

        /* 空查询时只列文章：笔记是碎片，混在「全部内容」里会喧宾夺主 */
        countEl.textContent = querying || selectedType !== 'post'
          ? `找到 ${items.length} 条` : `共 ${items.length} 篇`;
        empty.hidden = !!items.length;
        list.hidden = !items.length;
      };

      /* ---------- 搜索历史（只存本机，最多 6 条） ---------- */
      const HISTORY_KEY = 'search:history';
      const HISTORY_MAX = 6;

      const readHistory = (): string[] => {
        try {
          const raw: unknown = JSON.parse(localStorage.getItem(HISTORY_KEY) ?? '[]');
          return Array.isArray(raw)
            ? raw.filter((item: unknown): item is string => typeof item === 'string').slice(0, HISTORY_MAX)
            : [];
        } catch {
          return [];
        }
      };

      const writeHistory = (next: string[]) => {
        try {
          localStorage.setItem(HISTORY_KEY, JSON.stringify(next.slice(0, HISTORY_MAX)));
        } catch {
          /* 隐私模式写不进去，搜索本身不受影响 */
        }
      };

      const remember = (value: string) => {
        const query = value.trim().replace(/\s+/g, ' ');
        if (query.length < 2) return;
        writeHistory([query, ...readHistory().filter((item) =>
          item.trim().replace(/\s+/g, ' ').toLowerCase() !== query.toLowerCase())]);
      };

      const renderHistory = () => {
        const values = readHistory();
        historyBox.hidden = !values.length || !!input.value.trim();
        if (historyBox.hidden) return;
        historyList.replaceChildren(...values.map((value) => {
          const button = element('button', 'search-history-item');
          button.type = 'button';
          button.textContent = value;
          return button;
        }));
      };
      historyList.addEventListener('click', (event) => {
        const button = (event.target as Element).closest('button');
        if (!button) return;
        input.value = button.textContent || '';
        apply();
        input.focus();
      });
      historyClear.addEventListener('click', () => {
        writeHistory([]);
        renderHistory();
        input.focus();
      });

      /* Another tab may add or clear recent searches while this page stays open. */
      addEventListener('storage', (event) => (!event.key || event.key === HISTORY_KEY) && renderHistory());

      const apply = (syncUrl = true) => {
        if (!ready) return;
        const query = input.value.trim();
        /* Reuse the URL object for filter selection and query synchronization. */
        const url = pageUrl();
        const type = url.searchParams.get('type');
        selectedType = degraded ? 'post' : ['all', 'post', 'note'].includes(type!)
          ? type as SearchType : query ? 'all' : 'post';
        /* 停用词过滤、去重后再取前 6 个；重复词不能挤掉有效搜索词。 */
        const terms = [...new Set(query.toLowerCase().split(/\s+/).filter((word) => !STOP.includes(word)))].slice(0, 6);
        clearBtn!.hidden = !query;

        if (syncUrl) {
          query ? url.searchParams.set('q', query) : url.searchParams.delete('q');
          history.replaceState(null, '', url);
        }

        /* sort() 自 ES2019 起稳定：同分保留 getPosts() 原始时间顺序。 */
        const ranked = terms.length
          ? posts.map((post) => ({ post, score: score(post, terms) }))
              .filter((item) => item.score > 0)
              .sort((a, b) => b.score - a.score)
              .map(({ post }) => ({ post, terms }))
          : query ? [] : posts.map((post) => ({ post, terms: [] }));
        typeButtons.forEach((button) => {
          const type = button.dataset.searchType as SearchType;
          button.disabled = degraded && type !== 'post';
          button.ariaPressed = String(type === selectedType);
        });
        document.getElementById('search-type-filters')!.hidden = false;
        render(ranked.filter(({ post }) => selectedType === 'all' || post.type === selectedType), Boolean(query));
        renderHistory();
      };

      const fallback = () =>
        [...document.querySelectorAll<HTMLAnchorElement>('.search-item')].map((a) => ({
          type: 'post' as const,
          title: a.dataset.title || '',
          description: a.dataset.desc || '',
          tags: JSON.parse(a.dataset.tags || '[]') as string[],
          category: a.dataset.cat || '',
          href: a.href,
          date: a.querySelector('time')?.textContent || '',
          minutes: +(a.dataset.minutes || '0'),
          text: a.dataset.desc || '',
        }));

      const fetchIndex = async () => {
        try {
          const res = await fetch(`${baseUrl}/search-index.json`);
          const data = res.ok && await res.json();
          /* Validate every scorer/render field: downstream code relies on these invariants. */
          if (!Array.isArray(data?.posts) || data.posts.some((p: any) =>
            !['post', 'note'].includes(p.type)
            || !['title', 'description', 'category', 'text', 'date', 'href'].every((key) => typeof p[key] === 'string')
            || !p.title || !p.date || !p.href.startsWith(`${baseUrl}/`)
            || !Number.isFinite(p.minutes) || p.minutes < 0
            || !Array.isArray(p.tags) || p.tags.some((tag: any) => typeof tag !== 'string')
          )) throw new Error('index');
          posts = data.posts;
        } catch {
          /* 索引不可用时仍可以搜索页面已有的文章，但不假装有完整正文与笔记数据。 */
          degraded = true;
          posts = fallback();
          document.getElementById('search-index-warning')!.hidden = false;
          const next = pageUrl();
          next.searchParams.delete('type');
          history.replaceState(null, '', next);
        }
        ready = true;
        /* 索引下载期间可能已输入，但拼音组词中不能提前改写地址栏。 */
        apply(!composing);
      };

      typeButtons.forEach((button) => button.addEventListener('click', () => {
        /* Re-selecting the active type must not create a duplicate Back entry. */
        const type = button.dataset.searchType!;
        if (selectedType === type) return;
        const next = pageUrl();
        next.searchParams.set('type', type);
        history.pushState(null, '', next);
        apply(false);
      }));

      window.addEventListener('popstate', () => {
        input.value = pageUrl().searchParams.get('q') || '';
        apply(false);
      });

      /* 中文/日文输入法选词期间的 Enter、方向键属于输入法，不能打开搜索结果。 */
      input.addEventListener('compositionstart', () => { composing = true; });
      input.addEventListener('compositionend', () => { composing = false; apply(); });
      input.addEventListener('input', () => { if (!composing) apply(); });
      /* 点结果跳转前记一笔，历史里才不会只有回车过的词 */
      list.addEventListener('click', (event) => {
        if ((event.target as Element).closest('.search-item')) remember(input.value);
      });
      input.addEventListener('keydown', (event) => {
        if (composing || event.isComposing || event.keyCode === 229) return;
        if (event.key === 'ArrowDown') {
          event.preventDefault();
          setActive(active + 1);
        } else if (event.key === 'ArrowUp') {
          event.preventDefault();
          setActive(active - 1);
        } else if (event.key === 'Enter') {
          /* 没有用方向键选过时，回车直接打开第一条结果 */
          const nodes = list.querySelectorAll<HTMLAnchorElement>('.search-item');
          const node = nodes[active >= 0 ? active : 0];
          if (node && ready) {
            event.preventDefault();
            remember(input.value);
            location.href = node.href;
          }
        } else if (event.key === 'Escape') {
          if (input.value) {
            input.value = '';
            apply();
          } else {
            input.blur();
          }
        }
      });

      [clearBtn, resetBtn].forEach((button) => button!.addEventListener('click', () => {
        input.value = '';
        apply();
        input.focus();
      }));

      const initial = pageUrl().searchParams.get('q');
      if (initial) input.value = initial;
      fetchIndex();

      /* 桌面端进入即聚焦；移动端不主动弹键盘 */
      if (!initial && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
        input.focus({ preventScroll: true });
      }
    }
  </script>
</BaseLayout>
