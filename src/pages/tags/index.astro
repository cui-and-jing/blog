---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryTiles from '../../components/CategoryTiles.astro';
import { url, tagHue } from '../../lib/site';
import { collectSeries } from '../../lib/series';
import { getPosts } from '../../lib/posts';

const posts = await getPosts();
const counts = new Map<string, number>();
for (const post of posts) {
  for (const tag of post.data.tags) {
    counts.set(tag, (counts.get(tag) ?? 0) + 1);
  }
}
const tags = [...counts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'zh-CN'));
const series = collectSeries(posts);
---

<BaseLayout title="标签" description="全部标签">
  <div class="page-head">
    <div class="shell">
      <h1>标签</h1>
      <p>{tags.length} 个标签，按文章数排序。</p>
    </div>
  </div>

  <div class="shell">
    {
      tags.length === 0 ? (
        <div class="empty-state">
          <p>还没有标签。文章多起来以后，可以从这里横着切。</p>
          <a href={url('/posts/')}>先看全部文章 →</a>
        </div>
      ) : (
        <div class="tag-cloud">
          {tags.map(([tag, count]) => (
            <a href={url(`/tags/${encodeURIComponent(tag)}/`)} style={`--h:${tagHue(tag)}`}>
              {tag}
              <span class="count">{count}</span>
            </a>
          ))}
        </div>
      )
    }
  </div>

  <div class="shell" style="padding-bottom:48px">
    <div class="section-head">
      <h2>按分类看</h2>
      <a href={url('/posts/')}>全部文章 →</a>
    </div>
    <div class="cat-tiles cat-tiles--inline">
      <CategoryTiles posts={posts} />
    </div>

    {
      series.length > 0 && (
        <>
          <div class="section-head" style="margin-top:40px">
            <h2>按系列读</h2>
            <a href={url('/series/')}>全部系列 →</a>
          </div>
          <p class="tag-series-line">
            {series.map((item) => (
              <a href={item.href}>
                {item.title}
                <span>{item.count} 篇</span>
              </a>
            ))}
          </p>
        </>
      )
    }
  </div>
</BaseLayout>
