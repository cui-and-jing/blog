---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryTiles from '../../components/CategoryTiles.astro';
import { url, tagHue } from '../../lib/site';
import { collectSeries } from '../../lib/series';
import { getPosts } from '../../lib/posts';
import { getNotes } from '../../lib/notes';
import { collectTags } from '../../lib/tags';

const [posts, notes] = await Promise.all([getPosts(), getNotes()]);
const tags = collectTags(posts, notes);
const series = collectSeries(posts);
---

<BaseLayout title="标签" description="全部标签，文章与笔记一起统计">
  <div class="page-head">
    <div class="shell">
      <h1>标签</h1>
      <p>{tags.length} 个标签，文章与笔记一起统计。</p>
    </div>
  </div>

  <div class="shell">
    {
      tags.length === 0 ? (
        <div class="empty-state">
          <p>还没有标签。文章多起来以后，可以从这里横着切。</p>
          <a href={url('/posts/')}>先看全部文章 →</a>
        </div>
      ) : (
        <div class="tag-cloud">
          {tags.map(({ tag, total, posts: taggedPosts, notes: taggedNotes }) => (
            <a href={url(`/tags/${encodeURIComponent(tag)}/`)} style={`--h:${tagHue(tag)}`}>
              {tag}
              <span class="count">{total}</span>
              {/* 读屏要知道这个数字是文章加笔记，光念「笔记 6」没有意义；
                  写在元素里而不是 aria-label，可见文字才不会被替换掉 */}
              <span class="sr-only">
                ，{taggedPosts.length} 篇文章、{taggedNotes.length} 条笔记
              </span>
            </a>
          ))}
        </div>
      )
    }
  </div>

  <div class="shell" style="padding-bottom:48px">
    <div class="section-head">
      <h2>按分类看</h2>
      <a href={url('/posts/')}>全部文章 →</a>
    </div>
    <div class="cat-tiles cat-tiles--inline">
      <CategoryTiles posts={posts} />
    </div>
    <p class="tag-note">
      分类只属于文章；笔记比较轻，只有标签。想按时间通读，去<a href={url('/archive/')}>归档</a>。
    </p>

    {
      series.length > 0 && (
        <>
          <div class="section-head" style="margin-top:40px">
            <h2>按系列读</h2>
            <a href={url('/series/')}>全部系列 →</a>
          </div>
          <p class="tag-series-line">
            {series.map((item) => (
              <a href={item.href}>
                {item.title}
                <span>{item.count} 篇</span>
              </a>
            ))}
          </p>
        </>
      )
    }
  </div>
</BaseLayout>
