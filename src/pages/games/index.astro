---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GameCover from '../../components/GameCover.astro';
import { GAMES, url, SITE } from '../../lib/site';

const [featured, ...rest] = GAMES;
---

<BaseLayout title="游戏" description="自己做的小游戏，打开就能玩，不用登录也不用下载。">
  <div class="page-head">
    <div class="shell">
      <h1>游戏</h1>
      <p>自己做的小东西。打开就能玩，不用登录，也不用下载。</p>
    </div>
  </div>

  <div class="shell">
    {/* 旗舰作品保留横向大卡：它有 3D 场景和双人模式，值得占两栏 */}
    <article
      class="game-card"
      style={`--game-a:${featured.accent[0]};--game-b:${featured.accent[1]}`}
    >
      <div class="game-art">
        <GameCover slug={featured.slug} />
        <span class="game-art-badge">{featured.badge}</span>
      </div>

      <div class="game-body">
        <div class="game-kicker">
          {featured.tags.map((tag) => <span class="game-tag">{tag}</span>)}
        </div>
        <h2>
          {featured.title}<span>{featured.subtitle}</span>
        </h2>
        <p>{featured.description}</p>

        <ul class="game-facts">
          {featured.facts.map((fact) => (
            <li>
              <b>{fact.value}</b>
              <span>{fact.label}</span>
            </li>
          ))}
        </ul>

        <div class="game-actions">
          <a class="game-play" href={url(`/games/${featured.slug}/`)}>
            开始游戏
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h13M13 6l6 6-6 6" />
            </svg>
          </a>
          <a class="game-link" href={url(featured.file)} target="_blank" rel="noopener">新窗口打开</a>
        </div>
      </div>
    </article>

    <ul class="game-grid">
      {rest.map((game) => (
        <li
          class="game-card game-card--mini"
          style={`--game-a:${game.accent[0]};--game-b:${game.accent[1]}`}
        >
          <div class="game-art">
            <GameCover slug={game.slug} />
            <span class="game-art-badge">{game.badge}</span>
          </div>

          <div class="game-body">
            <div class="game-kicker">
              {game.tags.map((tag) => <span class="game-tag">{tag}</span>)}
            </div>
            <h2>
              {game.title}<span>{game.subtitle}</span>
            </h2>
            <p>{game.description}</p>

            <ul class="game-facts">
              {game.facts.map((fact) => (
                <li>
                  <b>{fact.value}</b>
                  <span>{fact.label}</span>
                </li>
              ))}
            </ul>

            <div class="game-actions">
              <a class="game-play" href={url(`/games/${game.slug}/`)}>
                开始游戏
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M5 12h13M13 6l6 6-6 6" />
                </svg>
              </a>
              <a class="game-link" href={url(game.file)} target="_blank" rel="noopener">新窗口</a>
            </div>
          </div>
        </li>
      ))}
    </ul>

    <section class="game-notes">
      <div class="game-note">
        <h3>怎么玩</h3>
        <p>
          点「开始游戏」进试玩页，右上角可以全屏，Esc 退出。每个游戏页底部都有它自己的操作提示，
          不用先看说明书，打开就能上手。
        </p>
      </div>

      <div class="game-note">
        <h3>操作</h3>
        <dl class="keys">
          <div><dt><kbd>↑</kbd><kbd>↓</kbd><kbd>←</kbd><kbd>→</kbd></dt><dd>移动 / 转向</dd></div>
          <div><dt><kbd>W</kbd><kbd>A</kbd><kbd>S</kbd><kbd>D</kbd></dt><dd>同上</dd></div>
          <div><dt><kbd>空格</kbd></dt><dd>发球 / 暂停</dd></div>
          <div><dt><kbd>R</kbd></dt><dd>重开</dd></div>
          <div><dt>滑动 / 点按</dt><dd>触屏</dd></div>
        </dl>
      </div>

      <div class="game-note">
        <h3>说明</h3>
        <p>
          全部单文件离线运行，没有 CDN、没有后端、也没有统计脚本。最高分和进度只存在你自己的浏览器里，
          清掉缓存就归零。除了 3D 那款需要 WebGL2，其余都是纯 2D，手机也能跑。
        </p>
      </div>
    </section>

    <p class="game-tail">
      游戏和博客文章分开维护。源码在
      <a href={SITE.github} target="_blank" rel="noopener noreferrer">GitHub</a>
      上，欢迎提问题。
    </p>
  </div>
</BaseLayout>
