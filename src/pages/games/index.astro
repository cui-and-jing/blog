---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GameCover from '../../components/GameCover.astro';
import gamesCssSource from '../../styles/games.css?raw';
import { GAMES, url, SITE } from '../../lib/site';

// Inline only on the game hall; strip source comments to avoid shipping them in HTML.
const gamesCss = gamesCssSource.replace(/\/\*[\s\S]*?\*\//g, '');
const [featured, ...rest] = GAMES;
---

<BaseLayout title="游戏" description="两款离线游戏，以派对竞技和像素动作玩法为主。">
  <style slot="head" is:inline set:html={gamesCss} />
  <div class="page-head">
    <div class="shell">
      <h1>游戏</h1>
      <p>两个游戏，各有自己的玩法。打开就能玩，不用登录，也不用下载。</p>
    </div>
  </div>

  <div class="shell">
    {/* 旗舰 3D 派对游戏保持原样，其他游戏采用横向动作卡片 */}
    <article
      class="game-card"
      style={`--game-a:${featured.accent[0]};--game-b:${featured.accent[1]}`}
    >
      <div class="game-art">
        <GameCover slug={featured.slug} />
        <span class="game-art-badge">{featured.badge}</span>
      </div>

      <div class="game-body">
        <div class="game-kicker">
          {featured.tags.map((tag) => <span class="game-tag">{tag}</span>)}
        </div>
        <h2>
          {featured.title}<span>{featured.subtitle}</span>
        </h2>
        <p>{featured.description}</p>

        <ul class="game-facts">
          {featured.facts.map((fact) => (
            <li>
              <b>{fact.value}</b>
              <span>{fact.label}</span>
            </li>
          ))}
        </ul>

        <div class="game-actions">
          <a class="game-play" href={url(`/games/${featured.slug}/`)}>
            开始游戏
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h13M13 6l6 6-6 6" />
            </svg>
          </a>
          <a class="game-link" href={url(featured.file)} target="_blank" rel="noopener">新窗口打开</a>
        </div>
      </div>
    </article>

    <ul class="game-grid" aria-label="动作游戏">
      {rest.map((game) => (
        <li
          class="game-card game-card--mini"
          style={`--game-a:${game.accent[0]};--game-b:${game.accent[1]}`}
        >
          <div class="game-art">
            <GameCover slug={game.slug} />
            <span class="game-art-badge">{game.badge}</span>
          </div>

          <div class="game-body">
            <div class="game-kicker">
              {game.tags.map((tag) => <span class="game-tag">{tag}</span>)}
            </div>
            <h2>
              {game.title}<span>{game.subtitle}</span>
            </h2>
            <p>{game.description}</p>

            <ul class="game-facts">
              {game.facts.map((fact) => (
                <li>
                  <b>{fact.value}</b>
                  <span>{fact.label}</span>
                </li>
              ))}
            </ul>

            <div class="game-actions">
              <a class="game-play" href={url(`/games/${game.slug}/`)}>
                开始游戏
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M5 12h13M13 6l6 6-6 6" />
                </svg>
              </a>
              <a class="game-link" href={url(game.file)} target="_blank" rel="noopener">新窗口</a>
            </div>
          </div>
        </li>
      ))}
    </ul>

    <section class="game-notes">
      <div class="game-note">
        <h3>怎么玩</h3>
        <p>
          点「开始游戏」进入试玩页，右上角可以全屏。两款玩法不同，按各自提示操作。
        </p>
      </div>

      <div class="game-note">
        <h3>像素突围</h3>
        <dl class="keys">
          <div><dt><kbd>A</kbd><kbd>D</kbd></dt><dd>移动</dd></div>
          <div><dt><kbd>W</kbd><kbd>空格</kbd></dt><dd>跳跃</dd></div>
          <div><dt><kbd>J</kbd></dt><dd>连续出击</dd></div>
          <div><dt><kbd>K</kbd></dt><dd>手雷</dd></div>
          <div><dt><kbd>P</kbd></dt><dd>暂停</dd></div>
        </dl>
      </div>

      <div class="game-note">
        <h3>说明</h3>
        <p>
          糖河奇遇可选择关卡，与 AI 一起完成挑战。像素突围支持键盘和触屏操作。
          两款游戏都不需要账号，单文件运行，没有 CDN、后端或统计脚本；最高分存在自己的浏览器里。
        </p>
      </div>
    </section>

    <p class="game-tail">
      游戏和博客文章分开维护。源码在
      <a href={SITE.github} target="_blank" rel="noopener noreferrer">GitHub</a>
      上，欢迎提问题。
    </p>
  </div>
</BaseLayout>
