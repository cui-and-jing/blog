---
import type { CollectionEntry } from 'astro:content';
import Cover from './Cover.astro';
import { url, formatDate, readingTime, tagHue } from '../lib/site';

interface Props {
  post: CollectionEntry<'posts'>;
  /** 列表页若没有 h2 分区，卡片标题直接用 h2，避免 h1 直接跳到 h3 */
  headingLevel?: 'h2' | 'h3';
}

const { post, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
const minutes = readingTime(post.body ?? '');
---

<li class="card" data-category={post.data.category ?? ''} data-author={post.data.author}>
  <a class="card-hit" href={url(`/posts/${post.id}/`)} aria-label={post.data.title}></a>
  <Cover seed={post.id} title={post.data.title} image={post.data.cover} />
  <div class="card-body">
    <div class="card-meta">
      {post.data.draft && <span class="draft-pill">草稿</span>}
      {post.data.category && <a class="cat" href={url(`/category/${encodeURIComponent(post.data.category)}/`)}>{post.data.category}</a>}
      <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
      <span>· 约 {minutes} 分钟</span>
    </div>
    <Heading>{post.data.title}</Heading>
    {post.data.description && <p>{post.data.description}</p>}
    {
      post.data.tags.length > 0 && (
        <div class="card-tags">
          {post.data.tags.slice(0, 3).map((tag: string) => (
            <span class="tag-pill" style={`--h:${tagHue(tag)}`}>#{tag}</span>
          ))}
        </div>
      )
    }
  </div>
</li>
