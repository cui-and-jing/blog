---
import type { CollectionEntry } from 'astro:content';
import Cover from './Cover.astro';
import { url, formatDate } from '../lib/site';
import { sortByOrder } from '../lib/series';

interface Props {
  current: CollectionEntry<'posts'>;
  posts: CollectionEntry<'posts'>[];
}

const { current, posts } = Astro.props;

/*
 * "接着读"先跟随系列目录的阅读顺序，而不是按发布日期倒排：
 * 从当前篇往后读；读到末尾时再从最近的前文倒序补齐。
 * 空余位置才按分类、共同标签和发布时间推荐其他文章。
 */
const seriesPosts = current.data.series
  ? sortByOrder(posts.filter((post) => post.data.series === current.data.series))
  : [];
const currentPosition = seriesPosts.findIndex((post) => post.id === current.id);
const seriesNext = currentPosition < 0 ? [] : [
  ...seriesPosts.slice(currentPosition + 1),
  ...seriesPosts.slice(0, currentPosition).reverse(),
];
const excluded = new Set([current.id, ...seriesNext.map((post) => post.id)]);

const scored = posts
  .filter((post) => !excluded.has(post.id))
  .map((post) => {
    let score = 0;
    const reasons: string[] = [];

    if (post.data.category && post.data.category === current.data.category) score += 3;

    const shared = post.data.tags.filter((tag) => current.data.tags.includes(tag));
    if (shared.length) {
      score += shared.length * 2;
      reasons.push(shared.slice(0, 2).map((tag) => `#${tag}`).join(' '));
    }

    return { post, score, reason: reasons[0] ?? '' };
  })
  .sort((a, b) => b.score - a.score || b.post.data.date.valueOf() - a.post.data.date.valueOf());

const related = [
  ...seriesNext.map((post) => ({ post, reason: '同一系列' })),
  ...scored,
].slice(0, 3);
---

{
  related.length > 0 && (
    <section class="related" aria-labelledby="related-title">
      <div class="related-head">
        <h2 id="related-title">接着读</h2>
        <a href={url('/posts/')}>全部文章 →</a>
      </div>
      <ul class="related-grid" style={`--cols:${Math.min(related.length, 3)}`}>
        {related.map(({ post, reason }) => (
          <li class="related-card">
            <a class="related-hit" href={url(`/posts/${post.id}/`)} aria-label={post.data.title}></a>
            <Cover
              seed={post.id}
              title={post.data.title}
              image={post.data.cover}
              class="related-cover"
            />
            <div class="related-body">
              <div class="related-meta">
                {post.data.category && <span>{post.data.category}</span>}
                {reason && <span class="related-why">{reason}</span>}
                <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
              </div>
              <h3>{post.data.title}</h3>
            </div>
          </li>
        ))}
      </ul>
    </section>
  )
}
