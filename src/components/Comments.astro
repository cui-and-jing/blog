---
import { COMMENTS, commentsThreadUrl } from '../lib/comments';

interface Props {
  /** 区块标题，默认「评论」 */
  title?: string;
  /** 标题下的一句说明 */
  hint?: string;
}

const {
  title = '评论',
  hint = '用 GitHub 账号登录后留言，评论会同步到仓库的 Discussions；有人回复时 GitHub 会通知你。',
} = Astro.props;
---

{
  COMMENTS.enabled ? (
    <section
      class="comments"
      id="comments"
      aria-labelledby="comments-title"
      data-comments
      data-state="idle"
      data-repo={COMMENTS.repo}
      data-repo-id={COMMENTS.repoId}
      data-category={COMMENTS.category}
      data-category-id={COMMENTS.categoryId}
      data-mapping={COMMENTS.mapping}
      data-lang={COMMENTS.lang}
    >
      <header class="comments-head">
        <div class="comments-heading">
          <span class="comments-kicker">DISCUSSION</span>
          <h2 id="comments-title">
            {title}
            <span class="comments-count" data-comment-count hidden></span>
          </h2>
        </div>
        <a class="comments-link" href={commentsThreadUrl} target="_blank" rel="noopener noreferrer">
          GitHub 讨论区
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M7 17 17 7M8 7h9v9"></path>
          </svg>
        </a>
      </header>

      <p class="comments-hint">{hint}</p>

      <div class="comments-body">
        <div class="comments-skeleton" aria-hidden="true">
          <span class="sk-line"></span>
          <span class="sk-line"></span>
          <span class="sk-line"></span>
        </div>
        <p class="comments-status" data-comments-status role="status">正在准备评论区…</p>

        <div class="giscus"></div>

        <div class="comments-fallback" hidden>
          <p>评论没能加载出来，多半是网络把它挡了一下。</p>
          <div class="comments-fallback-actions">
            <button class="btn" type="button" data-comments-retry>重试</button>
            <a class="btn" href={commentsThreadUrl} target="_blank" rel="noopener noreferrer">去 GitHub 留言</a>
          </div>
        </div>

        <noscript>
          <style>
            .comments-skeleton,
            .comments-status {
              display: none;
            }
          </style>
          <p class="comments-hint">
            评论区需要 JavaScript。也可以直接去 <a href={commentsThreadUrl}>GitHub 讨论区</a> 留言。
          </p>
        </noscript>
      </div>
    </section>
  ) : (
    import.meta.env.DEV && (
      <section class="comments comments--muted" aria-label="评论（未启用）">
        <header class="comments-head">
          <div class="comments-heading">
            <span class="comments-kicker">DISCUSSION</span>
            <h2>评论</h2>
          </div>
          <span class="comments-badge">未接通</span>
        </header>
        <p class="comments-hint">
          评论区还没拿到 Giscus 的 repo / category ID。在仓库开启 Discussions 并安装 giscus App
          后，运行 <code>npm run comments:setup</code> 自动写入配置。
        </p>
      </section>
    )
  )
}

<script>
  const section = document.querySelector<HTMLElement>('[data-comments]');

  if (section) {
    const host = section.querySelector<HTMLElement>('.giscus');
    const status = section.querySelector<HTMLElement>('[data-comments-status]');
    const fallback = section.querySelector<HTMLElement>('.comments-fallback');
    const countNode = section.querySelector<HTMLElement>('[data-comment-count]');
    const retry = section.querySelector<HTMLButtonElement>('[data-comments-retry]');
    const root = document.documentElement;

    const currentTheme = () => (root.dataset.theme === 'dark' ? 'transparent_dark' : 'light');

    let frame: HTMLIFrameElement | null = null;
    let timer = 0;
    /* giscus 自己报错（没装 App、限流、配置不对）之后就不再翻盘 */
    let broken = false;

    /* giscus 会给 iframe 加 loading 类做淡入，这个类交给它自己摘；
       我们只负责在真的出内容时把本站的骨架屏撤掉 */
    const markReady = () => {
      if (broken) return;
      if (section.dataset.state !== 'ready') {
        section.dataset.state = 'ready';
        fallback?.setAttribute('hidden', '');
        window.clearTimeout(timer);
      }
    };

    const fail = () => {
      section.dataset.state = 'error';
      fallback?.removeAttribute('hidden');
      window.clearTimeout(timer);
    };

    /* client.js 动态插入 iframe：等到它摘掉 loading 类就算画出来了 */
    const adopt = (next: HTMLIFrameElement | null) => {
      if (!next || next === frame) return;
      frame = next;
      const check = () => {
        if (!next.classList.contains('giscus-frame--loading')) markReady();
      };
      next.addEventListener('load', check);
      new MutationObserver(check).observe(next, { attributes: true, attributeFilter: ['class'] });
      check();
    };

    const mount = () => {
      if (!host) return;
      window.clearTimeout(timer);
      broken = false;
      section.dataset.state = 'loading';
      fallback?.setAttribute('hidden', '');
      if (status) status.textContent = '正在准备评论区…';
      host.replaceChildren();
      frame = null;

      const script = document.createElement('script');
      script.src = 'https://giscus.app/client.js';
      script.async = true;
      script.crossOrigin = 'anonymous';
      script.setAttribute('data-repo', section.dataset.repo ?? '');
      script.setAttribute('data-repo-id', section.dataset.repoId ?? '');
      script.setAttribute('data-category', section.dataset.category ?? '');
      script.setAttribute('data-category-id', section.dataset.categoryId ?? '');
      script.setAttribute('data-mapping', section.dataset.mapping ?? 'pathname');
      script.setAttribute('data-strict', '1');
      /* 还没有评论时，表情区会占一整行显示「0 个表情」，先关掉；有互动了再开 */
      script.setAttribute('data-reactions-enabled', '0');
      script.setAttribute('data-emit-metadata', '1');
      script.setAttribute('data-input-position', 'top');
      script.setAttribute('data-theme', currentTheme());
      script.setAttribute('data-lang', section.dataset.lang ?? 'zh-CN');
      script.addEventListener('error', () => {
        broken = true;
        fail();
      });
      host.append(script);

      /* 这个网络下 giscus 要 10s 上下才画出来，骨架屏先撑着；
         真等太久（iframe 已插入但一直没报尺寸）才放行，顺便给个够看的高度 */
      timer = window.setTimeout(() => {
        if (section.dataset.state === 'ready') return;
        if (!frame) {
          fail();
          return;
        }
        if (!frame.style.height || parseFloat(frame.style.height) < 200) {
          frame.style.height = '320px';
        }
        markReady();
      }, 16000);
    };

    new MutationObserver(() =>
      adopt(host?.querySelector<HTMLIFrameElement>('iframe.giscus-frame') ?? null)
    ).observe(host ?? section, { childList: true, subtree: true });

    /* 站点切深浅色后，同步 iframe 里的配色 */
    new MutationObserver(() => {
      frame?.contentWindow?.postMessage(
        { giscus: { setConfig: { theme: currentTheme() } } },
        'https://giscus.app'
      );
    }).observe(root, { attributes: true, attributeFilter: ['data-theme'] });

    window.addEventListener('message', (event) => {
      if (event.origin !== 'https://giscus.app') return;
      const payload = (event.data as { giscus?: Record<string, any> })?.giscus;
      if (!payload) return;

      /* 只要上报了尺寸就说明 iframe 画出来了。
         新文章没有对应讨论时 giscus 只给一个「登录后评论」的矮框（约 84px），
         这是正常状态，不能当成加载失败 */
      if (typeof payload.resizeHeight === 'number' && payload.resizeHeight > 0) {
        if (frame) frame.style.height = `${payload.resizeHeight}px`;
        markReady();
      }

      /* 新文章还没有讨论时也会报 Discussion not found，这是正常的 */
      if (payload.error && !/Discussion not found/i.test(String(payload.error))) {
        broken = true;
        fail();
      }

      const raw = payload.totalCommentCount ?? payload.discussion?.totalCommentCount;
      const count = typeof raw === 'number' ? raw : Number(raw);
      if (!countNode || !Number.isFinite(count)) return;
      countNode.textContent = `${count} 条`;
      countNode.hidden = count <= 0;
    });

    retry?.addEventListener('click', mount);

    /* 滚到附近才加载，文章一打开不必先去拉 GitHub */
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries, observer) => {
          if (!entries.some((entry) => entry.isIntersecting)) return;
          observer.disconnect();
          mount();
        },
        { rootMargin: '1400px 0px' }
      );
      io.observe(section);
      if (location.hash === '#comments') {
        io.disconnect();
        mount();
      }
    } else {
      mount();
    }
  }
</script>
