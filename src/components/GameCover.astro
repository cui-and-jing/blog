---
/**
 * 游戏封面插画。
 * 纯装饰：可访问名由外层链接提供，所以这里一律 aria-hidden，
 * 避免读屏把同一款游戏的名字念两遍。
 */
interface Props {
  slug: string;
}

const { slug } = Astro.props;
---

{
  slug === 'beanrush' && (
    <svg viewBox="0 0 720 460" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <defs>
        <linearGradient id="ga-sky" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#ff5f9e" />
          <stop offset="0.55" stop-color="#ff7f92" />
          <stop offset="1" stop-color="#ffa878" />
        </linearGradient>
        <linearGradient id="ga-bean" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#fffdf7" />
          <stop offset="1" stop-color="#ffe8d6" />
        </linearGradient>
        <radialGradient id="ga-sun" cx="0.5" cy="0.5" r="0.5">
          <stop offset="0" stop-color="#ffe98f" stop-opacity="0.95" />
          <stop offset="1" stop-color="#ffde5a" stop-opacity="0.1" />
        </radialGradient>
      </defs>

      <rect width="720" height="460" fill="url(#ga-sky)" />
      <circle cx="566" cy="96" r="96" fill="url(#ga-sun)" />
      <circle cx="566" cy="96" r="42" fill="#ffe98f" opacity="0.9" />

      <path d="M0 322c118-30 214 30 336 2s252-34 384 6v130H0Z" fill="#ffffff" opacity="0.16" />
      <path d="M0 366c126-28 226 34 372 6s236-26 348 10v78H0Z" fill="#203653" opacity="0.14" />
      <path d="M0 402c140-22 240 26 386 4s222-18 334 8v46H0Z" fill="#203653" opacity="0.18" />

      <g opacity="0.5" fill="#fff7ef">
        <rect x="96" y="126" width="34" height="44" rx="17" transform="rotate(-18 113 148)" />
        <rect x="612" y="238" width="28" height="36" rx="14" transform="rotate(16 626 256)" />
        <rect x="486" y="300" width="22" height="28" rx="11" transform="rotate(-10 497 314)" />
      </g>

      <g fill="#fff7ef" opacity="0.75">
        <path d="M150 226l6 16 16 6-16 6-6 16-6-16-16-6 16-6Z" />
        <path d="M636 150l4 11 11 4-11 4-4 11-4-11-11-4 11-4Z" />
      </g>

      <ellipse cx="356" cy="380" rx="92" ry="18" fill="#203653" opacity="0.18" />

      <g transform="rotate(-11 356 300)">
        <rect x="262" y="196" width="188" height="196" rx="94" fill="url(#ga-bean)" />
        <ellipse cx="356" cy="330" rx="58" ry="48" fill="#ffd0e0" opacity="0.85" />
        <rect x="322" y="268" width="9" height="26" rx="4.5" fill="#203653" />
        <rect x="381" y="268" width="9" height="26" rx="4.5" fill="#203653" />
        <path d="M344 316q12 12 24 0" stroke="#203653" stroke-width="5" stroke-linecap="round" fill="none" />
        <rect x="236" y="286" width="40" height="18" rx="9" fill="#fffdf7" transform="rotate(-16 256 295)" />
        <rect x="440" y="272" width="40" height="18" rx="9" fill="#fffdf7" transform="rotate(14 460 281)" />
      </g>
    </svg>
  )
}


{
  slug === 'pixelraid' && (
    <svg viewBox="0 0 720 460" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <defs>
        <linearGradient id="pr-sky" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#14283e" />
          <stop offset="0.6" stop-color="#284b60" />
          <stop offset="1" stop-color="#b6655c" />
        </linearGradient>
        <linearGradient id="pr-ground" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#4e807c" />
          <stop offset="1" stop-color="#233546" />
        </linearGradient>
      </defs>
      <rect width="720" height="460" fill="url(#pr-sky)" />
      <circle cx="540" cy="105" r="65" fill="#f9c981" opacity="0.9" />
      <path d="M0 292 80 195 160 286 267 166 374 297 504 213 610 299 720 194v266H0Z" fill="#294157" />
      <path d="M0 333 77 278 166 322 270 246 393 332 490 255 590 334 720 257v203H0Z" fill="#213749" />
      <g fill="#182a3b">
        <rect x="440" y="166" width="152" height="192" />
        <rect x="422" y="191" width="184" height="23" />
        <rect x="463" y="126" width="34" height="42" />
        <rect x="551" y="132" width="25" height="38" />
        <rect x="521" y="257" width="55" height="96" />
      </g>
      <g fill="#d9a577" opacity="0.9">
        <rect x="481" y="214" width="18" height="29" />
        <rect x="535" y="190" width="25" height="24" />
        <rect x="548" y="287" width="17" height="34" />
      </g>
      <rect y="357" width="720" height="103" fill="url(#pr-ground)" />
      <rect y="356" width="720" height="9" fill="#88a6a1" />
      <g fill="#1d3444">
        <rect x="41" y="320" width="122" height="18" />
        <rect x="58" y="338" width="12" height="20" />
        <rect x="139" y="338" width="12" height="20" />
      </g>
      <g transform="translate(233 208)">
        <rect x="31" y="0" width="68" height="24" rx="5" fill="#e2ba73" />
        <rect x="40" y="18" width="52" height="56" rx="7" fill="#e4be9c" />
        <rect x="32" y="73" width="70" height="81" rx="9" fill="#58b49f" />
        <rect x="34" y="152" width="25" height="63" fill="#263a4c" />
        <rect x="75" y="152" width="25" height="63" fill="#263a4c" />
        <rect x="29" y="207" width="41" height="14" rx="4" fill="#142738" />
        <rect x="66" y="207" width="41" height="14" rx="4" fill="#142738" />
        <rect x="94" y="88" width="86" height="20" rx="5" fill="#283b4c" />
        <rect x="164" y="83" width="66" height="13" rx="2" fill="#c1d1d5" />
        <rect x="123" y="103" width="20" height="27" rx="4" fill="#dba889" />
        <rect x="66" y="46" width="18" height="10" fill="#263a4c" />
      </g>
      <g fill="#f8c68c">
        <path d="M455 311l18-8-9 18 9 18-18-8-18 8 9-18-9-18Z" />
        <path d="M517 280l10-5-5 10 5 10-10-5-10 5 5-10-5-10Z" opacity="0.8" />
      </g>
      <g transform="translate(579 234)">
        <rect x="10" y="0" width="62" height="48" fill="#738099" />
        <rect x="22" y="18" width="38" height="31" fill="#bc6870" />
        <rect x="28" y="25" width="26" height="19" fill="#f0b27d" />
        <rect x="2" y="49" width="79" height="69" fill="#32445b" />
        <rect x="-8" y="116" width="36" height="13" fill="#1b2e40" />
        <rect x="56" y="116" width="36" height="13" fill="#1b2e40" />
      </g>
      <g fill="#e8f4f5" opacity="0.82">
        <rect x="86" y="107" width="5" height="5" />
        <rect x="174" y="78" width="4" height="4" />
        <rect x="392" y="87" width="5" height="5" />
      </g>
    </svg>
  )
}
