---
import '../styles/global.css';
import { SITE, NAV, url } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { title, description = SITE.description, image } = Astro.props;
const pageTitle = title ? `${title} · ${SITE.title}` : `${SITE.title} · ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.github).toString();
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<!doctype html>
<html lang={SITE.lang} data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href={url('/rss.xml')} />
    <meta name="theme-color" content="#f2f0e9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#131311" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:locale" content="zh_CN" />
    {image && <meta property="og:image" content={new URL(image, canonical).toString()} />}
    <meta name="twitter:card" content="summary" />

    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.dataset.theme = stored || (prefersDark ? 'dark' : 'light');
        } catch (e) {}
      })();
    </script>
  </head>

  <body>
    <header class="site-header" id="site-header">
      <div class="shell header-inner">
        <a class="wordmark" href={url('/')}>
          <span class="mark"></span>
          <span>{SITE.title}</span>
        </a>

        <nav class="nav" aria-label="主导航">
          {
            NAV.map((item) => {
              const target = url(item.href).replace(/\/$/, '');
              const isActive = current === target || (target !== url('/').replace(/\/$/, '') && current.startsWith(target));
              return (
                <a href={url(item.href)} aria-current={isActive ? 'page' : undefined}>
                  {item.label}
                </a>
              );
            })
          }
          <button class="theme-toggle" id="theme-toggle" type="button" aria-label="切换深浅色">
            <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
              <circle cx="12" cy="12" r="4.2"></circle>
              <path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.2 5.2l1.6 1.6M17.2 17.2l1.6 1.6M18.8 5.2l-1.6 1.6M6.8 17.2l-1.6 1.6"></path>
            </svg>
            <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
              <path d="M20.5 14.3A8.5 8.5 0 1 1 9.7 3.5a6.8 6.8 0 0 0 10.8 10.8Z"></path>
            </svg>
          </button>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="shell footer-grid">
        <div class="footer-brand">
          <span class="footer-mark"><span class="mark"></span>{SITE.title}</span>
          <p>{SITE.description}</p>
        </div>
        <nav class="footer-col" aria-label="页脚导航">
          <h5>导航</h5>
          {NAV.map((item) => <a href={url(item.href)}>{item.label}</a>)}
        </nav>
        <div class="footer-col">
          <h5>订阅与源码</h5>
          <a href={url('/rss.xml')}>RSS 订阅</a>
          <a href={SITE.github} target="_blank" rel="noopener noreferrer">GitHub</a>
          <a href={url('/about/')}>关于本站</a>
        </div>
      </div>
      <div class="shell footer-bottom">
        <span>© {SITE.since === new Date().getFullYear() ? SITE.since : `${SITE.since}–${new Date().getFullYear()}`} {SITE.author} · 文字采用 CC BY-NC-SA 4.0</span>
        <span class="footer-links">
          <span>Powered by Astro</span>
          <a href={SITE.github} target="_blank" rel="noopener noreferrer">GitHub Pages</a>
        </span>
      </div>
    </footer>

    <script>
      const toggle = document.getElementById('theme-toggle');
      toggle?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch (e) {}
      });

      const header = document.getElementById('site-header');
      const onScroll = () => header?.setAttribute('data-scrolled', String(window.scrollY > 8));
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
    </script>
  </body>
</html>
