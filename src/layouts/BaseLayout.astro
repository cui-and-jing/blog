---
import '../styles/global.css';
import { SITE, NAV, url, mediaUrl } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: {
    published: Date;
    updated?: Date;
    tags: string[];
    category?: string;
    minutes?: number;
  };
}

const { title, description = SITE.description, image, article } = Astro.props;
const pageTitle = title ? `${title} · ${SITE.title}` : `${SITE.title} · ${SITE.tagline}`;
const siteRoot = (Astro.site ?? new URL(SITE.github)).toString().replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.github).toString();
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const ogImage = image ? new URL(mediaUrl(image), siteRoot).toString() : `${siteRoot}${url('/og.png')}`;

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.title,
  description: SITE.description,
  url: `${siteRoot}${url('/')}`,
  inLanguage: SITE.lang,
  potentialAction: {
    '@type': 'SearchAction',
    target: `${siteRoot}${url('/search/')}?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};

const articleSchema = article
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: title,
      description,
      url: canonical,
      mainEntityOfPage: canonical,
      datePublished: article.published.toISOString(),
      dateModified: (article.updated ?? article.published).toISOString(),
      inLanguage: SITE.lang,
      image: ogImage,
      author: { '@type': 'Person', name: SITE.author, url: SITE.github },
      publisher: { '@type': 'Organization', name: SITE.title },
      ...(article.category ? { articleSection: article.category } : {}),
      ...(article.tags.length ? { keywords: article.tags.join(', ') } : {}),
      ...(article.minutes ? { timeRequired: `PT${article.minutes}M` } : {}),
    }
  : null;

const breadcrumbSchema = article
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: '首页', item: `${siteRoot}${url('/')}` },
        { '@type': 'ListItem', position: 2, name: '文章', item: `${siteRoot}${url('/posts/')}` },
        { '@type': 'ListItem', position: 3, name: title, item: canonical },
      ],
    }
  : null;

const schema = [websiteSchema, articleSchema, breadcrumbSchema].filter(Boolean);
---

<!doctype html>
<html lang={SITE.lang} data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href={url('/rss.xml')} />
    <meta name="theme-color" content="#f2f0e9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#131311" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={pageTitle} />
    {article && <meta property="article:published_time" content={article.published.toISOString()} />}
    {article?.updated && <meta property="article:modified_time" content={article.updated.toISOString()} />}
    {article?.tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />

    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.dataset.theme = stored || (prefersDark ? 'dark' : 'light');
          if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            document.documentElement.dataset.motion = 'on';
          }
        } catch (e) {}
      })();
    </script>
  </head>

  <body data-search-url={url('/search/')}>
    <a class="skip-link" href="#main">跳到正文</a>
    <div class="read-progress" id="read-progress" aria-hidden="true"><span></span></div>

    <header class="site-header" id="site-header">
      <div class="shell header-inner">
        <a class="wordmark" href={url('/')}>
          <span class="mark"></span>
          <span>{SITE.title}</span>
        </a>

        <nav class="nav" aria-label="主导航">
          {
            NAV.map((item) => {
              const target = url(item.href).replace(/\/$/, '');
              const isActive = current === target || (target !== url('/').replace(/\/$/, '') && current.startsWith(target));
              return (
                <a href={url(item.href)} aria-current={isActive ? 'page' : undefined}>
                  {item.label}
                </a>
              );
            })
          }
          <a class="nav-icon search-link" href={url('/search/')} aria-label="搜索文章" title="搜索（Ctrl / ⌘ + K）">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
              <circle cx="11" cy="11" r="6.4"></circle>
              <path d="m16 16 4.2 4.2"></path>
            </svg>
          </a>
          <button class="theme-toggle" id="theme-toggle" type="button" aria-label="切换深浅色">
            <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
              <circle cx="12" cy="12" r="4.2"></circle>
              <path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.2 5.2l1.6 1.6M17.2 17.2l1.6 1.6M18.8 5.2l-1.6 1.6M6.8 17.2l-1.6 1.6"></path>
            </svg>
            <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
              <path d="M20.5 14.3A8.5 8.5 0 1 1 9.7 3.5a6.8 6.8 0 0 0 10.8 10.8Z"></path>
            </svg>
          </button>
        </nav>
      </div>
    </header>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="shell footer-grid">
        <div class="footer-brand">
          <span class="footer-mark"><span class="mark"></span>{SITE.title}</span>
          <p>{SITE.description}</p>
        </div>
        <nav class="footer-col" aria-label="页脚导航">
          <h5>导航</h5>
          {NAV.map((item) => <a href={url(item.href)}>{item.label}</a>)}
        </nav>
        <div class="footer-col">
          <h5>订阅与源码</h5>
          <a href={url('/rss.xml')}>RSS 订阅</a>
          <a href={SITE.github} target="_blank" rel="noopener noreferrer">GitHub</a>
          <a href={url('/about/')}>关于本站</a>
        </div>
      </div>
      <div class="shell footer-bottom">
        <span>© {SITE.since === new Date().getFullYear() ? SITE.since : `${SITE.since}–${new Date().getFullYear()}`} {SITE.author} · 文字采用 CC BY-NC-SA 4.0</span>
        <span class="footer-links">
          <span>Powered by Astro</span>
          <a href={SITE.github} target="_blank" rel="noopener noreferrer">GitHub Pages</a>
        </span>
      </div>
    </footer>

    <button class="to-top" id="to-top" type="button" aria-label="回到顶部">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 19V5M6 11l6-6 6 6"></path>
      </svg>
    </button>

    <script>
      const root = document.documentElement;
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

      /* 搜索：⌘/Ctrl+K 或 / 直接聚焦，其他页面跳到搜索页 */
      const searchUrl = document.body.dataset.searchUrl || '/search/';
      const searchField = () => document.getElementById('search-input') as HTMLInputElement | null;
      const isTyping = (target: EventTarget | null) => {
        const el = target as HTMLElement | null;
        if (!el || !el.tagName) return false;
        return (
          el.tagName === 'INPUT' ||
          el.tagName === 'TEXTAREA' ||
          el.tagName === 'SELECT' ||
          el.isContentEditable
        );
      };

      document.addEventListener('keydown', (event) => {
        const mod = event.metaKey || event.ctrlKey;
        if (mod && event.key.toLowerCase() === 'k') {
          event.preventDefault();
          const field = searchField();
          if (field) {
            field.focus();
            field.select();
          } else {
            location.href = searchUrl;
          }
          return;
        }

        if (event.key === '/' && !mod && !event.altKey && !isTyping(event.target)) {
          const field = searchField();
          if (field) {
            event.preventDefault();
            field.focus();
            field.select();
          } else {
            event.preventDefault();
            location.href = searchUrl;
          }
        }
      });

      /* 主题切换：支持 View Transition 时用圆形扩散过渡 */
      const toggle = document.getElementById('theme-toggle');
      const applyTheme = (next: string) => {
        root.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch (e) {}
      };

      toggle?.addEventListener('click', (event) => {
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        const startViewTransition = (document as any).startViewTransition as
          | ((cb: () => void) => { ready: Promise<void> })
          | undefined;

        if (reduceMotion.matches || !startViewTransition) {
          applyTheme(next);
          return;
        }

        const x = (event as MouseEvent).clientX || window.innerWidth / 2;
        const y = (event as MouseEvent).clientY || 40;
        const radius = Math.hypot(Math.max(x, window.innerWidth - x), Math.max(y, window.innerHeight - y));

        const transition = startViewTransition.call(document, () => applyTheme(next));
        transition.ready
          .then(() => {
            root.animate(
              { clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${radius}px at ${x}px ${y}px)`] },
              { duration: 540, easing: 'ease-in-out', pseudoElement: '::view-transition-new(root)' }
            );
          })
          .catch(() => {});
      });

      /* 滚动状态 */
      const header = document.getElementById('site-header');
      const toTop = document.getElementById('to-top');
      const progress = document.getElementById('read-progress');
      const progressFill = progress?.firstElementChild as HTMLElement | null;
      const hasArticle = Boolean(document.querySelector('.article-card'));

      const onScroll = () => {
        const y = window.scrollY;
        header?.setAttribute('data-scrolled', String(y > 8));
        toTop?.classList.toggle('show', y > 700);

        if (progressFill) {
          const max = document.documentElement.scrollHeight - window.innerHeight;
          const ratio = max > 0 ? Math.min(1, Math.max(0, y / max)) : 0;
          progressFill.style.transform = `scaleX(${ratio})`;
        }
      };

      if (progress && hasArticle) progress.classList.add('active');
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll);

      toTop?.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: reduceMotion.matches ? 'auto' : 'smooth' });
      });

      /* 滚动入场：按同组顺序错峰，元素只在 JS 就绪后隐藏 */
      if (root.dataset.motion === 'on' && 'IntersectionObserver' in window) {
        const nodes: HTMLElement[] = [];
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-in');
              observer.unobserve(entry.target);
            });
          },
          { rootMargin: '0px 0px -6% 0px', threshold: 0.06 }
        );

        try {
          const selector = [
            '.hero-copy > *',
            '.hero-card',
            '.section-head',
            '.featured',
            '.card',
            '.cat-tile',
            '.widget',
            '.page-head .shell > *',
            '.post-hero',
            '.article-card',
            '.comments',
            '.archive-year',
            '.tag-cloud li',
            '.game-card',
            '.game-note',
          ].join(',');

          document.querySelectorAll<HTMLElement>(selector).forEach((el) => {
            nodes.push(el);
            el.setAttribute('data-reveal', '');
            const parent = el.parentElement;
            if (!parent) return;
            const siblings = Array.from(parent.children).filter((child) => child.hasAttribute('data-reveal'));
            const index = siblings.indexOf(el);
            if (index > 0) el.style.setProperty('--d', `${Math.min(index, 6) * 55}ms`);
          });

          nodes.forEach((el) => observer.observe(el));
          root.dataset.motionReady = 'on';
        } catch {
          nodes.forEach((el) => {
            el.removeAttribute('data-reveal');
            el.classList.add('is-in');
          });
        }
      }
    </script>
  </body>
</html>
