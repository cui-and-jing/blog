---
import '../styles/global.css';
import Analytics from '../components/Analytics.astro';
import { SITE, NAV, url, mediaUrl } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** 给排版样例这类只给自己看的页面用，不进搜索引擎 */
  noindex?: boolean;
  article?: {
    published: Date;
    updated?: Date;
    tags: string[];
    category?: string;
    minutes?: number;
  };
}

const { title, description = SITE.description, image, noindex = false, article } = Astro.props;
const pageTitle = title ? `${title} · ${SITE.title}` : `${SITE.title} · ${SITE.tagline}`;
const siteRoot = (Astro.site ?? new URL(SITE.github)).toString().replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.github).toString();
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const ogImage = image ? new URL(mediaUrl(image), siteRoot).toString() : `${siteRoot}${url('/og.png')}`;

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.title,
  description: SITE.description,
  url: `${siteRoot}${url('/')}`,
  inLanguage: SITE.lang,
  potentialAction: {
    '@type': 'SearchAction',
    target: `${siteRoot}${url('/search/')}?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};

const articleSchema = article
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: title,
      description,
      url: canonical,
      mainEntityOfPage: canonical,
      datePublished: article.published.toISOString(),
      dateModified: (article.updated ?? article.published).toISOString(),
      inLanguage: SITE.lang,
      image: ogImage,
      author: { '@type': 'Person', name: SITE.author, url: SITE.github },
      publisher: { '@type': 'Organization', name: SITE.title },
      ...(article.category ? { articleSection: article.category } : {}),
      ...(article.tags.length ? { keywords: article.tags.join(', ') } : {}),
      ...(article.minutes ? { timeRequired: `PT${article.minutes}M` } : {}),
    }
  : null;

const breadcrumbSchema = article
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: '首页', item: `${siteRoot}${url('/')}` },
        { '@type': 'ListItem', position: 2, name: '文章', item: `${siteRoot}${url('/posts/')}` },
        { '@type': 'ListItem', position: 3, name: title, item: canonical },
      ],
    }
  : null;

const schema = [websiteSchema, articleSchema, breadcrumbSchema].filter(Boolean);
---

<!doctype html>
<html lang={SITE.lang} data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href={url('/rss.xml')} />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.title} · 笔记`} href={url('/notes.xml')} />
    <meta name="theme-color" content="#f2f0e9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#131311" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={pageTitle} />
    {article && <meta property="article:published_time" content={article.published.toISOString()} />}
    {article?.updated && <meta property="article:modified_time" content={article.updated.toISOString()} />}
    {article?.tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />

    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.dataset.theme = stored || (prefersDark ? 'dark' : 'light');
          if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            document.documentElement.dataset.motion = 'on';
          }
          /* 字号偏好要在首帧之前落上，否则文章会先按标准字号闪一下再变大 */
          var reading = localStorage.getItem('reading');
          if (reading === 'small' || reading === 'large') {
            document.documentElement.dataset.reading = reading;
          }
        } catch (e) {}
      })();
    </script>
    <slot name="head" />
    <Analytics />
  </head>

  <body data-search-url={url('/search/')}>
    <a class="skip-link" href="#main">跳到正文</a>
    <div class="read-progress" id="read-progress" aria-hidden="true"><span></span></div>

    <header class="site-header" id="site-header">
      <div class="shell header-inner">
        <a class="wordmark" href={url('/')} aria-label={`${SITE.title}，回到首页`}>
          <span class="mark"></span>
          <span>{SITE.title}</span>
        </a>

        <nav class="nav" aria-label="主导航">
          {
            NAV.map((item) => {
              const target = url(item.href).replace(/\/$/, '');
              const isActive = current === target || (target !== url('/').replace(/\/$/, '') && current.startsWith(target));
              return (
                <a href={url(item.href)} aria-current={isActive ? 'page' : undefined}>
                  {item.label}
                </a>
              );
            })
          }
          <a class="nav-icon search-link" href={url('/search/')} aria-label="搜索文章" title="搜索（Ctrl / ⌘ + K）">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
              <circle cx="11" cy="11" r="6.4"></circle>
              <path d="m16 16 4.2 4.2"></path>
            </svg>
          </a>
          <button class="theme-toggle" id="theme-toggle" type="button" aria-label="切换到深色主题" title="切换到深色主题">
            <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
              <circle cx="12" cy="12" r="4.2"></circle>
              <path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.2 5.2l1.6 1.6M17.2 17.2l1.6 1.6M18.8 5.2l-1.6 1.6M6.8 17.2l-1.6 1.6"></path>
            </svg>
            <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
              <path d="M20.5 14.3A8.5 8.5 0 1 1 9.7 3.5a6.8 6.8 0 0 0 10.8 10.8Z"></path>
            </svg>
          </button>
        </nav>
      </div>
    </header>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <div class="sr-only" id="a11y-status" role="status" aria-live="polite"></div>

    <footer class="site-footer">
      <div class="shell footer-grid">
        <div class="footer-brand">
          <span class="footer-mark"><span class="mark"></span>{SITE.title}</span>
          <p>{SITE.description}</p>
        </div>
        <nav class="footer-col" aria-label="页脚导航">
          <h2>导航</h2>
          {NAV.map((item) => <a href={url(item.href)}>{item.label}</a>)}
        </nav>
        <div class="footer-col">
          <h2>订阅与源码</h2>
          <a href={url('/subscribe/')}>怎么订阅</a>
          <a href={url('/rss.xml')}>文章 RSS</a>
          <a href={url('/notes.xml')}>笔记 RSS</a>
          <a href={SITE.github} target="_blank" rel="noopener noreferrer">GitHub</a>
          <a href={url('/about/')}>关于本站</a>
        </div>
      </div>
      <div class="shell footer-bottom">
        <span>© {SITE.since === new Date().getFullYear() ? SITE.since : `${SITE.since}–${new Date().getFullYear()}`} {SITE.author} · 文字采用 CC BY-NC-SA 4.0</span>
        <span class="footer-links">
          <span>Powered by Astro</span>
          <a href={SITE.github} target="_blank" rel="noopener noreferrer">GitHub Pages</a>
        </span>
      </div>
    </footer>

    <button class="to-top" id="to-top" type="button" aria-label="回到顶部">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 19V5M6 11l6-6 6 6"></path>
      </svg>
    </button>

    <dialog class="lightbox" id="lightbox" aria-label="图片预览" aria-modal="true">
      <div class="lightbox-tools">
        <a class="lightbox-origin" id="lightbox-origin" href="#" target="_blank" rel="noopener noreferrer" aria-label="在新标签页打开原图">
          原图
        </a>
        <button class="lightbox-close" type="button" aria-label="关闭预览">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
            <path d="M6 6l12 12M18 6 6 18"></path>
          </svg>
        </button>
      </div>
      <div class="lightbox-stage" id="lightbox-stage" title="滚轮缩放 · 拖动平移 · 双击复位">
        <img id="lightbox-img" alt="" />
      </div>
      <p class="lightbox-caption" id="lightbox-caption"></p>
      <span class="lightbox-zoom" id="lightbox-zoom" aria-hidden="true" hidden>100%</span>
      <p class="lightbox-hint" id="lightbox-hint" aria-hidden="true">滚轮缩放 · 拖动平移 · 双击复位</p>
      <button class="lightbox-nav prev" type="button" aria-label="上一张">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M15 5l-7 7 7 7"></path>
        </svg>
      </button>
      <button class="lightbox-nav next" type="button" aria-label="下一张">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M9 5l7 7-7 7"></path>
        </svg>
      </button>
    </dialog>

    <script>
      const root = document.documentElement;
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

      /* 站外链接补 target/rel 与箭头标识。Astro 7 的 Markdown 管道已换成 Sätteri，
         不再支持旧式 rehype 插件，这类纯展示增强放在运行时最省事；
         即使脚本被禁用，链接本身仍然可点，只是不新开标签页。 */
      document.querySelectorAll<HTMLAnchorElement>('.prose a[href]').forEach((link) => {
        let target: URL;
        try {
          target = new URL(link.href, location.href);
        } catch {
          return;
        }
        if (!/^https?:$/.test(target.protocol) || target.host === location.host) return;
        link.target = '_blank';
        link.rel = 'noopener noreferrer';
        link.classList.add('external-link');
      });

      /* 正文里的表格与代码块：只要页面用了 .prose 就统一处理，
         这样文章页、关于页和排版样例页的表现不会各走一套。 */
      const announceStatus = (message: string) => {
        const status = document.getElementById('a11y-status');
        if (status) status.textContent = message;
      };

      /* Markdown 任务列表的复选框由解析器输出，本身没有名称；
         补一个短标签，读屏读到「已完成 / 未完成」，又不会和工作项文字重复。 */
      document.querySelectorAll<HTMLInputElement>('.prose .task-list-item input[type="checkbox"]').forEach((box) => {
        box.setAttribute('aria-label', box.checked ? '已完成' : '未完成');
      });

      document.querySelectorAll<HTMLTableElement>('.prose table').forEach((table) => {
        if (table.closest('.table-wrap')) return;
        const box = document.createElement('div');
        box.className = 'table-wrap';
        box.tabIndex = 0;
        box.setAttribute('role', 'region');
        box.setAttribute('aria-label', '表格，可横向滚动查看');
        table.replaceWith(box);
        box.append(table);

        /* 只有真能滚动时才加边缘阴影，否则会误伤放得下的表格 */
        const sync = () => {
          box.classList.toggle('is-scrollable', box.scrollWidth - box.clientWidth > 2);
        };
        box.addEventListener('scroll', sync, { passive: true });
        if ('ResizeObserver' in window) new ResizeObserver(sync).observe(box);
        sync();
      });

      document.querySelectorAll<HTMLElement>('.prose pre').forEach((pre) => {
        if (pre.parentElement?.classList.contains('code-block')) return;
        const wrap = document.createElement('div');
        wrap.className = 'code-block';
        pre.parentNode?.insertBefore(wrap, pre);
        wrap.appendChild(pre);

        const lang = pre.getAttribute('data-language');
        if (lang) {
          wrap.classList.add('has-lang');
          const label = document.createElement('span');
          label.className = 'code-lang';
          label.textContent = lang;
          wrap.appendChild(label);
        }

        const btn = document.createElement('button');
        btn.className = 'copy-btn';
        btn.type = 'button';
        btn.textContent = '复制';
        btn.setAttribute('aria-label', '复制代码');
        btn.addEventListener('click', async () => {
          const text = pre.querySelector('code')?.textContent ?? '';
          try {
            await navigator.clipboard.writeText(text);
            btn.textContent = '已复制';
            btn.classList.add('copied');
            announceStatus('代码已复制');
          } catch {
            btn.textContent = '复制失败';
            announceStatus('复制失败，请手动选择代码');
          }
          setTimeout(() => {
            btn.textContent = '复制';
            btn.classList.remove('copied');
          }, 1600);
        });
        wrap.appendChild(btn);

        /* 长代码块默认收起：一屏全是代码时，读者往往直接跳过整段 */
        const lineCount = pre.querySelectorAll('.line').length;
        if (lineCount > 24) {
          wrap.classList.add('is-long');
          const toggle = document.createElement('button');
          toggle.type = 'button';
          toggle.className = 'code-toggle';
          toggle.setAttribute('aria-expanded', 'false');
          toggle.textContent = `展开全部 ${lineCount} 行`;
          toggle.addEventListener('click', () => {
            const opened = wrap.classList.toggle('is-open');
            toggle.setAttribute('aria-expanded', String(opened));
            toggle.textContent = opened ? '收起代码' : `展开全部 ${lineCount} 行`;
            /* 收起后如果代码块已经滚出视口，拉回来，别让人对着空白 */
            if (!opened && wrap.getBoundingClientRect().top < 0) {
              wrap.scrollIntoView({ block: 'start' });
            }
          });
          wrap.appendChild(toggle);
        }
      });

      /* ---------- 图片灯箱：缩放 / 拖动 / 原图 ---------- */
      const lightboxImages = Array.from(document.querySelectorAll<HTMLImageElement>('.prose img'));
      const lightbox = document.getElementById('lightbox') as HTMLDialogElement | null;

      if (lightbox && lightboxImages.length > 0) {
        const view = document.getElementById('lightbox-img') as HTMLImageElement;
        const stage = document.getElementById('lightbox-stage') as HTMLElement;
        const caption = document.getElementById('lightbox-caption');
        const zoomLabel = document.getElementById('lightbox-zoom');
        const origin = document.getElementById('lightbox-origin') as HTMLAnchorElement | null;
        const hint = document.getElementById('lightbox-hint');
        const prev = lightbox.querySelector<HTMLButtonElement>('.lightbox-nav.prev');
        const next = lightbox.querySelector<HTMLButtonElement>('.lightbox-nav.next');
        let index = 0;

        /* zoom 是倍率，tx / ty 是相对舞台中心的平移量 */
        let zoom = 1;
        let tx = 0;
        let ty = 0;
        let hintTimer = 0;

        const clamp = () => {
          const w = view.offsetWidth;
          const h = view.offsetHeight;
          const maxX = Math.max(0, (w * (zoom - 1)) / 2);
          const maxY = Math.max(0, (h * (zoom - 1)) / 2);
          tx = Math.max(-maxX, Math.min(maxX, tx));
          ty = Math.max(-maxY, Math.min(maxY, ty));
        };

        const paint = () => {
          view.style.transform = `translate(${tx}px, ${ty}px) scale(${zoom})`;
          stage.classList.toggle('is-zoomed', zoom > 1);
          if (zoomLabel) {
            zoomLabel.textContent = `${Math.round(zoom * 100)}%`;
            zoomLabel.hidden = zoom <= 1;
          }
        };

        const reset = () => {
          zoom = 1;
          tx = 0;
          ty = 0;
          paint();
        };

        /* 让指针下的那一点在缩放前后保持不动，而不是永远从中心放大 */
        const zoomAt = (target: number, px: number, py: number) => {
          const nextZoom = Math.max(1, Math.min(4, target));
          if (nextZoom === zoom) return;
          const ratio = nextZoom / zoom;
          tx = px - (px - tx) * ratio;
          ty = py - (py - ty) * ratio;
          zoom = nextZoom;
          if (zoom === 1) {
            tx = 0;
            ty = 0;
          }
          clamp();
          paint();
        };

        const pointerAt = (event: MouseEvent) => {
          const rect = stage.getBoundingClientRect();
          return {
            x: event.clientX - (rect.left + rect.width / 2),
            y: event.clientY - (rect.top + rect.height / 2),
          };
        };

        const flashHint = () => {
          if (!hint) return;
          window.clearTimeout(hintTimer);
          hint.classList.add('is-on');
          hintTimer = window.setTimeout(() => hint.classList.remove('is-on'), 2600);
        };

        if (lightboxImages.length < 2) {
          prev?.setAttribute('hidden', '');
          next?.setAttribute('hidden', '');
        }

        const show = (i: number) => {
          index = (i + lightboxImages.length) % lightboxImages.length;
          const image = lightboxImages[index];
          /* 先把固有尺寸占上：图没到之前舞台高度是 0，滚轮和拖动都无处可落 */
          if (image.naturalWidth && image.naturalHeight) {
            view.width = image.naturalWidth;
            view.height = image.naturalHeight;
          }
          view.src = image.currentSrc || image.src;
          view.alt = image.alt;
          /* 「原图」指向 img 的 src 而不是 currentSrc：后者是 srcset 选中的档位，放大后会糊 */
          if (origin) origin.href = image.src;
          if (caption) {
            /* 有图注就显示图注，没有才退回 alt */
            const figCaption = image.closest('figure')?.querySelector('figcaption')?.textContent?.trim();
            const text = figCaption || image.alt || '';
            caption.textContent = text;
            caption.hidden = !text;
          }
          reset();
        };

        const openLightbox = (i: number) => {
          show(i);
          lightbox.showModal();
          document.documentElement.style.overflow = 'hidden';
          flashHint();
        };

        lightboxImages.forEach((image, i) => {
          /* 正文图片统一懒加载，长文首屏不必拉完全部配图 */
          image.loading = 'lazy';
          image.decoding = 'async';
          image.tabIndex = 0;
          image.setAttribute('role', 'button');
          image.setAttribute('aria-label', `放大图片：${image.alt || '正文图片'}`);
          image.addEventListener('click', () => openLightbox(i));
          image.addEventListener('keydown', (event) => {
            if (event.key === 'Enter' || event.key === ' ') {
              event.preventDefault();
              openLightbox(i);
            }
          });
        });

        /* 缩放：滚轮以指针为中心，双击在 1× 与 2.4× 之间切换 */
        stage.addEventListener(
          'wheel',
          (event) => {
            event.preventDefault();
            const at = pointerAt(event);
            zoomAt(zoom * Math.exp(-event.deltaY * 0.0022), at.x, at.y);
          },
          { passive: false }
        );

        stage.addEventListener('dblclick', (event) => {
          const at = pointerAt(event);
          if (zoom > 1) reset();
          else zoomAt(2.4, at.x, at.y);
        });

        /* 拖动只在放大后生效，否则会和双击、切换图片抢事件 */
        let dragging = false;
        let startX = 0;
        let startY = 0;
        let fromX = 0;
        let fromY = 0;

        stage.addEventListener('pointerdown', (event) => {
          if (zoom <= 1) return;
          dragging = true;
          startX = event.clientX;
          startY = event.clientY;
          fromX = tx;
          fromY = ty;
          stage.setPointerCapture(event.pointerId);
          stage.classList.add('is-dragging');
        });

        stage.addEventListener('pointermove', (event) => {
          if (!dragging) return;
          tx = fromX + (event.clientX - startX);
          ty = fromY + (event.clientY - startY);
          clamp();
          paint();
        });

        const endDrag = (event: PointerEvent) => {
          if (!dragging) return;
          dragging = false;
          stage.classList.remove('is-dragging');
          if (stage.hasPointerCapture(event.pointerId)) stage.releasePointerCapture(event.pointerId);
        };

        stage.addEventListener('pointerup', endDrag);
        stage.addEventListener('pointercancel', endDrag);

        /* 换图后尺寸变了，按新尺寸重新收边界 */
        view.addEventListener('load', () => {
          if (zoom > 1) {
            clamp();
            paint();
          }
        });

        lightbox.querySelector('.lightbox-close')?.addEventListener('click', () => lightbox.close());
        prev?.addEventListener('click', () => show(index - 1));
        next?.addEventListener('click', () => show(index + 1));
        lightbox.addEventListener('click', (event) => {
          if (event.target === lightbox) lightbox.close();
        });
        lightbox.addEventListener('keydown', (event) => {
          if (event.key === 'ArrowLeft') {
            event.preventDefault();
            show(index - 1);
          }
          if (event.key === 'ArrowRight') {
            event.preventDefault();
            show(index + 1);
          }
          if (event.key === '+' || event.key === '=') {
            event.preventDefault();
            zoomAt(zoom * 1.25, 0, 0);
          }
          if (event.key === '-' || event.key === '_') {
            event.preventDefault();
            zoomAt(zoom / 1.25, 0, 0);
          }
          if (event.key === '0') {
            event.preventDefault();
            reset();
          }
        });
        lightbox.addEventListener('close', () => {
          document.documentElement.style.overflow = '';
          reset();
          hint?.classList.remove('is-on');
          window.clearTimeout(hintTimer);
        });
      }

      /* 搜索：⌘/Ctrl+K 或 / 直接聚焦，其他页面跳到搜索页 */
      const searchUrl = document.body.dataset.searchUrl || '/search/';
      const searchField = () => document.getElementById('search-input') as HTMLInputElement | null;
      const isTyping = (target: EventTarget | null) => {
        const el = target as HTMLElement | null;
        if (!el || !el.tagName) return false;
        return (
          el.tagName === 'INPUT' ||
          el.tagName === 'TEXTAREA' ||
          el.tagName === 'SELECT' ||
          el.isContentEditable
        );
      };

      document.addEventListener('keydown', (event) => {
        const mod = event.metaKey || event.ctrlKey;
        if (mod && event.key.toLowerCase() === 'k') {
          event.preventDefault();
          const field = searchField();
          if (field) {
            field.focus();
            field.select();
          } else {
            location.href = searchUrl;
          }
          return;
        }

        if (event.key === '/' && !mod && !event.altKey && !isTyping(event.target)) {
          const field = searchField();
          if (field) {
            event.preventDefault();
            field.focus();
            field.select();
          } else {
            event.preventDefault();
            location.href = searchUrl;
          }
        }
      });

      /* 主题切换：支持 View Transition 时用圆形扩散过渡 */
      const toggle = document.getElementById('theme-toggle');
      const syncThemeLabel = () => {
        const dark = root.dataset.theme === 'dark';
        const label = dark ? '切换到浅色主题' : '切换到深色主题';
        toggle?.setAttribute('aria-label', label);
        toggle?.setAttribute('title', label);
      };
      syncThemeLabel();

      const applyTheme = (next: string) => {
        root.dataset.theme = next;
        syncThemeLabel();
        try {
          localStorage.setItem('theme', next);
        } catch (e) {}
      };

      toggle?.addEventListener('click', (event) => {
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        const startViewTransition = (document as any).startViewTransition as
          | ((cb: () => void) => { ready: Promise<void> })
          | undefined;

        if (reduceMotion.matches || !startViewTransition) {
          applyTheme(next);
          return;
        }

        const x = (event as MouseEvent).clientX || window.innerWidth / 2;
        const y = (event as MouseEvent).clientY || 40;
        const radius = Math.hypot(Math.max(x, window.innerWidth - x), Math.max(y, window.innerHeight - y));

        const transition = startViewTransition.call(document, () => applyTheme(next));
        transition.ready
          .then(() => {
            root.animate(
              { clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${radius}px at ${x}px ${y}px)`] },
              { duration: 540, easing: 'ease-in-out', pseudoElement: '::view-transition-new(root)' }
            );
          })
          .catch(() => {});
      });

      /* 滚动状态 */
      const header = document.getElementById('site-header');
      const toTop = document.getElementById('to-top');
      const progress = document.getElementById('read-progress');
      const progressFill = progress?.firstElementChild as HTMLElement | null;
      const hasArticle = Boolean(document.querySelector('.article-card'));

      const onScroll = () => {
        const y = window.scrollY;
        header?.setAttribute('data-scrolled', String(y > 8));
        toTop?.classList.toggle('show', y > 700);

        if (progressFill) {
          const max = document.documentElement.scrollHeight - window.innerHeight;
          const ratio = max > 0 ? Math.min(1, Math.max(0, y / max)) : 0;
          progressFill.style.transform = `scaleX(${ratio})`;
        }
      };

      if (progress && hasArticle) progress.classList.add('active');
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll);

      toTop?.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: reduceMotion.matches ? 'auto' : 'smooth' });
      });

      /* 滚动入场：按同组顺序错峰，元素只在 JS 就绪后隐藏 */
      if (root.dataset.motion === 'on' && 'IntersectionObserver' in window) {
        const nodes: HTMLElement[] = [];
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-in');
              observer.unobserve(entry.target);
            });
          },
          { rootMargin: '0px 0px -6% 0px', threshold: 0.06 }
        );

        try {
          const selector = [
            '.hero-copy > *',
            '.hero-card',
            '.section-head',
            '.featured',
            '.card',
            '.cat-tile',
            '.widget',
            '.page-head .shell > *',
            '.post-hero',
            '.article-card',
            '.comments',
            '.archive-year',
            '.tag-cloud li',
            '.game-card',
            '.game-note',
          ].join(',');

          document.querySelectorAll<HTMLElement>(selector).forEach((el) => {
            nodes.push(el);
            el.setAttribute('data-reveal', '');
            const parent = el.parentElement;
            if (!parent) return;
            const siblings = Array.from(parent.children).filter((child) => child.hasAttribute('data-reveal'));
            const index = siblings.indexOf(el);
            if (index > 0) el.style.setProperty('--d', `${Math.min(index, 6) * 55}ms`);
          });

          nodes.forEach((el) => observer.observe(el));
          root.dataset.motionReady = 'on';
        } catch {
          nodes.forEach((el) => {
            el.removeAttribute('data-reveal');
            el.classList.add('is-in');
          });
        }
      }
    </script>
  </body>
</html>
