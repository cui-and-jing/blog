---
import '../styles/global.css';
import Analytics from '../components/Analytics.astro';
import fontFiles from '../data/font-files.json';
import fontPages from '../data/font-pages.json';
import { SITE, NAV, url, mediaUrl, base } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** 404 是独立的 404.html 文件；允许特殊页面覆盖规范 URL。 */
  canonicalPath?: string;
  /** 给排版样例这类只给自己看的页面用，不进搜索引擎 */
  noindex?: boolean;
  article?: {
    published: Date;
    updated?: Date;
    tags: string[];
    category?: string;
    minutes?: number;
    /** 具体作者；不传就退回站名 */
    author?: { id: string; name: string };
  };
}

const { title, description = SITE.description, image, canonicalPath, noindex = false, article } = Astro.props;
const pageTitle = title ? `${title} · ${SITE.title}` : `${SITE.title} · ${SITE.tagline}`;
const siteRoot = (Astro.site ?? new URL(SITE.github)).toString().replace(/\/$/, '');
const canonical = new URL(canonicalPath ?? Astro.url.pathname, Astro.site ?? SITE.github).toString();
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
/* 字体映射用「去掉 base、保留结尾斜杠」的路径做键，和 scripts/fonts.mjs 生成的键对齐 */
const fontPath = Astro.url.pathname.slice(base.length) || '/';
type FontFaceEntry = { file: string | null; range: string; chars: string; count?: number };
const fontPage = (fontPages.pages as Record<string, FontFaceEntry>)[fontPath] ?? null;
const ogImage = image ? new URL(mediaUrl(image), siteRoot).toString() : `${siteRoot}${url('/og.png')}`;

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.title,
  description: SITE.description,
  url: `${siteRoot}${url('/')}`,
  inLanguage: SITE.lang,
  potentialAction: {
    '@type': 'SearchAction',
    target: `${siteRoot}${url('/search/')}?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};

const articleSchema = article
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: title,
      description,
      url: canonical,
      mainEntityOfPage: canonical,
      datePublished: article.published.toISOString(),
      dateModified: (article.updated ?? article.published).toISOString(),
      inLanguage: SITE.lang,
      image: ogImage,
      /* 署名给到具体的人，而不是把两个人绑成一个字符串。
         @id 与 /authors/ 页里的 Person 实体同址，搜索引擎才能把「谁写的」串起来 */
      author: article.author
        ? {
            '@type': 'Person',
            '@id': `${siteRoot}${url(`/authors/#${article.author.id}`)}`,
            name: article.author.name,
            url: `${siteRoot}${url(`/authors/#${article.author.id}`)}`,
          }
        : { '@type': 'Person', name: SITE.author, url: SITE.github },
      publisher: { '@type': 'Organization', name: SITE.title },
      ...(article.category ? { articleSection: article.category } : {}),
      ...(article.tags.length ? { keywords: article.tags.join(', ') } : {}),
      ...(article.minutes ? { timeRequired: `PT${article.minutes}M` } : {}),
    }
  : null;

const breadcrumbSchema = article
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: '首页', item: `${siteRoot}${url('/')}` },
        { '@type': 'ListItem', position: 2, name: '文章', item: `${siteRoot}${url('/posts/')}` },
        { '@type': 'ListItem', position: 3, name: title, item: canonical },
      ],
    }
  : null;

const schema = [websiteSchema, articleSchema, breadcrumbSchema].filter(Boolean);
---

<!doctype html>
<html lang={SITE.lang} data-theme="light" data-theme-choice="auto">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={article?.author?.name ?? SITE.author} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url('/favicon.ico')} sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    <link rel="manifest" href={url('/site.webmanifest')} />
    {/* 汉字片占字体总量的八成，是首屏字形的主要来源，提前拉能少一段 fallback 的时间；
        拉丁与标点片很小，等 CSS 解析时自然加载就够，多 preload 反而是抢带宽 */}
    {
      fontFiles.han && (
        <link
          rel="preload"
          as="font"
          type="font/woff2"
          href={url(`/${fontFiles.han}`)}
          crossorigin="anonymous"
        />
      )
    }
    {/* 汉字公共片（出现在多数页面里的字）在 fonts.css 里，是每页都要下的固定成本；
        各页独有的字由下面这段按路径注入，unicode-range 精确到码点，
        浏览器才不会因为「页面有中文」就把整段 CJK 都算成命中 */}
    {
      fontPage?.file ? (
        <style
          is:inline
          set:html={`@font-face{font-family:'${fontPages.family}';src:url('${url(`/${fontPage.file}`)}') format('woff2');font-weight:400;font-style:normal;font-display:swap;unicode-range:${fontPage.range}}`}
        />
      ) : fontPage ? null : (
        /* 没进映射的页面（新增但还没跑 npm run fonts）：整套换成一个「全量家族」，
           宁可多下 260KB，也不能让正文掉回系统宋体 */
        <style
          is:inline
          set:html={`@font-face{font-family:'${fontPages.family} F';src:url('${url(`/${fontPages.full.file}`)}') format('woff2');font-weight:400;font-style:normal;font-display:swap;unicode-range:${fontPages.full.range}}:root{--font-prose-serif:'${fontPages.family} F',Georgia,'Songti SC','STSong','SimSun',serif}`}
        />
      )
    }
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href={url('/rss.xml')} />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.title} · 笔记`} href={url('/notes.xml')} />
    {/* 主题色跟随用户的选择，而不是只看系统偏好：
        选了「深色」但系统是浅色时，地址栏也应该跟着暗下来 */}
    <meta name="theme-color" content="#f2f0e9" id="theme-color" />

    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={pageTitle} />
    {article && <meta property="article:published_time" content={article.published.toISOString()} />}
    {article?.updated && <meta property="article:modified_time" content={article.updated.toISOString()} />}
    {article?.tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />

    <script is:inline>
      /* 首帧之前把主题、字体、字号落到 html 上。
         这些值直接决定 CSS 变量，晚一帧就会看到明显的跳变，所以必须内联、必须在 head 里。 */
      (function () {
        var d = document.documentElement;
        var s = {};
        try {
          s = JSON.parse(localStorage.getItem('settings') || '{}') || {};
          /* 旧版本把主题与字号分开存（theme / reading），这里迁移到统一的 settings，
             迁完立刻删旧键，避免两套偏好互相打架 */
          var legacyTheme = localStorage.getItem('theme');
          var legacySize = localStorage.getItem('reading');
          if (legacyTheme && !s.theme) s.theme = legacyTheme;
          if (legacySize && !s.size) s.size = legacySize;
          if (legacyTheme || legacySize) {
            localStorage.setItem('settings', JSON.stringify(s));
            localStorage.removeItem('theme');
            localStorage.removeItem('reading');
          }
        } catch (e) {
          s = {};
        }

        var choice = s.theme === 'light' || s.theme === 'dark' ? s.theme : 'auto';
        var dark = window.matchMedia('(prefers-color-scheme: dark)');
        d.dataset.themeChoice = choice;
        d.dataset.theme = choice === 'auto' ? (dark.matches ? 'dark' : 'light') : choice;

        if (s.font && s.font !== 'serif') d.dataset.font = s.font;
        if (s.size && s.size !== 'normal') d.dataset.reading = s.size;
        if (s.leading === 'loose') d.dataset.leading = 'loose';

        var metaColor = document.getElementById('theme-color');
        if (metaColor) metaColor.setAttribute('content', d.dataset.theme === 'dark' ? '#131311' : '#f2f0e9');

        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          d.dataset.motion = 'on';
        }
      })();
    </script>
    <slot name="head" />
    <Analytics />
  </head>

  <body data-search-url={url('/search/')}>
    <a class="skip-link" href="#main">跳到正文</a>
    <div class="read-progress" id="read-progress" aria-hidden="true"><span></span></div>

    <header class="site-header" id="site-header">
      <div class="shell header-inner">
        <a class="wordmark" href={url('/')} aria-label={`${SITE.title}，回到首页`}>
          <span class="mark"></span>
          <span>{SITE.title}</span>
        </a>

        <nav class="nav" aria-label="主导航">
          <div class="nav-links">
            {
              NAV.map((item) => {
                const target = url(item.href).replace(/\/$/, '');
                const isActive = current === target || (target !== url('/').replace(/\/$/, '') && current.startsWith(target));
                return (
                  <a href={url(item.href)} aria-current={isActive ? 'page' : undefined}>
                    {item.label}
                  </a>
                );
              })
            }
          </div>

          {/* 导航链接在窄屏收进抽屉，这三个动作留在一级：搜索、阅读设置、菜单 */}
          <div class="nav-actions">
            <a class="nav-icon search-link" href={url('/search/')} aria-label="搜索文章" title="搜索（Ctrl / ⌘ + K）">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
                <circle cx="11" cy="11" r="6.4"></circle>
                <path d="m16 16 4.2 4.2"></path>
              </svg>
            </a>
            <button
              class="theme-toggle"
              id="settings-toggle"
              type="button"
              aria-label="阅读设置"
              aria-expanded="false"
              aria-controls="settings-panel"
              title="阅读设置：主题 · 字体 · 字号 · 行距"
            >
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
                <path d="M4 7h9M18.5 7H20M4 17h4.5M13 17h7"></path>
                <circle cx="15.2" cy="7" r="2.4"></circle>
                <circle cx="10.8" cy="17" r="2.4"></circle>
              </svg>
            </button>
            <button
              class="nav-icon menu-toggle"
              id="menu-toggle"
              type="button"
              aria-label="打开导航菜单"
              aria-expanded="false"
              aria-controls="nav-drawer"
            >
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
                <path d="M4 7h16M4 12h16M4 17h16"></path>
              </svg>
            </button>
          </div>
        </nav>
      </div>
    </header>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <div class="sr-only" id="a11y-status" role="status" aria-live="polite"></div>

    <footer class="site-footer">
      <div class="shell footer-grid">
        <div class="footer-brand">
          <span class="footer-mark"><span class="mark"></span>{SITE.title}</span>
          <p>{SITE.description}</p>
        </div>
        <nav class="footer-col" aria-label="页脚导航">
          <h2>导航</h2>
          {NAV.map((item) => <a href={url(item.href)}>{item.label}</a>)}
        </nav>
        <div class="footer-col">
          <h2>订阅与本站</h2>
          <a href={url('/subscribe/')}>怎么订阅</a>
          <a href={url('/rss.xml')}>文章 RSS</a>
          <a href={url('/notes.xml')}>笔记 RSS</a>
          <a href={url('/about/')}>关于本站</a>
          <a href={url('/authors/')}>作者</a>
          <a href={url('/license/')}>版权与转载</a>
          <a href={SITE.github} target="_blank" rel="noopener noreferrer">GitHub</a>
        </div>
      </div>
      <div class="shell footer-bottom">
        <span>
          © {SITE.since === new Date().getFullYear() ? SITE.since : `${SITE.since}–${new Date().getFullYear()}`}
          {SITE.author} · 文字采用 <a href={url('/license/')}>CC BY-NC-SA 4.0</a>
        </span>
        <span class="footer-links">
          <span>Powered by Astro</span>
          <a href={SITE.github} target="_blank" rel="noopener noreferrer">GitHub Pages</a>
        </span>
      </div>
    </footer>

    <button class="to-top" id="to-top" type="button" aria-label="回到顶部">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 19V5M6 11l6-6 6 6"></path>
      </svg>
    </button>

    <dialog class="side-panel settings-panel" id="settings-panel" aria-labelledby="settings-title">
      <div class="panel-head">
        <h2 id="settings-title">阅读设置</h2>
        <button class="panel-close" type="button" data-close="settings-panel" aria-label="关闭阅读设置">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
            <path d="M6 6l12 12M18 6 6 18"></path>
          </svg>
        </button>
      </div>

      <div class="panel-body">
        <div class="panel-row">
          <span class="panel-label" id="label-theme">主题</span>
          <div class="seg" role="group" aria-labelledby="label-theme">
            <button type="button" data-setting="theme" data-value="auto" aria-pressed="true">跟随系统</button>
            <button type="button" data-setting="theme" data-value="light" aria-pressed="false">浅色</button>
            <button type="button" data-setting="theme" data-value="dark" aria-pressed="false">深色</button>
          </div>
        </div>

        <div class="panel-row">
          <span class="panel-label" id="label-font">正文字体</span>
          <div class="seg" role="group" aria-labelledby="label-font">
            <button type="button" data-setting="font" data-value="serif" aria-pressed="true" style="font-family: var(--font-prose-serif, serif)">宋</button>
            <button type="button" data-setting="font" data-value="sans" aria-pressed="false" style="font-family: var(--font-sans)">黑</button>
            <button type="button" data-setting="font" data-value="kai" aria-pressed="false" style="font-family: var(--font-kai)">楷</button>
          </div>
        </div>

        <div class="panel-row">
          <span class="panel-label" id="label-size">字号</span>
          <div class="seg" role="group" aria-labelledby="label-size">
            <button type="button" data-setting="size" data-value="small" aria-pressed="false">小</button>
            <button type="button" data-setting="size" data-value="normal" aria-pressed="true">标准</button>
            <button type="button" data-setting="size" data-value="large" aria-pressed="false">大</button>
          </div>
        </div>

        <div class="panel-row">
          <span class="panel-label" id="label-leading">行距</span>
          <div class="seg" role="group" aria-labelledby="label-leading">
            <button type="button" data-setting="leading" data-value="normal" aria-pressed="true">标准</button>
            <button type="button" data-setting="leading" data-value="loose" aria-pressed="false">宽松</button>
          </div>
        </div>

        <p class="panel-hint">偏好只存在这台设备的浏览器里，换设备要重选一次。</p>
      </div>

      <div class="panel-foot">
        <button class="panel-link" id="shortcuts-open" type="button">
          <kbd>?</kbd>
          <span>键盘快捷键</span>
        </button>
        <button class="panel-link" id="settings-reset" type="button">恢复默认</button>
      </div>
    </dialog>

    <dialog class="side-panel nav-drawer" id="nav-drawer" aria-labelledby="nav-drawer-title">
      <div class="panel-head">
        <h2 id="nav-drawer-title">导航</h2>
        <button class="panel-close" type="button" data-close="nav-drawer" aria-label="关闭导航菜单">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
            <path d="M6 6l12 12M18 6 6 18"></path>
          </svg>
        </button>
      </div>

      <nav class="drawer-nav" aria-label="主导航">
        {
          NAV.map((item) => {
            const target = url(item.href).replace(/\/$/, '');
            const isActive = current === target || (target !== url('/').replace(/\/$/, '') && current.startsWith(target));
            return (
              <a href={url(item.href)} aria-current={isActive ? 'page' : undefined}>
                <span>{item.label}</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
                  <path d="m9 6 6 6-6 6"></path>
                </svg>
              </a>
            );
          })
        }
      </nav>

      <div class="panel-foot">
        <a class="panel-link" href={url('/subscribe/')}>订阅</a>
        <a class="panel-link" href={url('/authors/')}>作者</a>
        <a class="panel-link" href={url('/license/')}>版权</a>
      </div>
    </dialog>

    <nav class="mobile-bar" aria-label="页面操作">
      <button class="mb-btn" id="bar-toc" type="button" hidden>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
          <path d="M4 6h16M4 12h11M4 18h7"></path>
        </svg>
        <span>目录</span>
      </button>
      <a class="mb-btn" href={url('/search/')}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
          <circle cx="11" cy="11" r="6.4"></circle>
          <path d="m16 16 4.2 4.2"></path>
        </svg>
        <span>搜索</span>
      </a>
      <button class="mb-btn" id="bar-top" type="button">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 19V5M6 11l6-6 6 6"></path>
        </svg>
        <span>顶部</span>
      </button>
    </nav>

    <dialog class="side-panel shortcuts-panel" id="shortcuts-panel" aria-labelledby="shortcuts-title">
      <div class="panel-head">
        <h2 id="shortcuts-title">键盘快捷键</h2>
        <button class="panel-close" type="button" data-close="shortcuts-panel" aria-label="关闭快捷键说明">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
            <path d="M6 6l12 12M18 6 6 18"></path>
          </svg>
        </button>
      </div>

      <table class="shortcut-table">
        <caption class="sr-only">本站支持的键盘快捷键</caption>
        <tbody>
          <tr>
            <th scope="row"><kbd>Ctrl</kbd> / <kbd>⌘</kbd> + <kbd>K</kbd></th>
            <td>打开搜索</td>
          </tr>
          <tr>
            <th scope="row"><kbd>/</kbd></th>
            <td>跳到搜索页并聚焦输入框</td>
          </tr>
          <tr>
            <th scope="row"><kbd>?</kbd></th>
            <td>打开这张表</td>
          </tr>
          <tr>
            <th scope="row"><kbd>Esc</kbd></th>
            <td>关闭弹层或退出搜索</td>
          </tr>
          <tr>
            <th scope="row"><kbd>←</kbd> <kbd>→</kbd></th>
            <td>预览里翻上一张 / 下一张</td>
          </tr>
          <tr>
            <th scope="row"><kbd>+</kbd> <kbd>−</kbd></th>
            <td>预览里放大 / 缩小</td>
          </tr>
          <tr>
            <th scope="row"><kbd>0</kbd></th>
            <td>预览里恢复原始缩放</td>
          </tr>
        </tbody>
      </table>

      <p class="panel-hint">在输入框里打字时，除 Esc 外的单键快捷键会让给输入，不会误触。</p>
    </dialog>

    <dialog class="lightbox" id="lightbox" aria-label="图片预览" aria-modal="true">
      <div class="lightbox-tools">
        <a class="lightbox-origin" id="lightbox-origin" href="#" target="_blank" rel="noopener noreferrer" aria-label="在新标签页打开原图">
          原图
        </a>
        <button class="lightbox-close" type="button" aria-label="关闭预览">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
            <path d="M6 6l12 12M18 6 6 18"></path>
          </svg>
        </button>
      </div>
      <div class="lightbox-stage" id="lightbox-stage" title="滚轮缩放 · 拖动平移 · 双击复位">
        <img id="lightbox-img" alt="" />
      </div>
      <p class="lightbox-caption" id="lightbox-caption"></p>
      <span class="lightbox-zoom" id="lightbox-zoom" aria-hidden="true" hidden>100%</span>
      <p class="lightbox-hint" id="lightbox-hint" aria-hidden="true">滚轮缩放 · 拖动平移 · 双击复位</p>
      <button class="lightbox-nav prev" type="button" aria-label="上一张">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M15 5l-7 7 7 7"></path>
        </svg>
      </button>
      <button class="lightbox-nav next" type="button" aria-label="下一张">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M9 5l7 7-7 7"></path>
        </svg>
      </button>
    </dialog>

    <script>
      import { setupLightbox } from '../lib/lightbox';
      /* 这段脚本跟首屏无关：主题、字体、字号已经在 head 的内联脚本里落定，
         正文能不能读也不依赖它。所以它等第一帧画完再接管。

         原因不是「省时间」，而是「别抢排版」：在第一帧之前读 getBoundingClientRect
         或 scrollHeight，会强制浏览器把整页布局从现在算起，本来会随渲染帧增量完成的
         排版就被合并成一个同步任务。慢机上这一次就是几百毫秒，长任务全记在这里。 */
      let booted = false;
      const boot = () => {
        if (booted) return;
        booted = true;

      /* 下面这一段保持原缩进：整块再缩两级的话，这次改动会变成七百行 diff，
         真正改了哪几行反而看不出来。 */
      const root = document.documentElement;
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

      /* 站外链接补 target/rel 与箭头标识。Astro 7 的 Markdown 管道已换成 Sätteri，
         不再支持旧式 rehype 插件，这类纯展示增强放在运行时最省事；
         即使脚本被禁用，链接本身仍然可点，只是不新开标签页。 */
      document.querySelectorAll<HTMLAnchorElement>('.prose a[href]').forEach((link) => {
        /* HTMLAnchorElement 自带标准化的协议和域名，无需再创建 URL 实例。 */
        if (!/^https?:$/.test(link.protocol) || link.host === location.host) return;
        link.target = '_blank';
        link.rel = 'noopener noreferrer';
        link.classList.add('external-link');
      });

      /* 正文里的表格与代码块：只要页面用了 .prose 就统一处理，
         这样文章页、关于页和排版样例页的表现不会各走一套。 */


      /* Markdown 任务列表的复选框由解析器输出，本身没有名称；
         补一个短标签，读屏读到「已完成 / 未完成」，又不会和工作项文字重复。 */
      document.querySelectorAll<HTMLInputElement>('.prose .task-list-item input[type="checkbox"]').forEach((box) => {
        box.setAttribute('aria-label', box.checked ? '已完成' : '未完成');
      });

      /* 表格滚动容器与代码复制按钮都是在原文上补交互外壳：不影响首屏可读性，
         但会和字体换字抢同一段主线程。先让首屏按原生样式读，交互随后再补。 */
      const enhanceProse = () => {
        /* 包装完再统一量宽度：每包一个就读一次 scrollWidth 会强制一次同步布局，
           表格一多就是「写-读-写-读」的来回。攒到下一帧一次性读完。 */
        const tables = document.querySelectorAll<HTMLTableElement>('.prose table');
        const measure = (box: HTMLElement) =>
          box.classList.toggle('is-scrollable', box.scrollWidth - box.clientWidth > 2);
        const resize = tables.length && 'ResizeObserver' in window &&
          new ResizeObserver((entries) => {
            for (const entry of entries) measure(entry.target as HTMLElement);
          });

        tables.forEach((table) => {
          if (table.closest('.table-wrap')) return;
          const box = document.createElement('div');
          box.className = 'table-wrap';
          box.tabIndex = 0;
          box.setAttribute('role', 'region');
          box.setAttribute('aria-label', '表格，可横向滚动查看');
          table.replaceWith(box);
          box.append(table);

          /* 首次观察会自动通知尺寸；旧浏览器退回下一帧测量。 */
          if (resize) resize.observe(box);
          else requestAnimationFrame(() => measure(box));
        });

        document.querySelectorAll<HTMLElement>('.prose pre').forEach((pre) => {
          if (pre.parentElement?.classList.contains('code-block')) return;
          const wrap = document.createElement('div');
          wrap.className = 'code-block';
          pre.parentNode?.insertBefore(wrap, pre);
          wrap.appendChild(pre);

          const lang = pre.getAttribute('data-language');
          if (lang) {
            wrap.classList.add('has-lang');
            const label = document.createElement('span');
            label.className = 'code-lang';
            label.textContent = lang;
            wrap.appendChild(label);
          }

          const btn = document.createElement('button');
          btn.className = 'copy-btn';
          btn.type = 'button';
          btn.textContent = '复制';
          btn.setAttribute('aria-label', '复制代码');
          btn.addEventListener('click', async () => {
            const text = pre.querySelector('code')?.textContent ?? '';
            try {
              await navigator.clipboard.writeText(text);
              btn.textContent = '已复制';
              btn.classList.add('copied');
              announce('代码已复制');
            } catch {
              btn.textContent = '复制失败';
              announce('复制失败，请手动选择代码');
            }
            setTimeout(() => {
              btn.textContent = '复制';
              btn.classList.remove('copied');
            }, 1600);
          });
          wrap.appendChild(btn);

          /* 长代码块默认收起：一屏全是代码时，读者往往直接跳过整段 */
          const lineCount = pre.querySelectorAll('.line').length;
          if (lineCount > 24) {
            wrap.classList.add('is-long');
            const toggle = document.createElement('button');
            toggle.type = 'button';
            toggle.className = 'code-toggle';
            toggle.setAttribute('aria-expanded', 'false');
            toggle.textContent = `展开全部 ${lineCount} 行`;
            toggle.addEventListener('click', () => {
              const opened = wrap.classList.toggle('is-open');
              toggle.setAttribute('aria-expanded', String(opened));
              toggle.textContent = opened ? '收起代码' : `展开全部 ${lineCount} 行`;
              /* 收起后如果代码块已经滚出视口，拉回来，别让人对着空白 */
              if (!opened && wrap.getBoundingClientRect().top < 0) {
                wrap.scrollIntoView({ block: 'start' });
              }
            });
            wrap.appendChild(toggle);
          }
        });

      };

      /* 只有存在表格/代码块才安排空闲增强任务；列表、首页不再空跑。 */
      if (document.querySelector('.prose table, .prose pre')) {
        window.requestIdleCallback?.(enhanceProse, { timeout: 1500 })
          ?? window.setTimeout(enhanceProse, 200);
      }

      /* 只在正文有图时初始化灯箱；源码拆分，构建仍合并以遵守总体 JS 预算。 */
      if (document.querySelector('.prose img')) setupLightbox();

      /* 搜索：⌘/Ctrl+K 或 / 直接聚焦，其他页面跳到搜索页 */
      const searchUrl = document.body.dataset.searchUrl || '/search/';
      const isTyping = (target: EventTarget | null) => {
        const el = target as HTMLElement | null;
        return Boolean(el && (el.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(el.tagName)));
      };

      document.addEventListener('keydown', (event) => {
        const mod = event.metaKey || event.ctrlKey;
        const shortcut = (mod && event.key.toLowerCase() === 'k')
          || (event.key === '/' && !mod && !event.altKey && !isTyping(event.target));
        if (!shortcut) return;
        event.preventDefault();
        const field = document.getElementById('search-input') as HTMLInputElement | null;
        if (field) { field.focus(); field.select(); }
        else location.href = searchUrl;
      });

      /* ---------- 阅读设置：主题 / 字体 / 字号 / 行距 ---------- */
      /* 四项偏好存在同一个 settings 对象里，首帧脚本读同一份数据，
         所以无论从顶栏面板改、还是从文章页的 A− A A+ 改，刷新后都是同一套结果 */
      type Settings = { theme: string; font: string; size: string; leading: string };
      const STORE = 'settings';
      const DEFAULTS: Settings = { theme: 'auto', font: 'serif', size: 'normal', leading: 'normal' };

      const readSettings = (): Settings => {
        try { return { ...DEFAULTS, ...JSON.parse(localStorage.getItem(STORE) ?? '{}') }; }
        catch { return { ...DEFAULTS }; }
      };

      let settings = readSettings();
      const darkQuery = window.matchMedia('(prefers-color-scheme: dark)');

      const announce = (message: string) => {
        const status = document.getElementById('a11y-status');
        if (status) status.textContent = message;
      };

      const resolveTheme = (choice: string) =>
        choice === 'light' || choice === 'dark' ? choice : darkQuery.matches ? 'dark' : 'light';

      /* 移动端地址栏的颜色也要跟着主题走，否则深色页面顶着一条浅色栏 */
      const applyThemeColor = () => {
        const meta = document.getElementById('theme-color');
        if (meta) meta.setAttribute('content', root.dataset.theme === 'dark' ? '#131311' : '#f2f0e9');
      };

      const paintSettings = () => {
        root.dataset.themeChoice = settings.theme;
        root.dataset.theme = resolveTheme(settings.theme);

        /* 属性不存在就是默认值，这样 CSS 里不用为「默认」再单独写一套规则 */
        if (settings.font === 'serif') delete root.dataset.font;
        else root.dataset.font = settings.font;

        if (settings.size === 'normal') delete root.dataset.reading;
        else root.dataset.reading = settings.size;

        if (settings.leading === 'loose') root.dataset.leading = 'loose';
        else delete root.dataset.leading;

        document.querySelectorAll<HTMLElement>('[data-setting]').forEach((btn) => {
          const key = btn.dataset.setting as keyof Settings;
          btn.setAttribute('aria-pressed', String(settings[key] === btn.dataset.value));
        });

        applyThemeColor();
      };

      const saveSettings = () => {
        try {
          localStorage.setItem(STORE, JSON.stringify(settings));
        } catch (e) {}
      };

      /* 主题切换用 View Transition 的圆形扩散，以点击的按钮为圆心铺开。
         面板本身在 top layer，会一起被拍进快照，所以看起来是整屏同步变色 */
      const withTransition = (apply: () => void, origin?: { x: number; y: number }) => {
        const transition = (document as any).startViewTransition;
        if (reduceMotion.matches || !transition || !origin) return apply();
        const { x, y } = origin;
        const radius = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
        transition.call(document, apply).ready.then(() => {
          root.animate(
            { clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${radius}px at ${x}px ${y}px)`] },
            { duration: 540, easing: 'ease-in-out', pseudoElement: '::view-transition-new(root)' }
          );
        }).catch(() => {});
      };

      /* 面板和文章页的字号按钮用的是同一套标记，一个委托就够了 */
      document.addEventListener('click', (event) => {
        const btn = (event.target as HTMLElement | null)?.closest<HTMLElement>('[data-setting]');
        if (!btn) return;

        const key = btn.dataset.setting as keyof Settings | undefined;
        const value = btn.dataset.value;
        if (!key || !value || settings[key] === value) return;

        const rect = btn.getBoundingClientRect();
        const origin = key === 'theme' ? { x: rect.left + rect.width / 2, y: rect.top + rect.height / 2 } : undefined;

        withTransition(() => {
          settings = { ...settings, [key]: value };
          paintSettings();
        }, origin);
        saveSettings();

        /* 读屏文案直接取面板选项，避免 JS 再维护一套同义字典。 */
        const name = document.getElementById(`label-${key}`)?.textContent?.trim() ?? key;
        const choice = document.querySelector<HTMLElement>(
          `#settings-panel [data-setting="${key}"][data-value="${value}"]`
        )?.textContent?.trim() ?? value;
        announce(`${name}：${choice}${key === 'font' ? '体' : ''}`);
      });

      /* 选了「跟随系统」之后，用户在系统里切深浅色，这里要跟着变 */
      darkQuery.addEventListener('change', () => {
        if (settings.theme !== 'auto') return;
        root.dataset.theme = darkQuery.matches ? 'dark' : 'light';
        applyThemeColor();
      });

      /* 同一个浏览器开着两个标签页时，一边改了另一边也要跟上 */
      window.addEventListener('storage', (event) => {
        if (event.key !== STORE) return;
        settings = readSettings();
        paintSettings();
      });

      paintSettings();

      /* ---------- 设置面板、快捷键面板与导航抽屉 ---------- */
      const settingsPanel = document.getElementById('settings-panel') as HTMLDialogElement | null;
      const shortcutsPanel = document.getElementById('shortcuts-panel') as HTMLDialogElement | null;
      const navDrawer = document.getElementById('nav-drawer') as HTMLDialogElement | null;
      const settingsToggle = document.getElementById('settings-toggle');
      const menuToggle = document.getElementById('menu-toggle');
      const shortcutsOpen = document.getElementById('shortcuts-open');
      const settingsReset = document.getElementById('settings-reset');

      const openPanel = (panel: HTMLDialogElement | null) => {
        if (panel && !panel.open) panel.showModal();
      };

      const bindPanel = (button: HTMLElement | null, panel: HTMLDialogElement | null) => {
        button?.addEventListener('click', () => {
          openPanel(panel);
          button.setAttribute('aria-expanded', 'true');
        });
        panel?.addEventListener('close', () => button?.setAttribute('aria-expanded', 'false'));
      };
      bindPanel(settingsToggle, settingsPanel);
      bindPanel(menuToggle, navDrawer);

      /* 从设置里点进快捷键，先收起当前面板，避免两个 dialog 叠在一起 */
      shortcutsOpen?.addEventListener('click', () => {
        settingsPanel?.close();
        openPanel(shortcutsPanel);
      });

      settingsReset?.addEventListener('click', () => {
        settings = { ...DEFAULTS };
        paintSettings();
        saveSettings();
        announce('已恢复默认外观');
      });

      document.querySelectorAll<HTMLButtonElement>('[data-close]').forEach((btn) => {
        btn.addEventListener('click', () => {
          (document.getElementById(btn.dataset.close ?? '') as HTMLDialogElement | null)?.close();
        });
      });

      /* 点面板外的遮罩关闭。dialog 自己不留 padding，所以点到空白基本等于点到遮罩 */
      [settingsPanel, shortcutsPanel, navDrawer].forEach((panel) => {
        panel?.addEventListener('click', (event) => {
          if (event.target === panel) panel.close();
        });
      });

      /* ? 打开快捷键表。Shift + / 才打得出来，直接判键值最省事 */
      document.addEventListener('keydown', (event) => {
        if (event.key !== '?' || event.metaKey || event.ctrlKey || event.altKey) return;
        if (isTyping(event.target)) return;
        event.preventDefault();
        if (settingsPanel?.open) settingsPanel.close();
        openPanel(shortcutsPanel);
      });

      /* 滚动状态 */
      const header = document.getElementById('site-header');
      const toTop = document.getElementById('to-top');
      const progress = document.getElementById('read-progress');
      const progressFill = progress?.firstElementChild as HTMLElement | null;
      const prose = document.querySelector<HTMLElement>('.article-card .prose');

      /* 滚动时不要读 scrollHeight：那是一次强制同步布局，滚得越快越卡，
         长文在低端机上会直接掉帧。高度只在真的变了的时候重量（窗口缩放、
         字体换完、评论挂载），滚动回调只做纯计算 + 写样式。

         一帧最多写一次：滚动事件在跟手滚轮上一帧能来好几次，每次都去改属性、
         切换 class 会让样式反复失效。写之前也比一次，值没变就什么都不做。 */
      let proseTop = 0;
      let proseHeight = 0;
      const measureScroll = () => {
        const rect = prose?.getBoundingClientRect();
        proseTop = rect ? rect.top + window.scrollY : 0;
        proseHeight = rect?.height ?? 0;
        onScroll();
      };

      let scrollQueued = false;
      const paintScroll = () => {
        scrollQueued = false;
        const y = window.scrollY;
        const scrolled = y > 8;
        if (header && header.hasAttribute('data-scrolled') !== scrolled) {
          scrolled ? header.setAttribute('data-scrolled', 'true') : header.removeAttribute('data-scrolled');
        }
        const showTop = y > 700;
        if (toTop && toTop.classList.contains('show') !== showTop) {
          toTop.classList.toggle('show', showTop);
        }
        if (progressFill) {
          const ratio = proseHeight > 0
            ? Math.min(1, Math.max(0, (y + Math.min(140, innerHeight * .22) - proseTop) / proseHeight))
            : 0;
          progressFill.style.transform = `scaleX(${ratio})`;
        }
      };
      const onScroll = () => {
        if (scrollQueued) return;
        scrollQueued = true;
        requestAnimationFrame(paintScroll);
      };

      if (progress && prose) progress.classList.add('active');
      /* 开头先不量高度：读取 scrollHeight 会强制同步布局，而这时字体还没到，
         等于是把成本最高的一次排版提前到主线程上做。第一帧结束后再量，
         ResizeObserver 与 fonts.ready 会把字体换字造成的高度变化补上。 */
      onScroll();
      window.addEventListener('load', measureScroll, { once: true });
      document.fonts?.ready.then(measureScroll).catch(() => {});
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', measureScroll);
      if (prose && 'ResizeObserver' in window) new ResizeObserver(measureScroll).observe(prose);

      const scrollToTop = () => window.scrollTo({ top: 0, behavior: reduceMotion.matches ? 'auto' : 'smooth' });
      toTop?.addEventListener('click', scrollToTop);
      /* 手机底栏与桌面浮钮共用同一行为。 */
      document.getElementById('bar-top')?.addEventListener('click', scrollToTop);

      /* 滚动入场：按同组顺序错峰，元素只在 JS 就绪后隐藏 */
      /* 只从页面顶部进来时才挂动效。
         这段现在跑在第一帧之后，如果浏览器恢复了滚动位置（刷新时停在文中），
         首屏以下的元素已经露过脸了，再补一次「隐藏 → 淡入」就是明显的闪一下。
         顶端进来时那些元素本来就在视口外，藏起来不会被看见。 */
      if (root.dataset.motion === 'on' && window.scrollY < 40 && 'IntersectionObserver' in window) {
        const nodes: HTMLElement[] = [];
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-in');
              observer.unobserve(entry.target);
            });
          },
          { rootMargin: '0px 0px -6% 0px', threshold: 0.06 }
        );

        try {
          const selector = '.hero-copy > *,.hero-card,.section-head,.featured,.card,.cat-tile,' +
            '.widget,.page-head .shell > *,.post-hero,.article-card,.comments,.archive-year,' +
            '.tag-cloud li,.game-card,.game-note';

          /* 首屏里的元素直接算「已入场」：把它们先藏起来再淡入，
             等于把第一眼的内容推后一整段动画，首访还会看到一次闪动。
             动效留给需要滚动才看见的区块，那里才是它真正有用的地方。 */
          const targets = Array.from(document.querySelectorAll<HTMLElement>(selector));
          /* 位置一次读完再动 DOM：读一次写一次会让每次读都触发一次强制布局 */
          const fold = window.innerHeight * 0.92;
          const aboveFold = targets.map((el) => el.getBoundingClientRect().top < fold);
          const revealedByParent = new Map<Element, number>();

          targets.forEach((el, i) => {
            if (aboveFold[i]) {
              el.classList.add('is-in');
              return;
            }
            nodes.push(el);
            el.setAttribute('data-reveal', '');
            const parent = el.parentElement;
            if (!parent) return;
            /* DOM 顺序已稳定：直接记录同组序号，避免每项遍历父节点的全部子元素。 */
            const index = revealedByParent.get(parent) ?? 0;
            revealedByParent.set(parent, index + 1);
            if (index > 0) el.style.setProperty('--d', `${Math.min(index, 6) * 55}ms`);
          });

          nodes.forEach((el) => observer.observe(el));
          root.dataset.motionReady = 'on';
        } catch {
          nodes.forEach((el) => {
            el.removeAttribute('data-reveal');
            el.classList.add('is-in');
          });
        }
      }

      /* 给外部脚本一个「已经增强完」的信号：无障碍扫描、性能测量都要判断
         表格外框、代码复制按钮这些外壳是否补上了，靠猜时间迟早会飘 */
      root.dataset.booted = 'on';
      };

      /* 两帧：第一帧完成首次布局与绘制，第二帧才轮到接管。
         后台标签页不调度 rAF，用一个定时器兜底，免得脚本永远不跑。 */
      const startOp = () => requestAnimationFrame(() => requestAnimationFrame(boot));
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', startOp, { once: true });
      } else {
        startOp();
      }
      window.setTimeout(boot, 3000);
    </script>
  </body>
</html>
